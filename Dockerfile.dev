# Development Dockerfile for the Rails application
# Use this for local development on any machine without installing dependencies

ARG RUBY_VERSION=3.2.3
FROM docker.io/library/ruby:$RUBY_VERSION-slim

# Install system dependencies
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
    # Build essentials
    build-essential \
    git \
    pkg-config \
    # Database
    sqlite3 \
    libsqlite3-dev \
    # Image processing
    libvips \
    imagemagick \
    # Node.js (for Tailwind CSS)
    curl \
    # Chromium for system tests (Cuprite/Capybara)
    chromium \
    chromium-driver \
    # Misc utilities
    procps \
    && rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Install Node.js 20 LTS
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g yarn && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Set up working directory
WORKDIR /app

# Set development environment
ENV RAILS_ENV=development \
    NODE_ENV=development \
    BUNDLE_PATH=/usr/local/bundle \
    CHROME_BIN=/usr/bin/chromium \
    CHROMIUM_BIN=/usr/bin/chromium

# Install foreman for process management
RUN gem install foreman

# Copy dependency files first for better caching
COPY Gemfile Gemfile.lock ./
COPY package.json yarn.lock* ./

# Install Ruby dependencies
RUN bundle install

# Install Node dependencies
RUN yarn install

# Copy the rest of the application
COPY . .

# Expose port for Rails server
EXPOSE 3000

# Default command runs the development server
CMD ["bin/dev"]
