<div class="bg-base-100 p-6 rounded-lg">
  <h3 class="text-lg font-semibold mb-4">DateCircle Component Variations</h3>
  
  <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
    <% variations.each_with_index do |variation, index| %>
      <div class="flex flex-col items-center space-y-3 p-4 border border-base-200 rounded-lg">
        <div class="text-sm font-medium text-center min-h-[2.5rem] flex items-center">
          <%= variation[:name] %>
        </div>
        
        <div class="flex justify-center">
          <%= render DateCircleComponent.new(
            date: base_date + index.days,
            day_of_week: (base_date + index.days).strftime('%a'),
            month_day: (base_date + index.days).strftime('%b %-d'),
            completed: variation[:completed],
            selected: variation[:selected],
            has_reading: variation[:has_reading]
          ) %>
        </div>
        
        <div class="text-xs text-base-content/60 text-center">
          <div>Completed: <%= variation[:completed] ? '✓' : '✗' %></div>
          <div>Selected: <%= variation[:selected] ? '✓' : '✗' %></div>
          <div>Has Reading: <%= variation[:has_reading] ? '✓' : '✗' %></div>
        </div>
      </div>
    <% end %>
  </div>
  
  <div class="mt-6 p-4 bg-base-200 rounded-lg">
    <h4 class="font-medium mb-2">Component States:</h4>
    <ul class="text-sm space-y-1 text-base-content/80">
      <li><strong>Default:</strong> Gray circle with primary border, clickable</li>
      <li><strong>Selected:</strong> Thicker primary border, bold text</li>
      <li><strong>Completed:</strong> Green circle with checkmark</li>
      <li><strong>No Reading:</strong> Gray border, not clickable</li>
      <li><strong>Combined:</strong> Multiple states can be active simultaneously</li>
    </ul>
  </div>
</div>