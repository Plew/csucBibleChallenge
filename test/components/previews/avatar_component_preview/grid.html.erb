<div class="p-8">
  <h2 class="text-2xl font-bold mb-4">Avatar Grid - All Sizes</h2>

  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-8">
    <!-- Tiny Avatars -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold border-b pb-2">Tiny (24x24)</h3>
      <div class="flex flex-wrap gap-2">
        <% 12.times do %>
          <%= render(AvatarComponent.new(user: user, size: :tiny)) %>
        <% end %>
      </div>
      <p class="text-sm text-gray-600">Inline lists, compact UI</p>
    </div>

    <!-- Medium Avatars -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold border-b pb-2">Medium (36x36)</h3>
      <div class="flex flex-wrap gap-3">
        <% 8.times do %>
          <%= render(AvatarComponent.new(user: user, size: :medium)) %>
        <% end %>
      </div>
      <p class="text-sm text-gray-600">Default size, cards</p>
    </div>

    <!-- Large Avatars -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold border-b pb-2">Large (48x48)</h3>
      <div class="flex flex-wrap gap-4">
        <% 6.times do %>
          <%= render(AvatarComponent.new(user: user, size: :large)) %>
        <% end %>
      </div>
      <p class="text-sm text-gray-600">Navigation, headers</p>
    </div>

    <!-- XLarge Avatars -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold border-b pb-2">XLarge (64x64)</h3>
      <div class="flex flex-wrap gap-4">
        <% 4.times do %>
          <%= render(AvatarComponent.new(user: user, size: :xlarge)) %>
        <% end %>
      </div>
      <p class="text-sm text-gray-600">Profile pages</p>
    </div>

    <!-- XXLarge Avatars -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold border-b pb-2">XXLarge (96x96)</h3>
      <div class="flex flex-wrap gap-4">
        <% 3.times do %>
          <%= render(AvatarComponent.new(user: user, size: :xxlarge)) %>
        <% end %>
      </div>
      <p class="text-sm text-gray-600">Prominent displays</p>
    </div>
  </div>

  <!-- Size Comparison -->
  <div class="mt-8 p-6 bg-base-200 rounded-lg">
    <h3 class="text-lg font-semibold mb-4">Size Comparison</h3>
    <div class="flex items-end gap-6">
      <div class="flex flex-col items-center gap-2">
        <%= render(AvatarComponent.new(user: user, size: :tiny)) %>
        <span class="text-xs">Tiny<br>24x24</span>
      </div>
      <div class="flex flex-col items-center gap-2">
        <%= render(AvatarComponent.new(user: user, size: :medium)) %>
        <span class="text-xs">Medium<br>36x36</span>
      </div>
      <div class="flex flex-col items-center gap-2">
        <%= render(AvatarComponent.new(user: user, size: :large)) %>
        <span class="text-xs">Large<br>48x48</span>
      </div>
      <div class="flex flex-col items-center gap-2">
        <%= render(AvatarComponent.new(user: user, size: :xlarge)) %>
        <span class="text-xs">XLarge<br>64x64</span>
      </div>
      <div class="flex flex-col items-center gap-2">
        <%= render(AvatarComponent.new(user: user, size: :xxlarge)) %>
        <span class="text-xs">XXLarge<br>96x96</span>
      </div>
    </div>
  </div>
</div>
