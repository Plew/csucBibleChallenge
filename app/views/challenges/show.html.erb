<div class="px-2">
  <div class="mb-4 flex justify-between items-center">
    <% if @user_enrollment %>
      <div></div>
    <% else %>
      <%= link_to t('common.back'), root_path, class: "text-sm text-base-content/70 hover:text-base-content" %>
    <% end %>
    <button
      data-controller="share"
      data-share-url-value="<%= @challenge.join_url %>"
      data-share-title-value="<%= @challenge.name %>"
      data-share-text-value="<%= t('challenges.share_challenge') %>"
      data-action="click->share#share"
      class="btn btn-circle btn-sm btn-outline btn-primary"
      title="<%= t('challenges.share_title') %>">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185z" />
      </svg>
    </button>
  </div>
  <div class="bg-base-100 shadow-sm rounded-lg p-4 md:p-6">
    <div class="flex justify-between items-start mb-2">
      <h1 class="text-lg font-semibold text-base-content line-clamp-2 flex-1"><%= @challenge.name %></h1>
    </div>

    <% if @challenge.description.present? %>
      <div class="mb-4 prose prose-sm max-w-none text-left">
        <%= markdown(@challenge.description) %>
      </div>
    <% end %>
    
    <%= render(CountdownComponent.new(challenge: @challenge)) %>

    <div class="mb-4">
      <div class="overflow-x-auto">
        <table class="table table-xs">
          <tbody>
            <tr>
              <td class="font-semibold text-xs py-1"><%= t('challenges.start_date') %></td>
              <td class="text-xs py-1"><%= @challenge.start_date.strftime('%B %-d, %Y') %></td>
            </tr>
            <tr>
              <td class="font-semibold text-xs py-1"><%= t('challenges.end_date') %></td>
              <td class="text-xs py-1"><%= @challenge.end_date.strftime('%B %-d, %Y') %></td>
            </tr>
            <% if @most_recent_user %>
              <tr>
                <td class="font-semibold text-xs py-1"><%= t('challenges.newest_member') %></td>
                <td class="text-xs py-1"><%= @most_recent_user.name %> (<%= time_ago_in_words(@most_recent_join_time) %> <%= t('common.ago') %>)</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>



    <div class="flex flex-col items-center mb-6 mt-8 gap-4">
      <% if logged_in? %>
        <% if @user_enrollment %>
          <p class="text-sm text-primary mb-2"><%= t('challenges.you_are_member') %></p>
          <%= button_to t('challenges.leave_challenge'), user_challenge_enrollment_path(@user_enrollment), method: :delete, class: "btn btn-outline btn-error", data: { confirm: t('challenges.leave_confirmation') } %>
        <% else %>
          <%= button_to t('challenges.join_challenge'), challenge_enrollments_path(challenge_id: @challenge.id), method: :post, class: "btn btn-primary" %>
        <% end %>
      <% else %>
        <%= link_to t('challenges.join_challenge'), new_user_registration_path(challenge_id: @challenge.id), class: "btn btn-primary" %>
      <% end %>
    </div>

    <% if @participants.any? %>
      <div class="mb-6">
        <div class="collapse collapse-arrow border-base-300 bg-base-200 border">
          <input type="checkbox" id="participants-collapse">
          <label for="participants-collapse" class="collapse-title text-xl font-medium flex items-center gap-2 pr-12">
            <span class="truncate"><%= t('challenges.participants') %>: <%= @user_count %></span>
          </label>
          <div class="collapse-content">
            <div class="space-y-1">
              <% @participants.each do |participant| %>
                <div class="flex items-center gap-3 px-3 py-2 bg-base-100 rounded-lg">
                  <div>
                    <%= avatar_image_tag(participant, :tiny, class: 'rounded-full') %>
                  </div>
                  <div class="font-medium text-sm"><%= participant.name %></div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if @groups.any? || (@user_enrollment && !@user_group && @challenge.start_date > Date.current) %>
      <div class="mb-6">
        <div class="collapse collapse-arrow border-base-300 bg-base-200 border">
          <input type="checkbox" id="groups-collapse">
          <label for="groups-collapse" class="collapse-title text-xl font-medium flex items-center gap-2 pr-12">
            <span class="truncate"><%= t('navigation.groups') %>: <%= @groups.count %></span>
          </label>
          <div class="collapse-content">
            <div class="space-y-2">
              <% @groups.each_with_index do |group, index| %>
                <% is_user_group = @user_group && group.id == @user_group.id %>
                <div class="bg-base-100 rounded-lg <%= 'ring-2 ring-primary' if is_user_group %>">
                  <div class="collapse collapse-arrow">
                    <input type="checkbox" id="group-<%= group.id %>-collapse">
                    <label for="group-<%= group.id %>-collapse" class="collapse-title min-h-0 py-2 px-3 pr-12">
                      <div class="flex flex-col gap-1 min-w-0">
                        <div class="font-medium text-sm truncate"><%= group.name %></div>
                        <% if group.motto.present? %>
                          <div class="text-xs text-base-content/70 italic truncate"><%= group.motto %></div>
                        <% end %>
                        <div class="flex -space-x-2 overflow-hidden max-w-full">
                          <% group.users.limit(5).each do |user| %>
                            <%= avatar_image_tag(user, :tiny, class: 'rounded-full border-2 border-base-100') %>
                          <% end %>
                          <% if group.users.count > 5 %>
                            <div class="w-8 h-8 rounded-full bg-base-300 border-2 border-base-100 flex items-center justify-center flex-shrink-0">
                              <span class="text-xs font-medium">+<%= group.users.count - 5 %></span>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </label>
                    <div class="collapse-content px-3 pb-2">
                      <div class="space-y-1">
                        <% group.users.each do |user| %>
                          <div class="flex items-center gap-3 px-3 py-2 bg-base-200 rounded-lg">
                            <div>
                              <%= avatar_image_tag(user, :tiny, class: 'rounded-full') %>
                            </div>
                            <div class="font-medium text-sm"><%= user.name %></div>
                          </div>
                        <% end %>
                        <% if is_user_group %>
                          <div class="mt-3 pt-2 border-t border-base-300">
                            <%= link_to t('groups.leave_group'), leave_challenge_group_path(@challenge, @user_group),
                                data: { turbo_method: :post, turbo_confirm: t('groups.leave_confirmation') },
                                class: "text-sm text-error hover:underline" %>
                          </div>
                        <% elsif @user_enrollment && !@user_group %>
                          <div class="mt-3 pt-2 border-t border-base-300">
                            <%= button_to t('groups.join_group'), join_challenge_group_path(@challenge, group),
                                method: :post,
                                class: "btn btn-primary btn-sm w-full" %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>

              <% if @user_enrollment && !@user_group && @challenge.start_date > Date.current %>
                <div class="mt-4 pt-3 border-t border-base-300">
                  <div data-controller="toggle">
                    <button type="button"
                            data-action="click->toggle#toggle"
                            class="btn btn-primary btn-sm w-full">
                      <%= t('groups.create_new_group') %>
                    </button>

                    <div data-toggle-target="content" class="hidden mt-3">
                      <%= form_with url: challenge_groups_path(@challenge), method: :post, class: "space-y-3", local: true do |f| %>
                        <div>
                          <label class="label">
                            <span class="label-text text-sm"><%= t('groups.group_name') %></span>
                          </label>
                          <%= text_field_tag 'group[name]', '',
                              placeholder: t('groups.name_placeholder'),
                              required: true,
                              class: "input input-bordered input-sm w-full" %>
                        </div>

                        <div>
                          <label class="label">
                            <span class="label-text text-sm"><%= t('groups.group_motto') %></span>
                          </label>
                          <%= text_field_tag 'group[motto]', '',
                              placeholder: t('groups.motto_placeholder'),
                              class: "input input-bordered input-sm w-full" %>
                        </div>

                        <div class="flex gap-2">
                          <%= f.submit t('groups.create_new_group'), class: "btn btn-primary btn-sm flex-1" %>
                          <button type="button"
                                  data-action="click->toggle#toggle"
                                  class="btn btn-outline btn-sm flex-1">
                            <%= t('groups.cancel_create') %>
                          </button>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if @challenge_readings.any? %>
      <div class="mb-6">
        <div class="collapse collapse-arrow border-base-300 bg-base-200 border">
          <input type="checkbox" id="reading-schedule-collapse">
          <label for="reading-schedule-collapse" class="collapse-title text-xl font-medium">
            <%= t('challenges.reading_schedule') %>
          </label>
          <div class="collapse-content">
            <div class="space-y-1">
              <% @challenge_readings.each do |reading| %>
                <div class="flex items-center justify-between px-3 py-2 bg-base-100 rounded-lg">
                  <div class="text-xs font-medium text-primary"><%= reading.scheduled_date.strftime('%m/%d/%Y') %></div>
                  <div class="text-xs font-medium"><%= book_number_to_name(reading.book_number) %> <%= reading.chapter_number %></div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>