<div class="px-2">
  <div class="mb-4">
    <%= link_to "← Back", reading_path, class: "text-sm text-base-content/70 hover:text-base-content" %>
  </div>
  <div class="bg-base-100 shadow-sm rounded-lg p-4 md:p-6">
    <h1 class="text-lg font-semibold mb-2 text-base-content text-center"><%= @challenge.name %></h1>
    
    <% if @challenge.description.present? %>
      <div class="mb-4">
        <p class="text-sm text-base-content/80 text-center"><%= @challenge.description %></p>
      </div>
    <% end %>
    
    <%= render(CountdownComponent.new(challenge: @challenge)) %>

    <div class="mb-4">
      <div class="overflow-x-auto">
        <table class="table table-xs">
          <tbody>
            <tr>
              <td class="font-semibold text-xs py-1">Start Date</td>
              <td class="text-xs py-1"><%= @challenge.start_date.strftime('%B %-d, %Y') %></td>
            </tr>
            <tr>
              <td class="font-semibold text-xs py-1">End Date</td>
              <td class="text-xs py-1"><%= @challenge.end_date.strftime('%B %-d, %Y') %></td>
            </tr>
            <tr>
              <td class="font-semibold text-xs py-1">Num Participants</td>
              <td class="text-xs py-1"><%= @user_count %></td>
            </tr>
            <% if @most_recent_user %>
              <tr>
                <td class="font-semibold text-xs py-1">Recent Member</td>
                <td class="text-xs py-1"><%= @most_recent_user.name %></td>
              </tr>
              <tr>
                <td class="font-semibold text-xs py-1">Joined</td>
                <td class="text-xs py-1"><%= time_ago_in_words(@most_recent_join_time) %> ago</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>



    <div class="flex justify-center mb-6 mt-8">
      <% if logged_in? %>
        <% if current_user.challenges.include?(@challenge) %>
          <button class="btn btn-outline btn-success" disabled>
            Already Joined
          </button>
        <% else %>
          <%= button_to "Join Challenge", challenge_enrollments_path(challenge_id: @challenge.id), method: :post, class: "btn btn-primary" %>
        <% end %>
      <% else %>
        <%= button_to "Join Challenge", challenge_enrollments_path(challenge_id: @challenge.id), method: :post, class: "btn btn-primary" %>
      <% end %>
    </div>

    <% if @challenge_readings.any? %>
      <div class="mb-6">
        <div class="collapse collapse-arrow border-base-300 bg-base-200 border">
          <input type="checkbox" id="reading-schedule-collapse">
          <label for="reading-schedule-collapse" class="collapse-title text-xl font-medium">
            Reading Schedule
          </label>
          <div class="collapse-content"> 
            <div class="overflow-x-auto">
              <table class="table table-xs">
                <thead>
                  <tr>
                    <th class="text-xs">Date</th>
                    <th class="text-xs">Chapter</th>
                  </tr>
                </thead>
                <tbody>
                  <% @challenge_readings.each do |reading| %>
                    <tr>
                      <td class="text-xs py-1"><%= reading.scheduled_date.strftime('%m/%d/%Y') %></td>
                      <td class="text-xs py-1"><%= book_number_to_name(reading.book_number) %> <%= reading.chapter_number %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>