<% if logged_in? && current_user.challenges.empty? %>
  <div class="mb-4">
    <%= link_to t('challenges.create_new'), new_challenge_path, class: "btn btn-primary btn-sm w-full" %>
  </div>
<% end %>

<% if challenges.any? %>
  <div class="grid grid-cols-1 gap-3">
    <% challenges.each do |challenge| %>
      <%= link_to challenge_path(challenge), class: "block" do %>
        <div class="bg-base-100 shadow-sm rounded-lg p-3 hover:bg-base-200 transition-colors">
          <div class="flex justify-between items-start mb-2">
            <h2 class="text-sm font-semibold line-clamp-2 flex-1"><%= challenge.name %></h2>
            <span class="btn btn-primary btn-xs h-6 ml-2 flex-shrink-0"><%= t('challenges.details') %></span>
          </div>

          <% first_reading = challenge.readings.min_by(&:scheduled_date) %>
          <% last_reading = challenge.readings.max_by(&:scheduled_date) %>

          <div class="text-xs text-base-content/70 space-y-0.5">
            <% if first_reading && last_reading %>
              <div><%= book_number_to_name(first_reading.book_number) %> <%= first_reading.chapter_number %> — <%= book_number_to_name(last_reading.book_number) %> <%= last_reading.chapter_number %></div>
            <% end %>
            <div class="flex flex-wrap gap-x-3">
              <span><%= t('challenges.participants') %>: <%= challenge.users.size %></span>
              <span><%= t('navigation.groups') %>: <%= challenge.groups.size %></span>
            </div>
            <div class="flex flex-wrap gap-x-3">
              <span><%= t('challenges.start_date') %>: <%= challenge.start_date.strftime('%-d %b %Y') %></span>
              <span><%= t('challenges.end_date') %>: <%= challenge.end_date.strftime('%-d %b %Y') %></span>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="bg-base-100 shadow-sm rounded-lg p-3 flex flex-col items-center text-center">
    <h2 class="text-sm font-medium mb-2"><%= t('challenges.no_challenges') %></h2>
    <p class="text-xs"><%= t('challenges.no_challenges_message') %></p>
  </div>
<% end %>
