<% challenges.each do |challenge| %>
  <%= link_to challenge_path(challenge), class: "block bg-base-200 border border-base-300 rounded-2xl shadow-sm hover:shadow-md transition-shadow p-5 group relative overflow-hidden" do %>
    
    <!-- Top Row: Title & Button -->
    <div class="flex justify-between items-start mb-3">
      <div class="flex items-center gap-3 pr-4">
        <h3 class="text-lg md:text-xl font-bold font-serif text-neutral group-hover:text-primary transition-colors">
          <%= challenge.name %>
        </h3>
        <% if challenge.locked? %>
          <div class="badge badge-sm badge-neutral font-medium" title="This challenge is locked">
            Locked
          </div>
        <% end %>
      </div>
      
      <!-- Details Button -->
      <span class="btn btn-xs md:btn-sm btn-outline hover:btn-primary rounded-full text-xs shrink-0 font-medium border-base-300">Details</span>
    </div>

    <!-- Bottom Row: Meta Data -->
    <div class="text-xs md:text-sm font-medium text-neutral/60 space-y-1">
      <% if challenge.reading_range.present? %>
        <p class="text-neutral/80 mb-1.5">
          <%= challenge.reading_range %>
        </p>
      <% end %>
      
      <p>
        Participants: <%= challenge.users.count %> &nbsp;&nbsp;|&nbsp;&nbsp; Groups: <%= challenge.groups.count %>
      </p>
      
      <p>
        Start Date: <%= challenge.start_date.strftime("%d %b %Y") %> &nbsp;&nbsp;|&nbsp;&nbsp; End Date: <%= challenge.end_date.strftime("%d %b %Y") %>
      </p>
    </div>
    
  <% end %>
<% end %>