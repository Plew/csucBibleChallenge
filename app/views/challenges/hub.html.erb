<div class="max-w-4xl mx-auto px-4 py-8 space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl md:text-3xl font-bold font-serif text-neutral">
        <%= t('challenges.my_challenges') %>
      </h1>
      <p class="text-xs uppercase tracking-widest text-neutral/50 font-semibold mt-1">
        Manage and switch between your Bible reading challenges
      </p>
    </div>
    
    <div class="flex items-center gap-2">
      <%= link_to challenges_path, class: "btn btn-outline hover:btn-primary btn-sm rounded-full" do %>
        <%= t('challenges.browse_all') %>
      <% end %>
      <% if current_user&.can_create_challenges? %>
        <%= link_to new_challenge_path, class: "btn btn-primary btn-sm rounded-full" do %>
          + <%= t('challenges.create_new') %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Active Challenge Highlight -->
  <% if @active_challenge %>
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-xs uppercase tracking-widest text-primary font-bold">
          <%= t('challenges.currently_active') %> Challenge
        </h2>
      </div>

      <div class="bg-primary/10 border-2 border-primary rounded-3xl p-6 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
        <div class="space-y-2 flex-1">
          <div class="flex items-center gap-2">
            <h3 class="text-xl md:text-2xl font-bold font-serif text-neutral"><%= @active_challenge.name %></h3>
            <span class="badge badge-primary badge-sm font-semibold">Active</span>
          </div>
          <p class="text-sm text-neutral/70">
            <%= @active_challenge.start_date.strftime("%B %d, %Y") %> &mdash; <%= @active_challenge.end_date.strftime("%B %d, %Y") %>
          </p>
          <div class="flex items-center gap-4 text-xs text-neutral/60 font-medium pt-1">
            <span>👥 <%= @active_challenge.users.count %> participants</span>
            <span>📖 <%= @active_challenge.readings.count %> chapters</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
          <%= link_to reading_path, class: "btn btn-primary rounded-full px-6 flex-1 md:flex-initial" do %>
            <%= t('challenges.start_reading') %>
          <% end %>
          <%= link_to challenge_path(@active_challenge), class: "btn btn-ghost btn-sm rounded-full" do %>
            <%= t('challenges.details') %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- Other Enrolled Challenges -->
  <section class="space-y-4">
    <h2 class="text-lg font-bold font-serif text-neutral">
      Enrolled Challenges (<%= @enrolled_challenges.count %>)
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @enrolled_challenges.each do |challenge| %>
        <% is_active = (@active_challenge&.id == challenge.id) %>
        <% st = reading_status_for_challenge(challenge) %>
        <div class="bg-base-200 border rounded-2xl p-5 shadow-sm transition-all select-none cursor-pointer <%= is_active ? 'border-primary/50 ring-1 ring-primary/30' : 'border-base-300 hover:shadow-md hover:border-primary/40' %> flex flex-col justify-between gap-4"
             data-controller="challenge-card"
             data-challenge-card-switch-url-value="<%= switch_active_challenge_path(challenge_id: challenge.id, redirect_to: challenges_hub_path) %>"
             data-challenge-card-is-active-value="<%= is_active %>"
             data-action="click->challenge-card#handleTap dblclick->challenge-card#handleDblClick"
             title="<%= is_active ? 'Active Challenge' : 'Double-click anywhere to switch active challenge' %>">
          <div class="space-y-2 pointer-events-auto">
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-bold text-base md:text-lg text-neutral"><%= challenge.name %></h3>
              <% if is_active %>
                <span class="badge badge-primary badge-xs py-2 px-2 text-[10px] font-semibold shrink-0">Current</span>
              <% end %>
            </div>
            <p class="text-xs text-neutral/60">
              <%= challenge.start_date.strftime("%b %d") %> &mdash; <%= challenge.end_date.strftime("%b %d, %Y") %>
            </p>

            <!-- Daily Reading Status Badge -->
            <div class="pt-0.5">
              <%= reading_status_badge(challenge, status: st, variant: :compact) %>
            </div>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-base-200 pointer-events-auto">
            <%= link_to t('challenges.details'), challenge_path(challenge), class: "text-xs text-neutral/60 hover:text-primary transition-colors underline" %>

            <% if is_active %>
              <%= link_to reading_path, class: "btn btn-primary btn-xs rounded-full px-4", data: { "challenge-card-target": "readButton" } do %>
                <%= t('challenges.start_reading') %>
              <% end %>
            <% else %>
              <%= button_to switch_active_challenge_path(challenge_id: challenge.id, redirect_to: challenges_hub_path), method: :patch, class: "btn btn-outline btn-xs rounded-full px-4 hover:btn-primary", data: { "challenge-card-target": "switchButton" } do %>
                <%= t('challenges.switch_to') %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Public / Available Challenges to Join -->
  <% if @public_challenges.present? %>
    <section class="space-y-4 pt-4 border-t border-base-200">
      <div class="space-y-1">
        <h2 class="text-lg font-bold font-serif text-neutral">
          More Challenges to Join
        </h2>
        <p class="text-xs text-neutral/60">Explore other reading plans and read alongside more groups.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% @public_challenges.each do |challenge| %>
          <div class="bg-base-100 border border-base-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between gap-4">
            <div class="space-y-1">
              <h3 class="font-bold text-base md:text-lg text-neutral"><%= challenge.name %></h3>
              <p class="text-xs text-neutral/60">
                <%= challenge.start_date.strftime("%b %d") %> &mdash; <%= challenge.end_date.strftime("%b %d, %Y") %>
              </p>
              <p class="text-xs text-neutral/50">
                <%= challenge.users.count %> participants
              </p>
            </div>

            <div class="flex items-center justify-between pt-2 border-t border-base-200">
              <%= link_to t('challenges.details'), challenge_path(challenge), class: "text-xs text-neutral/60 hover:text-primary transition-colors underline" %>
              <%= button_to t('challenges.join_challenge'), challenge_enrollments_path(challenge_id: challenge.id), method: :post, class: "btn btn-primary btn-xs rounded-full px-4" %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
