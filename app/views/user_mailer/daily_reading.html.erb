<h1>Good morning, <%= @user.username %>!</h1>

<p>
  Click below to log in and read today's <%= (@readings&.size.to_i > 1) ? 'chapters' : 'reading' %>:
  <strong><%= @reading_title %></strong>.
</p>

<p style="text-align: center; margin: 30px 0;">
  <%= link_to "Read Now", email_login_url(@login_token.token), class: "btn btn-primary", style: "background-color: #4F46E5; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block; font-weight: bold;" %>
</p>

<p>Thanks,</p>
<p>The And God Said Team</p>
