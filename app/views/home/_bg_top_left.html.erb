<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" fill="none" class="<%= local_assigns[:class] %>">
  <!-- Muted Olive Shape -->
  <path d="M-50,150 C 50,100 150,200 200,350 C 250,500 100,550 -50,500 Z" class="fill-[#8A9575] dark:fill-[#3D4432] opacity-60 dark:opacity-40" />
  
  <!-- Mustard/Gold Shape -->
  <path d="M-100,-50 C 100,-80 250,50 200,250 C 150,450 -50,400 -150,300 Z" class="fill-[#C79C46] dark:fill-[#8C6F32] opacity-80 dark:opacity-30" />
  
  <!-- Subtle Outline Shape -->
  <path d="M50,-10 C 200,-30 350,80 300,280 C 250,480 50,450 -50,350 Z" class="stroke-[#C79C46] dark:stroke-[#8C6F32] opacity-40 dark:opacity-20" stroke-width="2" />
</svg>