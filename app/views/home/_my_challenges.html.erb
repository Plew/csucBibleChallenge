<div id="my_challenges_list" class="space-y-4">
  <% my_challenges.each do |challenge| %>
    <% is_active = (current_active_challenge&.id == challenge.id) %>
    <% st = reading_status_for_challenge(challenge) %>
    <div class="bg-base-200 border rounded-2xl p-5 shadow-sm hover:shadow-md transition-all flex flex-col md:flex-row justify-between items-start md:items-center gap-4 select-none cursor-pointer <%= is_active ? 'border-primary/50 ring-1 ring-primary/30' : 'border-base-300 hover:border-primary/40' %>"
         data-controller="challenge-card"
         data-challenge-card-switch-url-value="<%= switch_active_challenge_path(challenge_id: challenge.id, redirect_to: root_path) %>"
         data-challenge-card-is-active-value="<%= is_active %>"
         data-action="click->challenge-card#handleTap dblclick->challenge-card#handleDblClick"
         title="<%= is_active ? 'Active Challenge' : 'Double-click anywhere to switch active challenge' %>">
      <div class="space-y-2 flex-1 pointer-events-auto">
        <div class="flex items-center gap-2 flex-wrap">
          <h3 class="font-bold text-lg md:text-xl text-neutral"><%= challenge.name %></h3>
          <% if is_active %>
            <span class="badge badge-primary badge-xs py-1.5 px-2 text-[10px] font-semibold">Active</span>
          <% end %>
        </div>
        <p class="text-sm text-neutral/60">
          <%= challenge.start_date.strftime("%b %d") %> &mdash; <%= challenge.end_date.strftime("%b %d, %Y") %>
        </p>

        <!-- Daily Reading Status Badge -->
        <div class="flex flex-wrap items-center gap-2 pt-0.5">
          <%= reading_status_badge(challenge, status: st, variant: :detailed) %>
        </div>
      </div>

      <div class="flex items-center gap-2 w-full md:w-auto shrink-0">
        <% if is_active %>
          <%= link_to (st[:read_today] ? "View Reading" : "Read Today"), reading_path(challenge_id: challenge.id), class: "btn #{st[:read_today] ? 'btn-outline hover:btn-primary' : 'btn-primary'} btn-sm md:btn-md rounded-full w-full md:w-auto", data: { "challenge-card-target": "readButton" } %>
        <% else %>
          <%= button_to switch_active_challenge_path(challenge_id: challenge.id, redirect_to: reading_path), method: :patch, class: "btn btn-outline hover:btn-primary btn-sm md:btn-md rounded-full w-full md:w-auto", data: { "challenge-card-target": "switchButton" } do %>
            Switch &amp; Read
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
