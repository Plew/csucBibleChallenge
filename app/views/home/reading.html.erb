<div class="container mx-auto">
  <% if @user_challenge %>
    <div class="flex items-center justify-between mb-4 px-2">
      <!-- Previous Day Arrow -->
      <a href="/reading?date=<%= @previous_date %>" class="flex-shrink-0 p-2 hover:bg-base-200 rounded-full transition-colors">
        <svg class="w-5 h-5 text-base-content/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
      </a>

      <!-- Date Display - Clickable to open date picker -->
      <button type="button"
              class="text-lg font-medium text-base-content text-center cursor-pointer hover:text-primary transition-colors"
              onclick="document.getElementById('date-picker-modal').showModal()">
        <%= @selected_date.strftime('%A, %B %-d, %Y') %>
      </button>

      <!-- Date Picker Modal -->
      <dialog id="date-picker-modal" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box p-0 bg-transparent shadow-none max-w-xs mx-auto">
          <%= render DatePickerComponent.new(
            selected_date: @selected_date,
            challenge: @user_challenge,
            user: current_user
          ) %>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button><%= t('common.close') %></button>
        </form>
      </dialog>

      <!-- Next Day Arrow -->
      <a href="/reading?date=<%= @next_date %>" class="flex-shrink-0 p-2 hover:bg-base-200 rounded-full transition-colors">
        <svg class="w-5 h-5 text-base-content/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <% if @selected_readings.present? && @selected_readings.count > 1 %>
      <% completed_count = @selected_readings.count { |r| current_user.user_readings.exists?(reading_id: r.id) } %>
      <div class="mb-4 px-2 space-y-2">
        <div class="flex items-center justify-between text-xs text-base-content/70 px-1">
          <span class="font-semibold uppercase tracking-wider">Chapters for Today</span>
          <span class="badge badge-sm <%= completed_count == @selected_readings.count ? 'badge-success text-success-content' : 'badge-ghost' %> font-medium">
            <%= completed_count %> of <%= @selected_readings.count %> completed
          </span>
        </div>
        
        <div class="flex items-center gap-2 overflow-x-auto py-1 no-scrollbar">
          <% @selected_readings.each do |reading| %>
            <% is_current = (reading.id == @selected_reading.id) %>
            <% is_read = current_user.user_readings.exists?(reading_id: reading.id) %>
            <% title = "#{book_number_to_name(reading.book_number)} #{reading.chapter_number}" %>
            
            <%= link_to reading_path(date: @selected_date, reading_id: reading.id), 
                        class: "btn btn-sm rounded-full gap-1.5 whitespace-nowrap transition-all #{is_current ? 'btn-primary shadow-sm font-bold' : 'btn-outline border-base-300 font-medium hover:btn-primary'}" do %>
              <% if is_read %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 <%= is_current ? 'text-primary-content' : 'text-success' %>" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              <% end %>
              <span><%= title %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @selected_reading %>
      <!-- Presence tracking with floating avatars -->
      <div data-controller="reading-presence" data-reading-presence-reading-id-value="<%= @selected_reading.id %>">
        <!-- Floating avatar container - fixed position bottom left, horizontal -->
        <div data-reading-presence-target="avatars"
             class="fixed bottom-2 left-2 z-50 flex flex-row gap-1 hidden">
        </div>
      </div>
      <% reading_is_completed = current_user.user_readings.exists?(reading_id: @selected_reading.id) %>

      <!-- Top "marked as read" button - only show if reading is completed -->
      <% if reading_is_completed %>
        <div class="flex justify-center mt-4 mb-4">
          <button class="btn btn-outline btn-success" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <%= t('reading.marked_as_read') %>
          </button>
        </div>
      <% end %>

      <%= render InteractiveReadingDisplayComponent.new(
        title: @selected_reading_title,
        verses: @selected_reading_verses,
        current_user: current_user,
        is_completed: reading_is_completed
      ) %>

      <div class="flex justify-center mt-4 mb-4">
        <% if reading_is_completed %>
          <button class="btn btn-outline btn-success" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <%= t('reading.marked_as_read') %>
          </button>
        <% else %>
          <% date_param = @selected_date != Time.current.in_time_zone(@user_challenge.timezone).to_date ? { date: @selected_date } : {} %>
          <%= button_to user_readings_path(reading_id: @selected_reading.id, **date_param), method: :post, class: "btn btn-success" do %>
            <%= t('reading.mark_as_read') %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
          <% end %>
        <% end %>
      </div>

      <% if current_user.version == "RCV" %>
        <p class="text-center text-xs <%= @user_challenge.hide_copyright ? 'text-base-content/[3%]' : 'text-base-content/30' %> mx-4 mb-12">Holy Bible Recovery Version (text-only edition) © 2025 Living Stream Ministry www.lsm.org</p>
      <% else %>
        <div class="mb-12"></div>
      <% end %>
    <% else %>
      <div class="bg-base-100 border border-base-200 shadow-sm rounded-2xl p-8 my-6 flex flex-col items-center text-center space-y-3 max-w-md mx-auto">
        <div class="p-3 bg-base-200 rounded-full text-base-content/60">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <h2 class="text-lg font-bold font-serif text-neutral">Rest / Catch-up Day</h2>
        <p class="text-xs text-base-content/70">No chapters are scheduled for today in this challenge. Use this time to catch up, reflect, or pray!</p>
        <div class="pt-2">
          <%= link_to reading_path(date: @selected_date + 1.day), class: "btn btn-outline btn-sm rounded-full" do %>
            Next Day &rarr;
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div> 