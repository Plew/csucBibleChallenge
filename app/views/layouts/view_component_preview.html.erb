<!DOCTYPE html>
<html>
<%= render 'layouts/head' %>

<body>
  <div class="navbar bg-base-100 shadow-lg" x-data="{ mobileMenuIsOpen: false }">
    <div class="navbar-start">
      <%= link_to "ReVerse", root_path, class: "btn btn-ghost normal-case text-xl" %>
    </div>

    <div class="navbar-end">
      <%# Mobile Menu Button %>
      <button @click="mobileMenuIsOpen = !mobileMenuIsOpen" class="btn btn-ghost btn-circle">
        <span class="sr-only">Open main menu</span>
        <%# Hamburger icon %>
        <svg class="h-6 w-6" x-show="!mobileMenuIsOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <%# Close (X) icon %>
        <svg class="h-6 w-6" x-show="mobileMenuIsOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display: none;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <%# Mobile Menu Dropdown - Positioned absolutely, controlled by AlpineJS %>
      <div x-show="mobileMenuIsOpen" 
          @click.away="mobileMenuIsOpen = false"
          x-transition:enter="transition ease-out duration-100 transform"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-75 transform"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          class="absolute top-16 right-0 w-48 mt-2 origin-top-right bg-base-100 rounded-md shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
          style="display: none;" <%# Keep display:none here, x-show handles visibility %>
          role="menu" aria-orientation="vertical" aria-labelledby="menu-button" tabindex="-1">
        <div class="py-1" role="none">
            <%= link_to "Log In", new_user_session_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
        </div>
      </div>
    </div>

  </div>

  <%# Flash Messages %>
  <% if flash[:notice] %>
    <div x-data="{ show: true }"
         x-init="setTimeout(() => show = false, 2500)"
         x-show="show"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 transform translate-y-4 sm:translate-y-0 sm:scale-95"
         x-transition:enter-end="opacity-50 transform translate-y-0 sm:scale-100"
         x-transition:leave="transition ease-in duration-300"
         x-transition:leave-start="opacity-50 transform translate-y-0 sm:scale-100"
         x-transition:leave-end="opacity-0 transform translate-y-4 sm:translate-y-0 sm:scale-95"
         class="fixed top-5 left-1/2 -translate-x-1/2 z-50 alert alert-success shadow-lg rounded-box w-auto max-w-sm">
      <div>
        <span><%= flash[:notice] %></span>
      </div>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div x-data="{ show: true }"
         x-init="setTimeout(() => show = false, 2500)"
         x-show="show"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 transform translate-y-4 sm:translate-y-0 sm:scale-95"
         x-transition:enter-end="opacity-50 transform translate-y-0 sm:scale-100"
         x-transition:leave="transition ease-in duration-300"
         x-transition:leave-start="opacity-50 transform translate-y-0 sm:scale-100"
         x-transition:leave-end="opacity-0 transform translate-y-4 sm:translate-y-0 sm:scale-95"
         class="fixed top-5 left-1/2 -translate-x-1/2 z-50 alert alert-error shadow-lg rounded-box w-auto max-w-sm">
      <div>
        <span><%= flash[:alert] %></span>
      </div>
    </div>
  <% end %>

  <main class="container mx-auto mt-4 p-4">
    <%= yield %>
  </main>
</body>
</html> 