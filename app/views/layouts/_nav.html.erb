<nav class="px-4" x-data="{ mobileMenuIsOpen: false }" data-turbo-permanent="true">
  <div class="flex items-center justify-between h-16">
    <%= link_to root_path do %>
      <div class="text-3xl font-bold font-sans italic">ReVerse</div>
    <% end %>
    
    <div class="relative">
      <button class="btn btn-ghost btn-circle"
              aria-controls="mobile-menu"
              aria-expanded="false"
              type="button"
              @click="mobileMenuIsOpen = !mobileMenuIsOpen">
        <span class="sr-only">Open main menu</span>
        
        <%# Hamburger icon %>
        <svg class="h-6 w-6"
             x-show="!mobileMenuIsOpen"
             xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke="currentColor">
          <path stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        
        <%# Close (X) icon %>
        <svg class="h-6 w-6"
             x-show="mobileMenuIsOpen"
             xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke="currentColor">
          <path stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <%# Mobile menu dropdown %>
      <div x-show="mobileMenuIsOpen"
           @click.away="mobileMenuIsOpen = false"
           x-transition:enter="transition ease-out duration-100"
           x-transition:enter-start="transform opacity-0 scale-95"
           x-transition:enter-end="transform opacity-100 scale-100"
           x-transition:leave="transition ease-in duration-75"
           x-transition:leave-start="transform opacity-100 scale-100"
           x-transition:leave-end="transform opacity-0 scale-95"
           class="absolute right-0 mt-2 w-48 rounded-lg shadow-lg bg-base-100 border border-base-300"
           role="menu"
           aria-orientation="vertical"
           aria-labelledby="user-menu">
        <%= link_to t('navigation.profile'), edit_user_path, class: "block px-4 py-3 text-sm hover:bg-base-200", role: "menuitem" %>
        <%= link_to t('navigation.groups'), groups_path, class: "block px-4 py-3 text-sm hover:bg-base-200", role: "menuitem" %>
        <%= link_to t('navigation.about'), about_path, class: "block px-4 py-3 text-sm hover:bg-base-200", role: "menuitem" %>
        <%= link_to t('navigation.faq'), faq_path, class: "block px-4 py-3 text-sm hover:bg-base-200", role: "menuitem" %>
        
        <%# Language Selector %>
        <div class="border-t border-base-300 my-1"></div>
        <div class="px-4 py-2">
          <div class="text-xs text-base-content/70 mb-2"><%= t('navigation.language') %></div>
          <%= form_with url: update_language_path, method: :patch, local: true, class: "flex flex-col gap-1" do |form| %>
            <%= button_tag type: "submit", name: "locale", value: "en", 
                class: "flex items-center gap-2 px-2 py-1 text-sm rounded hover:bg-base-200 #{I18n.locale == :en ? 'bg-base-200' : ''}" do %>
              <span class="text-base">🇺🇸</span>
              <span><%= t('navigation.english') %></span>
            <% end %>
            <%= button_tag type: "submit", name: "locale", value: "de", 
                class: "flex items-center gap-2 px-2 py-1 text-sm rounded hover:bg-base-200 #{I18n.locale == :de ? 'bg-base-200' : ''}" do %>
              <span class="text-base">🇩🇪</span>
              <span><%= t('navigation.german') %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</nav> 

