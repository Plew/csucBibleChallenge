<div x-data="{ 
       show: true, 
       timer: null,
       startTimer() { 
         this.timer = setTimeout(() => this.show = false, 3500) 
       },
       pauseTimer() { 
         if (this.timer) clearTimeout(this.timer) 
       },
       resumeTimer() { 
         this.startTimer() 
       }
     }"
     x-init="startTimer(); 
             document.addEventListener('turbo:load', () => { show = true; startTimer() });
             document.addEventListener('turbo:render', () => { show = true; startTimer() })"
     x-show="show"
     @mouseenter="pauseTimer()"
     @mouseleave="resumeTimer()"
     x-transition:enter="transition ease-out duration-300 transform"
     x-transition:enter-start="opacity-0 -translate-y-4 md:translate-y-4 scale-95"
     x-transition:enter-end="opacity-100 translate-y-0 scale-100"
     x-transition:leave="transition ease-in duration-200 transform"
     x-transition:leave-start="opacity-100 translate-y-0 scale-100"
     x-transition:leave-end="opacity-0 -translate-y-4 md:translate-y-4 scale-95"
     class="alert <%= flash_class(type) %> shadow-xl rounded-2xl pointer-events-auto flex items-center justify-between gap-3 text-sm border border-base-content/10">
  <div class="flex items-center gap-2">
    <% case flash_class(type) %>
    <% when "alert-success" %>
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    <% when "alert-error" %>
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    <% when "alert-warning" %>
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    <% else %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    <% end %>
    <span><%= message %></span>
  </div>
  <button @click="show = false" class="btn btn-ghost btn-xs btn-circle text-current opacity-70 hover:opacity-100">✕</button>
</div>
