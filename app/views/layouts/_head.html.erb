<head>
  <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
  <title>And God Said</title>
  <meta content="width=device-width,initial-scale=1" name="viewport">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <meta name="turbo-prefetch" content="false">
  <meta name="rails-env" content="<%= Rails.env %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">

  <link rel="manifest" href="/manifest">
  <meta name="vapid-public-key" content="<%= Rails.application.config.webpush.vapid_public_key %>">
  <meta name="theme-color" content="#6B7558">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="AGS">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/icons/icon-48x48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="apple-touch-icon" href="/icons/icon-192x192.png">

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <script defer="defer" src="//unpkg.com/alpinejs"></script>

  <% if Rails.env.development? %>
    <%= javascript_include_tag "hotwire-livereload", defer: true %>
  <% end %>
  <%= javascript_importmap_tags %>

  <% if Rails.env.production? %>
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://pce.eleven89.org/js/pa-n9fd6b4gKb_BY59mo36aF.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  <% end %>
  
  <script>
    // Check local storage OR OS preference immediately
    if (localStorage.theme === 'andgodsaid-dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.setAttribute('data-theme', 'andgodsaid-dark')
    } else {
      document.documentElement.setAttribute('data-theme', 'andgodsaid')
    }
  </script>
</head> 