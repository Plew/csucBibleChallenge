<!DOCTYPE html>
<%# <html data-theme="cyberpunk"> %>
<%# <html data-theme="forest"> %>
<html>
  <%= render partial: 'layouts/head' %>
  
  <body data-controller="device-setup">
    <container class="h-dvh flex flex-col max-w-md mx-auto relative bg-base-100 text-base-content">
      <div class="max-w-full px-8 my-8 absolute top-0 left-0 right-0 z-50" data-controller="flash">
        <% flash.each do |key, value| %>
          <div class="alert <%= flash_class(key) %> z-50 p-4 text-center w-full mt-8" role="alert">
            <%= value %>
          </div>
        <% end %>
      </div>
      
      <%= render 'layouts/nav' %>
      <%= render(NavBarComponent.new) %>
      <%= yield %>
    </container>
  </body>
</html> 