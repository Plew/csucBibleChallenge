<!DOCTYPE html>
<html>
<head>
  <title>ReVerse</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <div class="navbar bg-base-100 shadow-lg">
    <div class="flex-1">
      <%= link_to "ReVerse", root_path, class: "btn btn-ghost normal-case text-xl" %>
    </div>
    <div class="flex-none">
      <ul class="menu menu-horizontal px-1">
        <% if logged_in? %>
          <li><%= link_to "Today's Reading", root_path %></li>
          <li><%= link_to "Challenges", challenges_path %></li>
          <li><%= link_to "Profile", edit_user_profile_path %></li>
          <li><%= link_to "Log Out", destroy_user_session_path, data: { turbo_method: :delete } %></li>
        <% else %>
          <li><%= link_to "Log In", new_user_session_path %></li>
          <li><%= link_to "Sign Up", new_user_registration_path %></li>
        <% end %>
      </ul>
    </div>
  </div>

  <%# Flash Messages %>
  <% if flash[:notice] %>
    <div class="alert alert-success shadow-lg rounded-none">
      <div>
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span><%= flash[:notice] %></span>
      </div>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div class="alert alert-error shadow-lg rounded-none">
      <div>
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2 2m2-2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span><%= flash[:alert] %></span>
      </div>
    </div>
  <% end %>

  <main class="container mx-auto mt-4 p-4">
    <%= yield %>
  </main>
</body>
</html> 