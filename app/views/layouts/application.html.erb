<!DOCTYPE html>
<html data-theme="dark">
<%= render 'layouts/head' %>

<body>
  <div class="navbar bg-base-100 shadow-lg" x-data="{ mobileMenuIsOpen: false }">
    <div class="navbar-start flex items-center min-w-0">
      <%= link_to root_path, class: "btn btn-ghost normal-case text-lg flex items-center gap-2 p-0" do %>
        <span class="font-mono">
          <span class="font-bold text-primary">Hie</span>ra 
          <span class="font-bold text-primary">Gra</span>mmata
        </span>
      <% end %>
    </div>

    <div class="navbar-end flex items-center gap-2">
      <%# Mobile Menu Button %>
      <button @click="mobileMenuIsOpen = !mobileMenuIsOpen" class="btn btn-ghost btn-circle">
        <span class="sr-only">Open main menu</span>
        <%# Hamburger icon %>
        <svg class="h-6 w-6" x-show="!mobileMenuIsOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <%# Close (X) icon %>
        <svg class="h-6 w-6" x-show="mobileMenuIsOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display: none;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <%# Mobile Menu Dropdown - Positioned absolutely, controlled by AlpineJS %>
      <div x-show="mobileMenuIsOpen" 
          @click.away="mobileMenuIsOpen = false"
          x-transition:enter="transition ease-out duration-100 transform"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-75 transform"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          class="absolute top-16 right-0 w-48 mt-2 origin-top-right bg-base-100 rounded-md shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none z-50"
          style="display: none;" <%# Keep display:none here, x-show handles visibility %>
          role="menu" aria-orientation="vertical" aria-labelledby="menu-button" tabindex="-1">
        <div class="py-1" role="none">
          <% if logged_in? %>
            <% if current_user.user_challenge_enrollments.any? %>
              <%= link_to "Today", root_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
            <% end %>
            <% if current_user.admin? %>
              <%= link_to "Create Challenge", new_admin_challenge_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
              <%= link_to "Manage Feedback", admin_feedbacks_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
            <% end %>
            <%= link_to "Send Feedback", new_feedback_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
            <%= link_to t('navigation.about'), about_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
            <%= link_to t('navigation.faq'), faq_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
            <%= link_to "Log Out", destroy_user_session_path, data: { turbo_method: :delete }, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
          <% else %>
            <%= link_to "Log In", new_user_session_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
            <%= link_to "Send Feedback", new_feedback_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
            <%= link_to t('navigation.about'), about_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
            <%= link_to t('navigation.faq'), faq_path, class: "block px-4 py-2 text-sm text-base-content hover:bg-base-200 hover:text-base-content", role: "menuitem", tabindex: "-1" %>
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <% if logged_in? %>
    <%= render(NavBarComponent.new) %>
  <% end %>

  <%# Flash Messages %>
  <% if flash[:notice] %>
    <div x-data="{ 
           show: true, 
           timer: null,
           startTimer() { 
             this.timer = setTimeout(() => this.show = false, 2000) 
           },
           pauseTimer() { 
             if (this.timer) clearTimeout(this.timer) 
           },
           resumeTimer() { 
             this.startTimer() 
           }
         }"
         x-init="startTimer(); document.addEventListener('turbo:load', () => { show = true; startTimer() })"
         x-show="show"
         @mouseenter="pauseTimer()"
         @mouseleave="resumeTimer()"
         x-transition:enter="transition ease-out duration-500 transform"
         x-transition:enter-start="opacity-0 translate-y-4 scale-95"
         x-transition:enter-end="opacity-100 translate-y-0 scale-100"
         x-transition:leave="transition ease-in duration-500 transform"
         x-transition:leave-start="opacity-100 translate-y-0 scale-100"
         x-transition:leave-end="opacity-0 translate-y-4 scale-95"
         class="fixed top-5 left-1/2 -translate-x-1/2 z-50 alert alert-success shadow-lg rounded-box w-auto max-w-md cursor-pointer">
      <div class="flex items-center justify-between">
        <span><%= flash[:notice] %></span>
        <button @click="show = false" class="ml-4 text-lg font-bold hover:opacity-70">×</button>
      </div>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div x-data="{ 
           show: true, 
           timer: null,
           startTimer() { 
             this.timer = setTimeout(() => this.show = false, 2000) 
           },
           pauseTimer() { 
             if (this.timer) clearTimeout(this.timer) 
           },
           resumeTimer() { 
             this.startTimer() 
           }
         }"
         x-init="startTimer(); document.addEventListener('turbo:load', () => { show = true; startTimer() })"
         x-show="show"
         @mouseenter="pauseTimer()"
         @mouseleave="resumeTimer()"
         x-transition:enter="transition ease-out duration-500 transform"
         x-transition:enter-start="opacity-0 translate-y-4 scale-95"
         x-transition:enter-end="opacity-100 translate-y-0 scale-100"
         x-transition:leave="transition ease-in duration-500 transform"
         x-transition:leave-start="opacity-100 translate-y-0 scale-100"
         x-transition:leave-end="opacity-0 translate-y-4 scale-95"
         class="fixed top-5 left-1/2 -translate-x-1/2 z-50 alert alert-error shadow-lg rounded-box w-auto max-w-md cursor-pointer">
      <div class="flex items-center justify-between">
        <span><%= flash[:alert] %></span>
        <button @click="show = false" class="ml-4 text-lg font-bold hover:opacity-70">×</button>
      </div>
    </div>
  <% end %>
  <% if flash[:info] %>
    <div x-data="{ 
           show: true, 
           timer: null,
           startTimer() { 
             this.timer = setTimeout(() => this.show = false, 2000) 
           },
           pauseTimer() { 
             if (this.timer) clearTimeout(this.timer) 
           },
           resumeTimer() { 
             this.startTimer() 
           }
         }"
         x-init="startTimer(); document.addEventListener('turbo:load', () => { show = true; startTimer() })"
         x-show="show"
         @mouseenter="pauseTimer()"
         @mouseleave="resumeTimer()"
         x-transition:enter="transition ease-out duration-500 transform"
         x-transition:enter-start="opacity-0 translate-y-4 scale-95"
         x-transition:enter-end="opacity-100 translate-y-0 scale-100"
         x-transition:leave="transition ease-in duration-500 transform"
         x-transition:leave-start="opacity-100 translate-y-0 scale-100"
         x-transition:leave-end="opacity-0 translate-y-4 scale-95"
         class="fixed top-5 left-1/2 -translate-x-1/2 z-50 alert alert-info shadow-lg rounded-box w-auto max-w-md cursor-pointer">
      <div class="flex items-center justify-between">
        <span><%= flash[:info] %></span>
        <button @click="show = false" class="ml-4 text-lg font-bold hover:opacity-70">×</button>
      </div>
    </div>
  <% end %>
  <% if flash[:success] %>
    <div x-data="{ 
           show: true, 
           timer: null,
           startTimer() { 
             this.timer = setTimeout(() => this.show = false, 2000) 
           },
           pauseTimer() { 
             if (this.timer) clearTimeout(this.timer) 
           },
           resumeTimer() { 
             this.startTimer() 
           }
         }"
         x-init="startTimer(); document.addEventListener('turbo:load', () => { show = true; startTimer() })"
         x-show="show"
         @mouseenter="pauseTimer()"
         @mouseleave="resumeTimer()"
         x-transition:enter="transition ease-out duration-500 transform"
         x-transition:enter-start="opacity-0 translate-y-4 scale-95"
         x-transition:enter-end="opacity-100 translate-y-0 scale-100"
         x-transition:leave="transition ease-in duration-500 transform"
         x-transition:leave-start="opacity-100 translate-y-0 scale-100"
         x-transition:leave-end="opacity-0 translate-y-4 scale-95"
         class="fixed top-5 left-1/2 -translate-x-1/2 z-50 alert alert-success shadow-lg rounded-box w-auto max-w-md cursor-pointer">
      <div class="flex items-center justify-between">
        <span><%= flash[:success] %></span>
        <button @click="show = false" class="ml-4 text-lg font-bold hover:opacity-70">×</button>
      </div>
    </div>
  <% end %>
  <% if flash[:danger] %>
    <div x-data="{ 
           show: true, 
           timer: null,
           startTimer() { 
             this.timer = setTimeout(() => this.show = false, 2000) 
           },
           pauseTimer() { 
             if (this.timer) clearTimeout(this.timer) 
           },
           resumeTimer() { 
             this.startTimer() 
           }
         }"
         x-init="startTimer(); document.addEventListener('turbo:load', () => { show = true; startTimer() })"
         x-show="show"
         @mouseenter="pauseTimer()"
         @mouseleave="resumeTimer()"
         x-transition:enter="transition ease-out duration-500 transform"
         x-transition:enter-start="opacity-0 translate-y-4 scale-95"
         x-transition:enter-end="opacity-100 translate-y-0 scale-100"
         x-transition:leave="transition ease-in duration-500 transform"
         x-transition:leave-start="opacity-100 translate-y-0 scale-100"
         x-transition:leave-end="opacity-0 translate-y-4 scale-95"
         class="fixed top-5 left-1/2 -translate-x-1/2 z-50 alert alert-error shadow-lg rounded-box w-auto max-w-md cursor-pointer">
      <div class="flex items-center justify-between">
        <span><%= flash[:danger] %></span>
        <button @click="show = false" class="ml-4 text-lg font-bold hover:opacity-70">×</button>
      </div>
    </div>
  <% end %>

  <main class="container mx-auto mt-1">
    <%= yield %>
  </main>
</body>
</html> 