doctype html
html
  = render partial: 'layouts/head'
  body.bg-back1
    .h-dvh.flex.flex-col.max-w-md.mx-auto.relative.overflow-x-hidden
      div data-controller="flash" class="absolute top-0 left-0 right-0 z-50 mx-auto"
        - flash.each do |key, value|
          div class="#{flash_class(key)}" role="alert"
            = value
      
      = render 'layouts/nav'
      = render(NavBarComponent.new)
      = yield

