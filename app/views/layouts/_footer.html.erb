<footer class="mt-auto border-t border-base-300/80 bg-base-100/60 py-10 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Brand & Tagline -->
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-secondary/15 flex items-center justify-center text-secondary shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M11.25 4.533A9.707 9.707 0 0 0 6 3a9.735 9.735 0 0 0-3.25.555.75.75 0 0 0-.5.707v14.25a.75.75 0 0 0 1 .707A8.237 8.237 0 0 1 6 18.75c1.995 0 3.823.707 5.25 1.886V4.533ZM12.75 20.636A8.214 8.214 0 0 1 18 18.75c.966 0 1.89.166 2.75.47a.75.75 0 0 0 1-.708V4.262a.75.75 0 0 0-.5-.707A9.735 9.735 0 0 0 18 3a9.707 9.707 0 0 0-5.25 1.533v16.103Z" />
          </svg>
        </div>
        <div>
          <span class="font-serif font-bold text-neutral text-base tracking-tight block">
            And God Said
          </span>
          <span class="text-xs text-neutral/50 block">
            Walk together through the Scriptures
          </span>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs sm:text-sm font-medium text-neutral/70">
        <%= link_to t('navigation.about', default: 'About'), about_path, class: "hover:text-primary transition-colors" %>
        <%= link_to t('navigation.faq', default: 'FAQ'), faq_path, class: "hover:text-primary transition-colors" %>
        <%= link_to t('navigation.privacy', default: 'Privacy Policy'), privacy_path, class: "hover:text-primary transition-colors" %>
        <%= link_to t('navigation.terms', default: 'Terms of Service'), terms_path, class: "hover:text-primary transition-colors" %>
        <%= link_to t('navigation.contact', default: 'Contact'), contact_path, class: "hover:text-primary transition-colors" %>
        <%= link_to t('navigation.send_feedback', default: 'Feedback'), new_feedback_path, class: "hover:text-primary transition-colors" %>
      </nav>
    </div>

    <!-- Divider & Bottom Info -->
    <div class="border-t border-base-300/50 pt-4 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral/45 gap-2 text-center sm:text-left">
      <p>&copy; <%= Time.current.year %> And God Said. All rights reserved.</p>
      <p>Daily Bible Reading & Community</p>
    </div>
  </div>
</footer>
