<div class="min-h-[75vh] flex items-center justify-center px-4 py-8">
  <div class="w-full max-w-md bg-base-100 border border-base-200 shadow-xl rounded-3xl p-6 sm:p-8 space-y-6 text-center animate-fade-in relative overflow-hidden">
    
    <!-- Decorative Ambient Glow -->
    <div class="absolute -top-12 -right-12 w-32 h-32 bg-secondary/15 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute -bottom-12 -left-12 w-32 h-32 bg-primary/15 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

    <!-- Badge Header -->
    <div class="flex justify-center">
      <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-secondary bg-secondary/10 px-3.5 py-1.5 rounded-full border border-secondary/20">
        👥 Group Invitation
      </span>
    </div>

    <!-- Title & Challenge Info -->
    <div class="space-y-1.5">
      <h1 class="text-2xl sm:text-3xl font-bold font-serif text-neutral leading-tight">
        <%= @group.name %>
      </h1>
      <p class="text-xs sm:text-sm text-neutral/60 font-medium">
        Reading Group in <span class="text-primary font-semibold"><%= @challenge.name %></span>
      </p>
    </div>

    <!-- Schedule & Overview Stats -->
    <div class="grid grid-cols-2 gap-2.5 text-left">
      <div class="bg-base-200/60 p-3 rounded-2xl border border-base-200 flex flex-col justify-center">
        <span class="text-[11px] uppercase tracking-wider text-neutral/50 font-semibold">Group Size</span>
        <span class="text-sm font-bold text-neutral">
          <%= @member_count %> <%= "member".pluralize(@member_count) %>
        </span>
      </div>

      <div class="bg-base-200/60 p-3 rounded-2xl border border-base-200 flex flex-col justify-center">
        <span class="text-[11px] uppercase tracking-wider text-neutral/50 font-semibold">Reading Pace</span>
        <span class="text-sm font-bold text-neutral">
          <%= @challenge.chapters_per_day %> ch/day
        </span>
      </div>

      <div class="bg-base-200/60 p-3 rounded-2xl border border-base-200 flex flex-col justify-center">
        <span class="text-[11px] uppercase tracking-wider text-neutral/50 font-semibold">Start Date</span>
        <span class="text-sm font-bold text-neutral">
          <%= @challenge.start_date.strftime("%b %-d, %Y") %>
        </span>
      </div>

      <div class="bg-base-200/60 p-3 rounded-2xl border border-base-200 flex flex-col justify-center">
        <span class="text-[11px] uppercase tracking-wider text-neutral/50 font-semibold">End Date</span>
        <span class="text-sm font-bold text-neutral">
          <%= @challenge.end_date.strftime("%b %-d, %Y") %>
        </span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="space-y-3 pt-2">
      <% if @is_enrolled_in_group %>
        <div class="text-xs font-semibold text-success bg-success/15 py-2 px-3 rounded-xl">
          ✓ You are already a member of this group!
        </div>
        <%= link_to group_path(@group), class: "btn btn-primary w-full rounded-full shadow-md text-sm font-semibold" do %>
          Go to Group &rarr;
        <% end %>
      <% elsif logged_in? %>
        <%= button_to accept_group_invitation_path(@group.token), method: :post, class: "btn btn-primary w-full rounded-full shadow-lg hover:shadow-xl transition-all text-sm font-semibold" do %>
          Accept &amp; Join <%= @group.name %>
        <% end %>
      <% else %>
        <%= link_to new_user_session_path, class: "btn btn-primary w-full rounded-full shadow-lg hover:shadow-xl transition-all text-sm font-semibold" do %>
          Sign In to Accept &amp; Join
        <% end %>
        <p class="text-[11px] text-neutral/50">
          Don't have an account? <%= link_to "Sign up here", new_user_registration_path, class: "text-primary underline font-medium" %>
        </p>
      <% end %>

      <div>
        <%= link_to "View Challenge Overview", challenge_path(@challenge), class: "text-xs text-neutral/50 hover:text-primary transition-colors underline" %>
      </div>
    </div>

  </div>
</div>
