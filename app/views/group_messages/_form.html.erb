<%= turbo_frame_tag "new-message-form" do %>
  <%= form_with model: [group, message], 
                url: group_group_messages_path(group),
                method: :post,
                local: false,
                data: { turbo_frame: "chat-messages" },
                class: "flex gap-2" do |form| %>
    <%= form.text_area :content, 
                      placeholder: "Type your message...",
                      rows: 2,
                      class: "textarea textarea-bordered flex-1 resize-none",
                      required: true %>
    <%= form.submit "Send", 
                   class: "btn btn-primary btn-sm self-end" %>
  <% end %>
<% end %>