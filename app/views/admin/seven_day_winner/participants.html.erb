<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold"><%= t('admin.seven_day_winner.participants_title') %></h1>
    <%= link_to t('common.back'), admin_seven_day_winner_path, class: "btn btn-outline" %>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title mb-4"><%= @challenge.title %></h2>
      <p class="text-sm text-base-content/70 mb-6">
        <%= t('admin.seven_day_winner.participants_description') %>
      </p>

      <% if @participants_data.any? %>
        <%= form_with url: admin_seven_day_winner_draw_path, method: :get, data: { controller: "participant-selection" } do |f| %>
          <%= hidden_field_tag :challenge_id, @challenge.id %>

          <!-- Select All / Select None buttons -->
          <div class="flex gap-2 mb-4">
            <button type="button"
                    data-action="click->participant-selection#selectAll"
                    class="btn btn-sm btn-outline">
              <%= t('admin.seven_day_winner.select_all') %>
            </button>
            <button type="button"
                    data-action="click->participant-selection#selectNone"
                    class="btn btn-sm btn-outline">
              <%= t('admin.seven_day_winner.select_none') %>
            </button>
          </div>

          <!-- Participant list -->
          <div class="space-y-2 mb-6">
            <% @participants_data.each do |data| %>
              <label class="flex items-center justify-between p-3 bg-base-200 rounded-lg hover:bg-base-300 cursor-pointer transition">
                <div class="flex items-center gap-3 flex-grow min-w-0">
                  <input type="checkbox"
                         name="user_ids[]"
                         value="<%= data[:user].id %>"
                         class="checkbox checkbox-primary"
                         data-participant-selection-target="checkbox">
                  <div class="flex items-center gap-3 flex-grow min-w-0">
                    <%= avatar_image_tag(data[:user], :tiny, class: "flex-shrink-0") %>
                    <span class="font-medium truncate"><%= data[:user].name %></span>
                  </div>
                </div>
                <div class="flex gap-4 items-center flex-shrink-0 ml-4">
                  <div class="text-center">
                    <div class="radial-progress text-success text-sm"
                         style="--value:<%= data[:completion_percentage] %>; --size:2.5rem; --thickness:2px;">
                      <span class="text-xs font-bold"><%= data[:completion_percentage] %></span>
                    </div>
                    <div class="text-[10px] text-base-content/60 mt-1"><%= t('stats.completion') %></div>
                  </div>
                  <div class="text-center">
                    <div class="radial-progress text-info text-sm"
                         style="--value:<%= data[:on_schedule_percentage] %>; --size:2.5rem; --thickness:2px;">
                      <span class="text-xs font-bold"><%= data[:on_schedule_percentage] %></span>
                    </div>
                    <div class="text-[10px] text-base-content/60 mt-1"><%= t('stats.on_schedule') %></div>
                  </div>
                </div>
              </label>
            <% end %>
          </div>

          <div class="card-actions justify-end">
            <%= f.submit t('admin.seven_day_winner.next'), class: "btn btn-primary" %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-8 text-base-content/70">
          <div class="text-lg mb-2"><%= t('admin.seven_day_winner.no_participants') %></div>
          <div class="text-sm"><%= t('admin.seven_day_winner.no_participants_message') %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
