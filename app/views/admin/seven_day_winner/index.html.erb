<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold"><%= t('admin.seven_day_winner.title') %></h1>
    <%= link_to t('admin.back_to_site'), admin_root_path, class: "btn btn-outline" %>
  </div>

  <div class="card bg-base-100 shadow-xl max-w-2xl mx-auto">
    <div class="card-body">
      <h2 class="card-title mb-4"><%= t('admin.seven_day_winner.select_challenge') %></h2>

      <%= form_with url: admin_seven_day_winner_participants_path, method: :post, class: "space-y-6", data: { turbo: false } do |f| %>
        <div class="form-control w-full">
          <label class="label">
            <span class="label-text"><%= t('admin.seven_day_winner.challenge_label') %></span>
          </label>
          <select name="challenge_id" class="select select-bordered w-full" required>
            <option value="" disabled selected><%= t('admin.seven_day_winner.choose_challenge') %></option>
            <% @challenges.each do |challenge| %>
              <option value="<%= challenge.id %>"><%= challenge.title %></option>
            <% end %>
          </select>
        </div>

        <div class="card-actions justify-end">
          <%= f.submit t('common.submit'), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
