<div class="container mx-auto px-4 py-8">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to "Admin Dashboard", admin_root_path, class: "link link-hover" %></li>
      <li><%= link_to "Manage Challenges", admin_challenges_path, class: "link link-hover" %></li>
      <li><%= link_to @challenge.title, admin_challenge_path(@challenge), class: "link link-hover" %></li>
      <li><%= t("blog.manage_blog") %></li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold"><%= t("blog.admin_blog_title", challenge: @challenge.title) %></h1>
    <div class="space-x-2">
      <%= link_to t("common.back"), admin_challenge_path(@challenge), class: "btn btn-outline" %>
      <%= link_to t("blog.new_post"), new_admin_challenge_blog_post_path(@challenge), class: "btn btn-primary" %>
    </div>
  </div>

  <% if @blog_posts.any? %>
    <div class="space-y-4">
      <% @blog_posts.each do |post| %>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <h2 class="card-title">
                  <%= post.title %>
                  <% unless post.visible %>
                    <span class="badge badge-warning"><%= t("challenges.hidden") %></span>
                  <% end %>
                </h2>
                <p class="text-sm text-gray-500 mt-2">
                  <%= t("blog.posted_by") %> <%= post.author.username %>
                  <%= t("common.ago") %> <%= time_ago_in_words(post.created_at) %>
                </p>
                <div class="mt-4 prose max-w-none">
                  <%= truncate(post.content, length: 200) %>
                </div>
              </div>
              <div class="flex gap-2 ml-4">
                <%= link_to t("common.edit"), edit_admin_challenge_blog_post_path(@challenge, post), class: "btn btn-sm btn-outline" %>
                <%= button_to t("common.delete"), admin_challenge_blog_post_path(@challenge, post), method: :delete,
                    data: { turbo_confirm: t("blog.confirm_delete") },
                    class: "btn btn-sm btn-error btn-outline" %>
              </div>
            </div>
            <div class="text-sm text-gray-500 mt-4">
              <%= pluralize(post.blog_comments.count, t("blog.comments")) %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-gray-500 mb-4"><%= t("blog.no_posts") %></p>
      <%= link_to t("blog.new_post"), new_admin_challenge_blog_post_path(@challenge), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
