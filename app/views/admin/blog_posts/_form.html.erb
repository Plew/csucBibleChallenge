<%= form_with(model: [ :admin, @challenge, @blog_post ], local: true, class: "space-y-6") do |f| %>
  <% if @blog_post.errors.any? %>
    <div class="alert alert-error">
      <div>
        <h3 class="font-bold"><%= t("admin.fix_errors") %></h3>
        <ul class="list-disc list-inside">
          <% @blog_post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="form-control">
    <%= f.label :title, t("blog.post_title"), class: "label" %>
    <%= f.text_field :title, class: "input input-bordered w-full", required: true %>
  </div>

  <div class="form-control">
    <%= f.label :content, t("blog.post_content"), class: "label" %>
    <span class="label-text-alt text-gray-500 mb-2"><%= t("blog.markdown_supported") %></span>
    <%= f.text_area :content, rows: 15, class: "textarea textarea-bordered w-full", required: true %>
  </div>

  <div class="form-control">
    <%= f.label :image, t("blog.post_image"), class: "label" %>
    <span class="label-text-alt text-gray-500 mb-2"><%= t("blog.image_help") %></span>
    <% if @blog_post.image.attached? %>
      <div class="mb-4">
        <%= image_tag @blog_post.image.variant(resize_to_limit: [400, 300]), class: "rounded shadow-md" %>
        <p class="text-sm text-gray-500 mt-2"><%= t("blog.current_image") %></p>
      </div>
    <% end %>
    <%= f.file_field :image, accept: "image/*", class: "file-input file-input-bordered w-full" %>
  </div>

  <div class="form-control">
    <label class="label cursor-pointer justify-start gap-4">
      <%= f.check_box :visible, class: "checkbox" %>
      <span class="label-text">
        <%= t("blog.post_visibility") %>
        <span class="text-sm text-gray-500 block"><%= t("blog.visibility_help") %></span>
      </span>
    </label>
  </div>

  <div class="flex gap-4">
    <%= f.submit t(@blog_post.new_record? ? "blog.create_post" : "blog.update_post"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), admin_challenge_blog_posts_path(@challenge), class: "btn btn-outline" %>
  </div>
<% end %>
