<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-4">
    <div>
      <h1 class="text-3xl font-bold"><%= @sprint.title %></h1>
      <p class="text-gray-600 mt-2">
        <%= @sprint.begin_date.strftime("%B %d, %Y") %> - <%= @sprint.end_date.strftime("%B %d, %Y") %>
        <span class="badge badge-outline ml-2"><%= t("admin.sprints.days_count", count: @sprint.days_count) %></span>
      </p>
    </div>
    <%= link_to t("common.back"), admin_challenge_sprints_path(@challenge), class: "btn btn-outline" %>
  </div>

  <div class="card bg-base-100 shadow mb-6">
    <div class="card-body py-4">
      <div class="flex items-center gap-4">
        <label class="font-semibold text-sm whitespace-nowrap"><%= t("admin.sprints.winner_group") %></label>
        <%= form_with model: [ :admin, @challenge, @sprint ], data: { turbo: false } do |f| %>
          <%= f.select :winner_group_id,
            options_for_select(@challenge.groups.order(:name).map { |g| [ g.name, g.id ] }, @sprint.winner_group_id),
            { include_blank: t("admin.sprints.no_winner_selected") },
            { class: "select select-bordered select-sm", onchange: "this.form.submit()" } %>
        <% end %>
        <% if @sprint.winner_group %>
          <span class="badge badge-success gap-1">🏆 <%= @sprint.winner_group.name %></span>
        <% end %>
      </div>
    </div>
  </div>

  <% if @groups_with_stats.any? %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title mb-4"><%= t("admin.sprints.group_leaderboard") %></h2>
        <div class="overflow-x-auto">
          <table class="table table-zebra w-full">
            <thead>
              <tr>
                <th><%= t("admin.sprints.rank") %></th>
                <th><%= t("admin.sprints.group_name") %></th>
                <th><%= t("admin.sprints.completion_percentage") %></th>
                <th><%= t("admin.sprints.on_time_percentage") %></th>
                <th><%= t("admin.sprints.members") %></th>
              </tr>
            </thead>
            <tbody>
              <% @groups_with_stats.each_with_index do |group_stats, index| %>
                <tr>
                  <td class="font-bold">
                    <% if index == 0 %>
                      <span class="text-yellow-500">🥇</span>
                    <% elsif index == 1 %>
                      <span class="text-gray-400">🥈</span>
                    <% elsif index == 2 %>
                      <span class="text-orange-600">🥉</span>
                    <% else %>
                      <%= index + 1 %>
                    <% end %>
                  </td>
                  <td>
                    <div class="font-semibold"><%= group_stats[:group].name %></div>
                    <div class="text-xs text-gray-500 mt-1">
                      <%= group_stats[:group].users.map(&:name).join(", ") %>
                    </div>
                  </td>
                  <td>
                    <div class="flex items-center gap-2">
                      <div class="w-24 bg-gray-200 rounded-full h-2.5">
                        <div class="bg-blue-600 h-2.5 rounded-full" style="width: <%= group_stats[:completion_percentage] %>%"></div>
                      </div>
                      <span class="text-sm font-medium"><%= group_stats[:completion_percentage] %>%</span>
                    </div>
                  </td>
                  <td>
                    <div class="flex items-center gap-2">
                      <div class="w-24 bg-gray-200 rounded-full h-2.5">
                        <div class="bg-green-600 h-2.5 rounded-full" style="width: <%= group_stats[:on_schedule_percentage] %>%"></div>
                      </div>
                      <span class="text-sm font-medium"><%= group_stats[:on_schedule_percentage] %>%</span>
                    </div>
                  </td>
                  <td>
                    <span class="badge badge-outline"><%= group_stats[:member_count] %></span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <p class="text-gray-500"><%= t("admin.sprints.no_groups") %></p>
      </div>
    </div>
  <% end %>
</div>
