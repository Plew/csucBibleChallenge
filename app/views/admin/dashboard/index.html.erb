<div class="px-2 py-4">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to t('home.title', default: 'Home'), root_path, class: "link link-hover" %></li>
      <li><%= t('admin.dashboard') %></li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= t('admin.dashboard') %></h1>
    <%= link_to t('admin.back_to_site'), root_path, class: "btn btn-sm btn-outline" %>
  </div>

  <div class="grid grid-cols-1 gap-4">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body p-4">
        <h2 class="card-title"><%= t('admin.challenges_card', default: 'Challenges') %></h2>
        <p class="text-3xl font-bold text-primary"><%= @challenges_count %></p>
        <div class="card-actions justify-end">
          <%= link_to t('admin.manage_challenges', default: 'Manage Challenges'), admin_challenges_path, class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body p-4">
        <h2 class="card-title"><%= t('admin.users_card', default: 'Users') %></h2>
        <p class="text-3xl font-bold text-secondary"><%= @users_count %></p>
        <div class="card-actions justify-end">
          <%= link_to t('admin.manage_users', default: 'Manage Users'), admin_users_path, class: "btn btn-secondary btn-sm" %>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body p-4">
        <h2 class="card-title"><%= t('admin.feedbacks_card', default: 'Feedbacks') %></h2>
        <p class="text-3xl font-bold text-accent"><%= @feedbacks_count || Feedback.count %></p>
        <div class="card-actions justify-end">
          <%= link_to t('admin.manage_feedbacks', default: 'Manage Feedbacks'), admin_feedbacks_path, class: "btn btn-accent btn-sm" %>
        </div>
      </div>
    </div>
  </div>
</div>