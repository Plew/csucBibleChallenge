<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold"><%= t("admin.stat_windows.title") %></h1>
    <div class="space-x-2">
      <%= link_to t("common.back"), admin_challenge_path(@challenge), class: "btn btn-outline" %>
      <%= link_to t("admin.stat_windows.new"), new_admin_challenge_stat_window_path(@challenge), class: "btn btn-primary" %>
    </div>
  </div>

  <% if @stat_windows.any? %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="overflow-x-auto">
          <table class="table table-zebra w-full">
            <thead>
              <tr>
                <th><%= t("admin.stat_windows.name") %></th>
                <th><%= t("admin.stat_windows.begin_date") %></th>
                <th><%= t("admin.stat_windows.end_date") %></th>
                <th><%= t("common.actions") %></th>
              </tr>
            </thead>
            <tbody>
              <% @stat_windows.each do |stat_window| %>
                <tr>
                  <td><%= stat_window.title %></td>
                  <td><%= stat_window.begin_date.strftime("%B %d, %Y") %></td>
                  <td><%= stat_window.end_date.strftime("%B %d, %Y") %></td>
                  <td>
                    <div class="flex gap-2">
                      <%= link_to t("common.edit"), edit_admin_challenge_stat_window_path(@challenge, stat_window), class: "btn btn-sm btn-outline" %>
                      <%= button_to t("common.delete"), admin_challenge_stat_window_path(@challenge, stat_window), method: :delete, data: { turbo_confirm: t("common.are_you_sure") }, class: "btn btn-sm btn-error btn-outline" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <p class="text-gray-500"><%= t("admin.stat_windows.no_windows") %></p>
      </div>
    </div>
  <% end %>
</div>
