<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold"><%= @challenge.title %></h1>
    <div class="space-x-2">
      <%= link_to "Back to Challenges", admin_challenges_path, class: "btn btn-outline" %>
      <%= link_to "Edit Challenge", edit_admin_challenge_path(@challenge), class: "btn btn-primary" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Challenge Details</h2>
        
        <div class="space-y-4">
          <div>
            <label class="font-semibold">Title:</label>
            <p><%= @challenge.title %></p>
          </div>
          
          <div>
            <label class="font-semibold">Description:</label>
            <p><%= @challenge.description %></p>
          </div>
          
          <div>
            <label class="font-semibold">Start Date:</label>
            <p><%= @challenge.start_date.strftime("%B %d, %Y") if @challenge.start_date %></p>
          </div>
          
          <div>
            <label class="font-semibold">End Date:</label>
            <p><%= @challenge.end_date.strftime("%B %d, %Y") if @challenge.end_date %></p>
          </div>
          
          <div>
            <label class="font-semibold">Timezone:</label>
            <p><%= @challenge.timezone %></p>
          </div>
          
          <div>
            <label class="font-semibold">Status:</label>
            <% if @challenge.hidden? %>
              <span class="badge badge-warning">Hidden</span>
            <% else %>
              <span class="badge badge-success">Visible</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Statistics</h2>
        
        <div class="space-y-4">
          <div>
            <label class="font-semibold">Total Readings:</label>
            <p><%= @challenge.readings.count %></p>
          </div>
          
          <div>
            <label class="font-semibold">Created:</label>
            <p><%= @challenge.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
          </div>
          
          <div>
            <label class="font-semibold">Creator:</label>
            <p><%= @challenge.creator&.email || "Unknown" %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stat Windows Section -->
  <div class="mt-8">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="flex justify-between items-center mb-4">
          <h2 class="card-title"><%= t("admin.stat_windows.title") %></h2>
          <%= link_to t("admin.stat_windows.new"), new_admin_challenge_stat_window_path(@challenge), class: "btn btn-primary btn-sm" %>
        </div>

        <% if @challenge.stat_windows.any? %>
          <div class="overflow-x-auto">
            <table class="table table-zebra w-full">
              <thead>
                <tr>
                  <th><%= t("admin.stat_windows.name") %></th>
                  <th><%= t("admin.stat_windows.begin_date") %></th>
                  <th><%= t("admin.stat_windows.end_date") %></th>
                  <th><%= t("common.actions") %></th>
                </tr>
              </thead>
              <tbody>
                <% @challenge.stat_windows.ordered.each do |stat_window| %>
                  <tr>
                    <td><%= stat_window.title %></td>
                    <td><%= stat_window.begin_date.strftime("%B %d, %Y") %></td>
                    <td><%= stat_window.end_date.strftime("%B %d, %Y") %></td>
                    <td>
                      <div class="flex gap-2">
                        <%= link_to t("common.edit"), edit_admin_challenge_stat_window_path(@challenge, stat_window), class: "btn btn-sm btn-outline" %>
                        <%= button_to t("common.delete"), admin_challenge_stat_window_path(@challenge, stat_window), method: :delete, data: { turbo_confirm: t("common.are_you_sure") }, class: "btn btn-sm btn-error btn-outline" %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-gray-500"><%= t("admin.stat_windows.no_windows") %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>