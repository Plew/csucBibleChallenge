<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to "Admin Dashboard", admin_root_path, class: "link link-hover" %></li>
      <li><%= link_to "Manage Challenges", admin_challenges_path, class: "link link-hover" %></li>
      <li><%= link_to @challenge.title, admin_challenge_path(@challenge), class: "link link-hover" %></li>
      <li>Edit</li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Edit Challenge</h1>
    <%= link_to "Back to Challenges", admin_challenges_path, class: "btn btn-outline" %>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <%= form_with(model: [:admin, @challenge], local: true, data: { turbo: false }, class: "space-y-6") do |form| %>
        <% if @challenge.errors.any? %>
          <div class="alert alert-error">
            <div>
              <h3 class="font-bold">Please fix the following errors:</h3>
              <ul class="list-disc list-inside">
                <% @challenge.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="form-control">
          <%= form.label :title, class: "label" %>
          <span class="label-text">Title</span>
          <%= form.text_field :title, class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= form.label :description, class: "label" %>
          <span class="label-text">Description (Markdown supported)</span>
          <%= form.text_area :description, class: "textarea textarea-bordered h-24", rows: 4 %>
          <div class="label">
            <span class="label-text-alt text-xs">
              Markdown syntax: **bold**, *italic*, [link](url), ![image](url), - lists
            </span>
          </div>
        </div>

        <div class="form-control">
          <%= form.label :message_of_the_day, class: "label" %>
          <span class="label-text">Message of the Day (shown on stats page)</span>
          <%= form.text_area :message_of_the_day, class: "textarea textarea-bordered h-24", rows: 3, placeholder: "Optional message to display to all challenge members..." %>
          <div class="label">
            <span class="label-text-alt text-xs">
              This message will appear at the top of the stats page for all challenge members
            </span>
          </div>
        </div>

        <div class="form-control">
          <%= form.label :start_date, class: "label" %>
          <span class="label-text">Start Date</span>
          <%= form.date_field :start_date, class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= form.label :timezone, class: "label" %>
          <span class="label-text">Timezone</span>
          <%= form.select :timezone,
                options_for_select(timezone_options_for_select, @challenge.timezone),
                { prompt: 'Select timezone' },
                { class: "select select-bordered w-full" } %>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <%= form.check_box :hidden, class: "checkbox" %>
            <span class="label-text">Hide this challenge from public view</span>
          </label>
        </div>

        <div class="form-control mt-6">
          <%= form.submit "Update Challenge", class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>