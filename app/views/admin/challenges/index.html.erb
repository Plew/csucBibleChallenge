<div class="px-2 py-4">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to t('admin.dashboard'), admin_root_path, class: "link link-hover" %></li>
      <li><%= t('admin.manage_challenges') %></li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= t('admin.manage_challenges') %></h1>
    <div>
      <%= link_to t('admin.challenges.new_challenge'), new_admin_challenge_path, class: "btn btn-primary btn-sm" %>
    </div>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table table-xs table-zebra w-full">
          <thead>
            <tr>
              <th class="px-2 py-2"><%= t('admin.challenges.title_header') %></th>
              <th class="px-2 py-2"><%= t('challenges.description') %></th>
              <th class="px-2 py-2"><%= t('admin.challenges.start_header') %></th>
              <th class="px-2 py-2"><%= t('admin.challenges.end_header') %></th>
              <th class="px-2 py-2"><%= t('admin.challenges.tz_header') %></th>
              <th class="px-2 py-2"><%= t('challenges.status') %></th>
            </tr>
          </thead>
          <tbody>
            <% @challenges.each do |challenge| %>
              <tr class="hover cursor-pointer" onclick="window.location='<%= admin_challenge_path(challenge) %>'">
                <td class="font-semibold px-2 py-1"><%= challenge.title %></td>
                <td class="max-w-xs px-2 py-1">
                  <div class="truncate"><%= challenge.description %></div>
                </td>
                <td class="px-2 py-1 whitespace-nowrap"><%= challenge.start_date.strftime("%m/%d/%y") if challenge.start_date %></td>
                <td class="px-2 py-1 whitespace-nowrap"><%= challenge.end_date.strftime("%m/%d/%y") if challenge.end_date %></td>
                <td class="px-2 py-1 text-xs"><%= challenge.timezone&.split('/')&.last %></td>
                <td class="px-2 py-1">
                  <% if challenge.hidden? %>
                    <span class="badge badge-warning badge-xs"><%= t('challenges.hidden') %></span>
                  <% else %>
                    <span class="badge badge-success badge-xs"><%= t('challenges.visible') %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
