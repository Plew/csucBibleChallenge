<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Manage Challenges</h1>
    <div class="space-x-2">
      <%= link_to t('admin.seven_day_winner.title'), admin_seven_day_winner_draw_path, class: "btn btn-accent" %>
      <%= link_to "Change Challenge", admin_change_challenge_path, class: "btn btn-secondary" %>
      <%= link_to "Admin Dashboard", admin_root_path, class: "btn btn-outline" %>
      <%= link_to "New Challenge", new_admin_challenge_path, class: "btn btn-primary" %>
    </div>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table table-xs table-zebra w-full">
          <thead>
            <tr>
              <th class="px-2 py-2">Title</th>
              <th class="px-2 py-2">Description</th>
              <th class="px-2 py-2">Start</th>
              <th class="px-2 py-2">End</th>
              <th class="px-2 py-2">TZ</th>
              <th class="px-2 py-2">Status</th>
              <th class="px-2 py-2">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @challenges.each do |challenge| %>
              <tr>
                <td class="font-semibold px-2 py-1"><%= challenge.title %></td>
                <td class="max-w-xs px-2 py-1">
                  <div class="truncate"><%= challenge.description %></div>
                </td>
                <td class="px-2 py-1 whitespace-nowrap"><%= challenge.start_date.strftime("%m/%d/%y") if challenge.start_date %></td>
                <td class="px-2 py-1 whitespace-nowrap"><%= challenge.end_date.strftime("%m/%d/%y") if challenge.end_date %></td>
                <td class="px-2 py-1 text-xs"><%= challenge.timezone&.split('/')&.last %></td>
                <td class="px-2 py-1">
                  <% if challenge.hidden? %>
                    <span class="badge badge-warning badge-xs">Hidden</span>
                  <% else %>
                    <span class="badge badge-success badge-xs">Visible</span>
                  <% end %>
                </td>
                <td class="px-2 py-1">
                  <div class="join">
                    <%= link_to "Edit", edit_admin_challenge_path(challenge), class: "btn btn-xs btn-outline join-item" %>
                    <%= link_to "View", admin_challenge_path(challenge), class: "btn btn-xs btn-info join-item" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>