<div class="px-2 py-4">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to t('admin.dashboard'), admin_root_path, class: "link link-hover" %></li>
      <li><%= link_to t('feedback.manage_title'), admin_feedbacks_path, class: "link link-hover" %></li>
      <li><%= t('feedback.feedback_details_title') %></li>
    </ul>
  </div>

  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold"><%= t('feedback.feedback_details_title') %></h1>
    <%= link_to t('common.back'), admin_feedbacks_path, class: "btn btn-ghost btn-sm" %>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body px-3 py-4">
      <div class="flex flex-col gap-3 mb-4">
        <div class="flex items-start justify-between">
          <h2 class="card-title text-lg"><%= @feedback.subject %></h2>
          <div class="badge badge-outline"><%= @feedback.category_display %></div>
        </div>
        <div class="text-sm text-base-content/70">
          <%= t('feedback.submitted') %> <%= @feedback.created_at.strftime("%B %d, %Y at %I:%M %p") %>
        </div>
        <%= link_to t('feedback.delete_feedback'), admin_feedback_path(@feedback),
            data: {
              turbo_method: :delete,
              turbo_confirm: t('feedback.delete_confirmation')
            },
            class: "btn btn-error btn-sm w-full" %>
      </div>

      <div class="space-y-4">
        <div>
          <label class="label font-semibold"><%= t('feedback.message') %></label>
          <div class="bg-base-200 p-3 rounded-lg">
            <p class="whitespace-pre-wrap"><%= @feedback.message %></p>
          </div>
        </div>

        <% if @feedback.screenshot.present? %>
          <div>
            <label class="label font-semibold"><%= t('feedback.screenshot') %>:</label>
            <div class="bg-base-200 p-3 rounded-lg">
              <%= image_tag @feedback.screenshot.variant(:medium),
                  class: "max-w-full h-auto rounded-lg shadow-sm border cursor-pointer",
                  alt: t('feedback.screenshot_modal'),
                  onclick: "document.getElementById('screenshot_modal').showModal()" %>

              <dialog id="screenshot_modal" class="modal">
                <div class="modal-box max-w-4xl">
                  <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
                  </form>
                  <h3 class="font-bold text-lg mb-4"><%= t('feedback.screenshot_modal') %></h3>
                  <%= image_tag @feedback.screenshot,
                      class: "w-full h-auto",
                      alt: t('feedback.screenshot_modal') %>
                </div>
                <form method="dialog" class="modal-backdrop">
                  <button><%= t('common.close') %></button>
                </form>
              </dialog>
            </div>
          </div>
        <% end %>

        <div class="card bg-base-200">
          <div class="card-body px-3 py-4">
            <h3 class="font-semibold mb-3"><%= t('feedback.submission_info') %></h3>

            <div class="space-y-3">
              <div>
                <label class="text-sm font-medium text-base-content/70"><%= t('feedback.from_label') %></label>
                <div class="flex items-center gap-2 mt-1">
                  <% if @feedback.user&.avatar&.attached? %>
                    <%= image_tag @feedback.user.avatar.variant(:thumb),
                        class: "w-8 h-8 rounded-full",
                        alt: @feedback.author_name %>
                  <% else %>
                    <div class="w-8 h-8 rounded-full bg-base-300 flex items-center justify-center">
                      <span class="text-sm font-medium"><%= @feedback.author_name.first %></span>
                    </div>
                  <% end %>
                  <span><%= @feedback.author_name %></span>
                </div>
              </div>

              <div>
                <label class="text-sm font-medium text-base-content/70"><%= t('feedback.category_label') %></label>
                <div class="badge badge-outline mt-1"><%= @feedback.category_display %></div>
              </div>

              <div>
                <label class="text-sm font-medium text-base-content/70"><%= t('feedback.submitted_label') %></label>
                <p class="text-sm mt-1"><%= @feedback.created_at.strftime("%B %d, %Y") %></p>
                <p class="text-xs text-base-content/60"><%= @feedback.created_at.strftime("at %I:%M %p") %></p>
              </div>

              <% if @feedback.user.present? %>
                <div>
                  <label class="text-sm font-medium text-base-content/70"><%= t('feedback.user_email_label') %></label>
                  <p class="text-sm mt-1 break-all"><%= @feedback.user.email %></p>
                </div>
              <% end %>

              <div>
                <label class="text-sm font-medium text-base-content/70"><%= t('feedback.has_screenshot') %></label>
                <div class="mt-1">
                  <% if @feedback.screenshot.present? %>
                    <div class="badge badge-success badge-sm"><%= t('common.yes') %></div>
                  <% else %>
                    <div class="badge badge-ghost badge-sm"><%= t('common.no') %></div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
