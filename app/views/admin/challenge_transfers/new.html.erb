<div class="px-2 py-4">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to t('admin.dashboard'), admin_root_path, class: "link link-hover" %></li>
      <li><%= t('admin.challenge_transfers.breadcrumb') %></li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= t('admin.challenge_transfers.title') %></h1>
    <%= link_to t('admin.dashboard'), admin_root_path, class: "btn btn-sm btn-outline" %>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body p-4">
      <h2 class="card-title text-lg mb-4"><%= t('admin.challenge_transfers.description') %></h2>

      <div class="alert alert-warning mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
        <span><%= t('admin.challenge_transfers.warning') %></span>
      </div>

      <%= form_with url: admin_change_challenge_path, method: :post, class: "space-y-4" do |f| %>
        <div class="form-control">
          <label class="label">
            <span class="label-text font-semibold"><%= t('admin.challenge_transfers.from_challenge') %></span>
          </label>
          <select name="from_challenge_id" class="select select-bordered w-full" required>
            <option value=""><%= t('admin.challenge_transfers.from_placeholder') %></option>
            <% @challenges.each do |challenge| %>
              <option value="<%= challenge.id %>">
                <%= challenge.title %> (<%= challenge.user_challenge_enrollments.count %> users)
              </option>
            <% end %>
          </select>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text font-semibold"><%= t('admin.challenge_transfers.to_challenge') %></span>
          </label>
          <select name="to_challenge_id" class="select select-bordered w-full" required>
            <option value=""><%= t('admin.challenge_transfers.to_placeholder') %></option>
            <% @challenges.each do |challenge| %>
              <option value="<%= challenge.id %>">
                <%= challenge.title %> (<%= challenge.user_challenge_enrollments.count %> users)
              </option>
            <% end %>
          </select>
        </div>

        <div class="form-control mt-4">
          <button type="submit" class="btn btn-primary">
            <%= t('admin.challenge_transfers.transfer_button') %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
