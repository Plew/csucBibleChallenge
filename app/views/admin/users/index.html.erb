<div class="container mx-auto px-2 py-4">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to "Admin Dashboard", admin_root_path, class: "link link-hover" %></li>
      <li>Manage Users</li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold">Manage Users</h1>
    <div class="flex gap-2">
      <%= link_to t('admin.export_csv'), admin_users_path(format: :csv, search: params[:search], challenge_id: params[:challenge_id]), class: "btn btn-sm btn-success" %>
      <%= link_to "Admin Dashboard", admin_root_path, class: "btn btn-sm btn-outline" %>
    </div>
  </div>

  <div class="card bg-base-100 shadow-xl mb-4">
    <div class="card-body p-4">
      <%= form_with url: admin_users_path, method: :get, local: true, class: "flex flex-col gap-3" do |form| %>
        <div class="flex gap-2">
          <div class="form-control flex-1">
            <%= form.text_field :search,
                  value: params[:search],
                  placeholder: t('admin.search_placeholder'),
                  class: "input input-bordered input-sm w-full" %>
          </div>
          <div class="form-control flex-1">
            <%= form.select :challenge_id,
                  options_for_select([['All Challenges', '']] + @challenges.map { |c| [c.name, c.id] }, params[:challenge_id]),
                  {},
                  { class: "select select-bordered select-sm w-full", onchange: "this.form.submit()" } %>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= form.submit t('admin.search_users'), class: "btn btn-sm btn-primary" %>
          <%= link_to t('common.clear'), admin_users_path, class: "btn btn-sm btn-outline" %>
          <div class="divider divider-horizontal mx-0"></div>
          <%= link_to t('admin.users.no_activity_7_days'),
                admin_users_path(inactive_days: 7, search: params[:search], challenge_id: params[:challenge_id]),
                class: "btn btn-sm #{params[:inactive_days] == '7' ? 'btn-warning' : 'btn-outline btn-warning'}" %>
          <%= link_to t('admin.users.no_activity_10_days'),
                admin_users_path(inactive_days: 10, search: params[:search], challenge_id: params[:challenge_id]),
                class: "btn btn-sm #{params[:inactive_days] == '10' ? 'btn-error' : 'btn-outline btn-error'}" %>
        </div>
      <% end %>
    </div>
  </div>

  <%= form_with url: remove_from_groups_admin_users_path, method: :post, local: true, data: { controller: "admin-users" } do |form| %>
    <div class="flex justify-between items-center mb-2">
      <p class="text-sm text-base-content/60"><%= @users.count %> users</p>
      <button type="submit" class="btn btn-sm btn-error" data-admin-users-target="removeBtn" style="display:none;"
              data-action="click->admin-users#confirmRemove">
        <%= t('admin.users.remove_checked_from_group') %>
      </button>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body p-2">
        <div class="overflow-x-auto">
          <table class="table table-zebra table-sm w-full">
            <thead>
              <tr>
                <th class="w-8">
                  <input type="checkbox" class="checkbox checkbox-sm" data-action="change->admin-users#toggleAll" data-admin-users-target="selectAll" />
                </th>
                <th>Username</th>
                <th><%= t('admin.users.last_15_days') %></th>
                <th>Challenge</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @users.each do |user| %>
                <tr>
                  <td>
                    <input type="checkbox" name="user_ids[]" value="<%= user.id %>" class="checkbox checkbox-sm" data-action="change->admin-users#toggleOne" data-admin-users-target="userCheckbox" />
                  </td>
                  <td class="font-semibold text-sm"><%= user.username %></td>
                  <td>
                    <div class="flex gap-px items-center" title="<%= t('admin.users.last_15_days') %>">
                      <% last_15_days_activity(user).each_with_index do |active, i| %>
                        <div class="w-2.5 h-2.5 rounded-sm <%= active ? 'bg-success' : 'bg-base-300' %>"
                             title="<%= (Date.current - (14 - i).days).strftime('%b %d') %>"></div>
                      <% end %>
                    </div>
                  </td>
                  <td>
                    <% if user.challenges.any? %>
                      <% user.challenges.each do |challenge| %>
                        <div class="badge badge-primary badge-xs"><%= challenge.name %></div>
                      <% end %>
                    <% else %>
                      <span class="text-gray-400 text-xs">None</span>
                    <% end %>
                  </td>
                  <td>
                    <div class="join">
                      <%= link_to t('common.view'), admin_user_path(user), class: "btn btn-xs btn-info join-item" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>
