<div class="container mx-auto px-4 py-8">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to "Admin Dashboard", admin_root_path, class: "link link-hover" %></li>
      <li>Manage Users</li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Manage Users</h1>
    <div class="flex gap-2">
      <%= link_to t('admin.export_csv'), admin_users_path(format: :csv, search: params[:search], challenge_id: params[:challenge_id]), class: "btn btn-success" %>
      <%= link_to "Admin Dashboard", admin_root_path, class: "btn btn-outline" %>
    </div>
  </div>

  <div class="card bg-base-100 shadow-xl mb-6">
    <div class="card-body">
      <%= form_with url: admin_users_path, method: :get, local: true, class: "flex flex-col gap-4" do |form| %>
        <div class="flex gap-4">
          <div class="form-control flex-1">
            <%= form.text_field :search,
                  value: params[:search],
                  placeholder: "Search by email or user ID...",
                  class: "input input-bordered w-full" %>
          </div>
          <div class="form-control flex-1">
            <%= form.select :challenge_id,
                  options_for_select([['All Challenges', '']] + @challenges.map { |c| [c.name, c.id] }, params[:challenge_id]),
                  {},
                  { class: "select select-bordered w-full", onchange: "this.form.submit()" } %>
          </div>
        </div>
        <div class="flex gap-2">
          <%= form.submit "Search", class: "btn btn-primary" %>
          <%= link_to "Clear", admin_users_path, class: "btn btn-outline" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <div class="overflow-x-auto">
        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th>ID</th>
              <th>Username</th>
              <th>Email</th>
              <th>Challenge</th>
              <th>Admin</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td><%= user.id %></td>
                <td class="font-semibold"><%= user.username %></td>
                <td><%= user.email %></td>
                <td>
                  <% if user.challenges.any? %>
                    <% user.challenges.each do |challenge| %>
                      <div class="badge badge-primary badge-sm mb-1"><%= challenge.name %></div>
                    <% end %>
                  <% else %>
                    <span class="text-gray-400">None</span>
                  <% end %>
                </td>
                <td>
                  <% if user.admin? %>
                    <span class="badge badge-error">Admin</span>
                  <% else %>
                    <span class="badge badge-ghost">User</span>
                  <% end %>
                </td>
                <td><%= user.created_at.strftime("%b %d, %Y") %></td>
                <td>
                  <div class="join">
                    <%= link_to "View", admin_user_path(user), class: "btn btn-sm btn-info join-item" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>