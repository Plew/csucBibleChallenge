<div class="px-2 py-4">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to t('admin.dashboard'), admin_root_path, class: "link link-hover" %></li>
      <li><%= link_to t('admin.manage_users'), admin_users_path, class: "link link-hover" %></li>
      <li><%= link_to @user.username, admin_user_path(@user), class: "link link-hover" %></li>
      <li><%= t("admin.users.reading_history") %></li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= t("admin.users.reading_history") %></h1>
    <%= link_to t('common.back'), admin_user_path(@user), class: "btn btn-sm btn-outline" %>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body p-4">
      <h2 class="card-title text-lg mb-2"><%= @user.username %> - <%= t("admin.users.reading_history") %> (<%= @user_readings.count %>)</h2>

      <% if @user_readings.any? %>
        <div class="overflow-x-auto">
          <table class="table table-xs">
            <thead>
              <tr>
                <th><%= t("admin.users.reading") %></th>
                <th><%= t("admin.users.challenge") %></th>
                <th><%= t("admin.users.scheduled_date") %></th>
                <th><%= t("admin.users.completed_at") %></th>
              </tr>
            </thead>
            <tbody>
              <% @user_readings.each do |user_reading| %>
                <% reading = user_reading.reading %>
                <% challenge = reading.challenge %>
                <% completed_time = user_reading.created_at.in_time_zone(challenge.timezone) %>
                <tr>
                  <td class="font-medium">
                    <%= book_number_to_name(reading.book_number) %> <%= reading.chapter_number %>
                  </td>
                  <td>
                    <span class="badge badge-primary badge-xs"><%= challenge.name %></span>
                  </td>
                  <td>
                    <%= reading.scheduled_date.strftime("%b %d, %Y") %>
                  </td>
                  <td>
                    <%= completed_time.strftime("%b %d, %Y") %><br>
                    <span class="text-xs text-base-content/60"><%= completed_time.strftime("%I:%M %p %Z") %></span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-base-content/40 text-sm"><%= t("admin.users.no_readings") %></p>
      <% end %>
    </div>
  </div>
</div>
