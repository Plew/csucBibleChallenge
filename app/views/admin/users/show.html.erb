<div class="px-2 py-4">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to t('admin.dashboard'), admin_root_path, class: "link link-hover" %></li>
      <li><%= link_to t('admin.manage_users'), admin_users_path, class: "link link-hover" %></li>
      <li><%= @user.username %></li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= @user.username %></h1>
    <%= link_to t('common.back'), admin_users_path, class: "btn btn-sm btn-outline" %>
  </div>

  <div class="card bg-base-100 shadow-xl mb-4">
    <div class="card-body p-4">
      <h2 class="card-title text-lg"><%= t('admin.user_information') %></h2>

      <div class="space-y-2 text-sm">
        <div class="flex gap-2">
          <label class="font-semibold"><%= t('admin.user_id') %>:</label>
          <p><%= @user.id %></p>
        </div>

        <div class="flex gap-2">
          <label class="font-semibold"><%= t('admin.users.username_header') %>:</label>
          <p><%= @user.username %></p>
        </div>

        <div class="flex gap-2">
          <label class="font-semibold"><%= t('admin.user_email') %>:</label>
          <p><%= @user.email %></p>
        </div>

        <div class="flex gap-2">
          <label class="font-semibold"><%= t('admin.admin_status_label') %></label>
          <% if @user.admin? %>
            <span class="badge badge-error badge-sm"><%= t('admin.admin_status') %></span>
          <% else %>
            <span class="badge badge-ghost badge-sm"><%= t('admin.user_role') %></span>
          <% end %>
        </div>

        <div class="flex gap-2">
          <label class="font-semibold"><%= t('admin.users.user_created') %></label>
          <p><%= @user.created_at.strftime("%b %d, %Y at %I:%M %p") %></p>
        </div>

        <div class="flex gap-2">
          <label class="font-semibold"><%= t('admin.users.user_challenges') %></label>
          <div>
            <% if @user.challenges.any? %>
              <% @user.challenges.each do |challenge| %>
                <div class="badge badge-primary badge-sm"><%= challenge.name %></div>
              <% end %>
            <% else %>
              <span class="text-gray-400"><%= t('admin.users.none') %></span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex gap-2 items-center mt-2">
        <label class="font-semibold text-sm"><%= t('admin.users.challenge_creator') %></label>
        <% if @user.admin? %>
          <span class="badge badge-success badge-sm"><%= t("admin.users.challenge_creator_via_admin") %></span>
        <% elsif @user.can_create_challenges %>
          <span class="badge badge-success badge-sm"><%= t("common.yes") %></span>
          <%= button_to t("admin.users.revoke_challenge_creator"), toggle_challenge_creator_admin_user_path(@user), method: :patch, class: "btn btn-xs btn-outline btn-error" %>
        <% else %>
          <span class="badge badge-ghost badge-sm"><%= t("common.no") %></span>
          <%= button_to t("admin.users.grant_challenge_creator"), toggle_challenge_creator_admin_user_path(@user), method: :patch, class: "btn btn-xs btn-outline btn-success" %>
        <% end %>
      </div>

      <div class="card-actions mt-4">
        <%= link_to t("admin.users.reading_history"), reading_history_admin_user_path(@user), class: "btn btn-sm btn-primary" %>
        <%= link_to t("admin.users.change_password"), change_password_admin_user_path(@user), class: "btn btn-sm btn-secondary" %>
      </div>
    </div>
  </div>

  <% if @challenge_enrollments.any? %>
    <div class="card bg-base-100 shadow-xl mb-4">
      <div class="card-body p-4">
        <h2 class="card-title text-lg mb-3"><%= t('admin.users.reading_progress') %></h2>

        <div class="space-y-4">
          <% @challenge_enrollments.each do |enrollment| %>
            <% challenge = enrollment.challenge %>
            <div class="border-b border-base-300 last:border-b-0 pb-4 last:pb-0">
              <h3 class="font-semibold text-sm mb-2"><%= challenge.name %></h3>
              <div class="text-xs text-base-content/60 mb-2">
                <%= challenge.start_date.strftime("%b %d, %Y") %> - <%= challenge.end_date.strftime("%b %d, %Y") %>
                (<%= challenge.timezone %>)
              </div>
              <%= render ReadingHistoryGraphComponent.new(
                total_days: challenge.readings.count,
                completed_days: completed_days_for_user_challenge(@user, challenge),
                start_date: challenge.start_date,
                current_day: current_day_number_for_challenge(challenge)
              ) %>
              <div class="text-xs text-base-content/60 mt-2">
                <%= t('admin.users.days_completed',
                      completed: completed_days_for_user_challenge(@user, challenge).count,
                      total: challenge.readings.count) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
