<div class="container mx-auto px-2 py-4">
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= @user.username %></h1>
    <%= link_to "Back", admin_users_path, class: "btn btn-sm btn-outline" %>
  </div>

  <div class="card bg-base-100 shadow-xl mb-4">
    <div class="card-body p-4">
      <h2 class="card-title text-lg">User Information</h2>

      <div class="space-y-2 text-sm">
        <div class="flex gap-2">
          <label class="font-semibold">ID:</label>
          <p><%= @user.id %></p>
        </div>

        <div class="flex gap-2">
          <label class="font-semibold">Username:</label>
          <p><%= @user.username %></p>
        </div>

        <div class="flex gap-2">
          <label class="font-semibold">Email:</label>
          <p><%= @user.email %></p>
        </div>

        <div class="flex gap-2">
          <label class="font-semibold">Admin:</label>
          <% if @user.admin? %>
            <span class="badge badge-error badge-sm">Admin</span>
          <% else %>
            <span class="badge badge-ghost badge-sm">User</span>
          <% end %>
        </div>

        <div class="flex gap-2">
          <label class="font-semibold">Created:</label>
          <p><%= @user.created_at.strftime("%b %d, %Y at %I:%M %p") %></p>
        </div>

        <div class="flex gap-2">
          <label class="font-semibold">Challenges:</label>
          <div>
            <% if @user.challenges.any? %>
              <% @user.challenges.each do |challenge| %>
                <div class="badge badge-primary badge-sm"><%= challenge.name %></div>
              <% end %>
            <% else %>
              <span class="text-gray-400">None</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if @challenge_enrollments.any? %>
    <div class="card bg-base-100 shadow-xl mb-4">
      <div class="card-body p-4">
        <h2 class="card-title text-lg mb-3">Reading Progress</h2>

        <div class="space-y-4">
          <% @challenge_enrollments.each do |enrollment| %>
            <% challenge = enrollment.challenge %>
            <div class="border-b border-base-300 last:border-b-0 pb-4 last:pb-0">
              <h3 class="font-semibold text-sm mb-2"><%= challenge.name %></h3>
              <div class="text-xs text-base-content/60 mb-2">
                <%= challenge.start_date.strftime("%b %d, %Y") %> - <%= challenge.end_date.strftime("%b %d, %Y") %>
                (<%= challenge.timezone %>)
              </div>
              <%= render ReadingHistoryGraphComponent.new(
                total_days: challenge.readings.count,
                completed_days: completed_days_for_user_challenge(@user, challenge),
                start_date: challenge.start_date,
                current_day: current_day_number_for_challenge(challenge)
              ) %>
              <div class="text-xs text-base-content/60 mt-2">
                <%= completed_days_for_user_challenge(@user, challenge).count %> / <%= challenge.readings.count %> days completed
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-xl mb-4">
    <div class="card-body p-4">
      <h2 class="card-title text-lg">Change Password</h2>
      <%= form_with url: update_password_admin_user_path(@user), method: :patch, local: true do |form| %>
        <div class="form-control">
          <%= form.label :new_password, "New Password", class: "label" %>
          <%= form.password_field :new_password, class: "input input-bordered", required: true %>
        </div>
        <div class="form-control mt-4">
          <%= form.submit "Update Password", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body p-4">
      <h2 class="card-title text-lg mb-2">Reading History (<%= @user_readings.count %>)</h2>

      <% if @user_readings.any? %>
        <div class="overflow-x-auto">
          <table class="table table-xs">
            <thead>
              <tr>
                <th>Reading</th>
                <th>Challenge</th>
                <th>Completed</th>
              </tr>
            </thead>
            <tbody>
              <% @user_readings.each do |user_reading| %>
                <% reading = user_reading.reading %>
                <% challenge = reading.challenge %>
                <% completed_time = user_reading.completed_on.in_time_zone(challenge.timezone) %>
                <tr>
                  <td class="font-medium">
                    <%= book_number_to_name(reading.book_number) %> <%= reading.chapter_number %>
                  </td>
                  <td>
                    <span class="badge badge-primary badge-xs"><%= challenge.name %></span>
                  </td>
                  <td>
                    <%= completed_time.strftime("%b %d, %Y") %><br>
                    <span class="text-xs text-gray-500"><%= completed_time.strftime("%I:%M %p %Z") %></span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-gray-400 text-sm">No readings completed yet.</p>
      <% end %>
    </div>
  </div>
</div>