<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8">
  <div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-4 mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold">Feedback Submitted</h1>
      <div class="badge badge-success badge-lg">Success</div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="flex items-start justify-between mb-4">
          <h2 class="card-title"><%= @feedback.subject %></h2>
          <div class="badge badge-outline"><%= @feedback.category_display %></div>
        </div>

        <div class="space-y-4">
          <div>
            <label class="label font-semibold">From:</label>
            <p class="text-base-content/80"><%= @feedback.author_name %></p>
          </div>

          <div>
            <label class="label font-semibold">Submitted:</label>
            <p class="text-base-content/80"><%= @feedback.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
          </div>

          <div>
            <label class="label font-semibold">Message:</label>
            <div class="bg-base-200 p-4 rounded-lg">
              <p class="whitespace-pre-wrap"><%= @feedback.message %></p>
            </div>
          </div>

          <% if @feedback.screenshot.present? %>
            <div>
              <label class="label font-semibold">Screenshot:</label>
              <div class="bg-base-200 p-4 rounded-lg">
                <%= image_tag @feedback.screenshot.variant(:medium), 
                    class: "max-w-full h-auto rounded-lg shadow-sm",
                    alt: "Feedback screenshot" %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="card-actions justify-between mt-6">
          <p class="text-sm text-base-content/60">
            We'll review your feedback and get back to you if needed. Thank you for helping us improve!
          </p>
          <%= link_to "Submit Another", new_feedback_path, class: "btn btn-outline" %>
          <%= link_to "Back to Home", root_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </div>
</div>