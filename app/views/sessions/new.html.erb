<div class="min-h-screen flex items-center justify-center bg-base-200 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-base-content">
        Log In to ReVerse
      </h2>
    </div>
    <%= form_with(url: user_session_path, scope: :session, local: true, html: { class: "mt-8 space-y-6" }) do |f| %>
      <div class="rounded-md shadow-sm -space-y-px">
        <div>
          <%= f.label :email, "Email or Username", class: "label" %>
          <%= f.text_field :email, class: "input input-bordered w-full", placeholder: "Email or Username", required: true %>
        </div>
        <div class="pt-2">
          <%= f.label :password, class: "label" %>
          <%= f.password_field :password, class: "input input-bordered w-full", placeholder: "Password", required: true %>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "checkbox checkbox-primary" %>
          <%= f.label :remember_me, "Remember me", class: "ml-2 block text-sm text-base-content" %>
        </div>

        <div class="text-sm">
          <a href="#" class="font-medium text-primary hover:text-primary-focus"> <%# Placeholder %>
            Forgot your password?
          </a>
        </div>
      </div>

      <div>
        <%= f.submit "Log In", class: "btn btn-primary w-full" %>
      </div>
    <% end %>

    <div class="text-sm text-center">
      <%= link_to "Don't have an account? Sign Up", new_user_registration_path %>
    </div>
  </div>
</div> 