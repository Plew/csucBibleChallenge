<div class="min-h-screen flex justify-center bg-base-200 pt-6 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-2 text-center text-3xl font-extrabold text-base-content">
        Log in.
      </h2>
    </div>
    <%= form_with(url: user_session_path, scope: :session, local: true, html: { class: "mt-8 space-y-6" }) do |f| %>
      <div class="rounded-md shadow-sm -space-y-px">
        <div>
          <%= f.label :email, "Email", class: "label" %>
          <%= f.text_field :email, value: @email, class: "input input-bordered w-full", placeholder: "Email", required: true %>
        </div>
        <div class="pt-2" x-data="{ showPassword: false }" x-init="showPassword = false">
          <%= f.label :password, class: "label" %>
          <div class="relative">
            <input 
              type="password"
              :type="showPassword ? 'text' : 'password'" 
              name="session[password]" 
              id="session_password" 
              class="input input-bordered w-full pr-10" 
              placeholder="Password" 
              required
            >
            <button type="button" @click="showPassword = !showPassword" class="absolute inset-y-0 right-0 flex items-center pr-3 text-base-content/40 hover:text-base-content transition-colors duration-200">
              <!-- Simple eye icon that gets brighter on hover -->
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "checkbox checkbox-primary" %>
          <%= f.label :remember_me, "Remember me", class: "ml-2 block text-sm text-base-content" %>
        </div>

        <div class="text-sm">
          <%= link_to "Forgot your password?", new_password_reset_path, class: "font-medium text-primary hover:text-primary-focus" %>
        </div>
      </div>

      <div>
        <%= f.submit "Log In", class: "btn btn-primary w-full" %>
      </div>
    <% end %>

    <div class="text-sm text-center">
      <%= link_to "Don't have an account? Sign Up", new_user_registration_path %>
    </div>
  </div>
</div> 