<div class="w-full py-10 md:py-16 flex justify-center items-center px-4">
  <div class="bg-base-200 border border-base-300 rounded-3xl p-6 sm:p-8 md:p-10 shadow-sm max-w-md w-full space-y-6">
    
    <!-- Top Gold Bible Badge & Title -->
    <div class="text-center space-y-2">
      <div class="mx-auto w-12 h-12 rounded-2xl bg-secondary/15 border border-secondary/20 flex items-center justify-center text-secondary shadow-xs">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M11.25 4.533A9.707 9.707 0 0 0 6 3a9.735 9.735 0 0 0-3.25.555.75.75 0 0 0-.5.707v14.25a.75.75 0 0 0 1 .707A8.237 8.237 0 0 1 6 18.75c1.995 0 3.823.707 5.25 1.886V4.533ZM12.75 20.636A8.214 8.214 0 0 1 18 18.75c.966 0 1.89.166 2.75.47a.75.75 0 0 0 1-.708V4.262a.75.75 0 0 0-.5-.707A9.735 9.735 0 0 0 18 3a9.707 9.707 0 0 0-5.25 1.533v16.103Z" />
        </svg>
      </div>
      <div>
        <h1 class="text-2xl md:text-3xl font-bold font-serif text-neutral">
          Log In
        </h1>
        <p class="text-xs uppercase tracking-widest text-neutral/50 font-semibold mt-1">
          Welcome back to your reading journey
        </p>
      </div>
    </div>

    <%= form_with(url: user_session_path, scope: :session, local: true, html: { class: "space-y-5" }) do |f| %>
      <div class="space-y-4">
        <!-- Email Input with Gold Icon -->
        <div>
          <%= f.label :email, "Email", class: "label text-xs font-semibold uppercase tracking-wider text-neutral/70 pb-1" %>
          <div class="relative flex items-center">
            <div class="absolute left-3.5 text-secondary pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
                <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
              </svg>
            </div>
            <%= f.text_field :email, value: @email, class: "input input-bordered w-full pl-10 bg-base-100 focus:border-secondary focus:ring-1 focus:ring-secondary/30", placeholder: "you@example.com", required: true %>
          </div>
        </div>

        <!-- Password Input with Gold Icon & Toggle -->
        <div x-data="{ showPassword: false }" x-init="showPassword = false">
          <%= f.label :password, class: "label text-xs font-semibold uppercase tracking-wider text-neutral/70 pb-1" %>
          <div class="relative flex items-center">
            <div class="absolute left-3.5 text-secondary pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z" clip-rule="evenodd" />
              </svg>
            </div>
            <input 
              type="password"
              :type="showPassword ? 'text' : 'password'" 
              name="session[password]" 
              id="session_password" 
              class="input input-bordered w-full pl-10 pr-10 bg-base-100 focus:border-secondary focus:ring-1 focus:ring-secondary/30" 
              placeholder="Enter your password" 
              required
            >
            <button type="button" @click="showPassword = !showPassword" class="absolute inset-y-0 right-0 flex items-center pr-3 text-neutral/40 hover:text-secondary transition-colors">
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between pt-1">
        <label class="flex items-center gap-2 cursor-pointer select-none">
          <%= f.check_box :remember_me, class: "checkbox checkbox-primary checkbox-sm rounded" %>
          <span class="text-xs text-neutral/70 font-medium">Remember me</span>
        </label>

        <div class="text-xs">
          <%= link_to "Forgot password?", new_password_reset_path, class: "font-semibold text-secondary hover:underline" %>
        </div>
      </div>

      <div class="pt-2">
        <%= f.submit "Log In", class: "btn btn-primary rounded-full w-full font-semibold shadow-sm" %>
      </div>
    <% end %>

    <div class="pt-2 border-t border-base-300 text-center">
      <p class="text-xs text-neutral/60">
        Don't have an account? 
        <%= link_to "Sign Up", new_user_registration_path, class: "font-semibold text-secondary hover:underline ml-1" %>
      </p>
    </div>
  </div>
</div>