<div class="px-4 py-8 max-w-3xl mx-auto space-y-8">
  <!-- Header -->
  <div class="space-y-2 border-b border-base-300 pb-6">
    <h1 class="text-3xl sm:text-4xl font-serif font-bold text-neutral tracking-tight">
      <%= t('terms.title', default: 'Terms of Service') %>
