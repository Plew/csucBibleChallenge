    <p class="text-sm text-base-content/70">
      <%= t('terms.last_updated', default: 'Last updated: August 2026') %>
    </p>
  </div>

  <!-- Content -->
  <div class="prose prose-sm sm:prose-base max-w-none text-base-content/85 space-y-6 leading-relaxed">
