    <!-- 6. Termination -->
    <section class="space-y-3 bg-base-200/50 border border-base-300/80 rounded-2xl p-6">
      <h2 class="text-lg sm:text-xl font-bold font-serif text-neutral">6. Termination</h2>
      <p class="text-sm sm:text-base text-base-content/80">
        We reserve the right to suspend or terminate accounts that violate these Terms or disrupt the community. You may discontinue using the platform at any time.
      </p>
    </section>

    <!-- 7. Contact Us -->
    <section class="space-y-3 bg-base-200/50 border border-base-300/80 rounded-2xl p-6">
      <h2 class="text-lg sm:text-xl font-bold font-serif text-neutral">7. Questions & Contact</h2>
      <p class="text-sm sm:text-base text-base-content/80">
        For any questions regarding these Terms of Service, please contact us at <a href="mailto:support@andgodsaid.org" class="text-primary underline">support@andgodsaid.org</a> or visit our <a href="/contact" class="text-primary underline">Contact Page</a>.
