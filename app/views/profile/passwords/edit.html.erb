<div class="container mx-auto px-4 py-8">
  <div class="flex items-center mb-6">
    <%= link_to "← Back to Profile", profile_path, class: "btn btn-ghost btn-sm" %>
    <h1 class="text-3xl font-bold text-center text-base-content flex-1">Change Password</h1>
  </div>

  <div class="max-w-2xl mx-auto">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Update Your Password</h2>
        <%= form_with(model: @user, url: profile_password_path, method: :patch, local: true) do |f| %>
          <div class="form-control">
            <%= f.label :current_password, class: "label" do %>
              <span class="label-text">Current Password</span>
            <% end %>
            <%= f.password_field :current_password, class: "input input-bordered w-full", autocomplete: "current-password" %>
          </div>

          <div class="form-control mt-2">
            <%= f.label :password, "New Password", class: "label" do %>
              <span class="label-text">New Password</span>
            <% end %>
            <%= f.password_field :password, class: "input input-bordered w-full", autocomplete: "new-password" %>
          </div>

          <div class="form-control mt-2">
            <%= f.label :password_confirmation, "Confirm New Password", class: "label" do %>
              <span class="label-text">Confirm New Password</span>
            <% end %>
            <%= f.password_field :password_confirmation, class: "input input-bordered w-full", autocomplete: "new-password" %>
          </div>

          <div class="form-control mt-6">
            <%= f.submit "Change Password", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>