<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Profile", profile_path, class: "btn btn-ghost btn-sm" %>
    <h1 class="text-xl font-semibold text-base-content mt-2">Profile Details</h1>
  </div>

  <div class="max-w-2xl mx-auto">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Update Profile Information</h2>
        <%= form_with(model: @user, url: profile_details_path, method: :patch, local: true) do |f| %>
          <div class="form-control">
            <%= f.label :username, class: "label" do %>
              <span class="label-text">Name</span>
            <% end %>
            <%= f.text_field :username, class: "input input-bordered w-full" %>
          </div>

          <div class="form-control mt-2">
            <label class="label">
              <span class="label-text">Email (cannot be changed here)</span>
            </label>
            <input type="email" value="<%= @user.email %>" class="input input-bordered w-full" disabled />
          </div>

          <div class="alert alert-info mt-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>Avatar and Bible version settings are now in their own sections on the profile page.</span>
          </div>
          
          <div class="form-control mt-6">
            <%= f.submit "Save Changes", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>