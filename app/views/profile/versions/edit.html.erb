<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Profile", profile_path, class: "btn btn-ghost btn-sm" %>
  </div>

  <div class="max-w-2xl mx-auto">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Change Your Bible Version</h2>
        <%= form_with(model: @user, url: profile_version_path, method: :patch, local: true) do |f| %>
          <div class="form-control mt-2">
            <%= f.label :version, class: "label" do %>
              <span class="label-text">Preferred Bible Version</span>
            <% end %>
            
            <div class="mb-2">
              <p class="text-sm text-base-content/70">Current version: <strong><%= @user.version || 'KJV' %></strong></p>
            </div>
            
            <%= f.select :version, 
                options_for_select([
                  ['American Standard Version (ASV)', 'ASV'],
                  ['Elberfelder Bibel 2006 (German)', 'ELB2006'],
                  ['English Standard Version (ESV)', 'ESV'],
                  ['King James Version (KJV)', 'KJV'],
                  ['New American Standard Bible (NASB)', 'NASB'],
                  ['New King James Version (NKJV)', 'NKJV']
                ], @user.version), 
                {}, 
                { class: "select select-bordered w-full" } %>
            
            <div class="label">
              <span class="label-text-alt">This will be used for all your Bible reading</span>
            </div>
          </div>
          
          <div class="form-control mt-6">
            <%= f.submit "Update Bible Version", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>