<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to t('common.back'), account_path, class: "btn btn-ghost btn-sm" %>
  </div>

  <div class="max-w-2xl mx-auto">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title"><%= t('profile.change_bible_version_title') %></h2>
        <%= form_with(model: @user, url: profile_version_path, method: :patch, local: true) do |f| %>
          <div class="form-control mt-2">
            <%= f.label :version, class: "label" do %>
              <span class="label-text"><%= t('profile.preferred_version') %></span>
            <% end %>

            <div class="mb-2">
              <p class="text-sm text-base-content/70"><%= t('profile.current_version') %> <strong><%= @user.version || 'KJV' %></strong></p>
            </div>

            <%= f.select :version,
                options_for_select([
                  ['English Standard Version (ESV)', 'ESV'],
                  ['King James Version (KJV)', 'KJV'],
                  ['Elberfelder Bibel 2006 (German)', 'ELB2006'],
                  ['Schlachter 2000 (German)', 'SCHL2000']
                ], @user.version),
                {},
                { class: "select select-bordered w-full" } %>

            <div class="label">
              <span class="label-text-alt"><%= t('profile.version_help') %></span>
            </div>
          </div>

          <div class="form-control mt-6">
            <%= f.submit t('profile.update_bible_version'), class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>