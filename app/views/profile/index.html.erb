<div class="container mx-auto px-4 py-8">
  <h1 class="text-xl font-semibold mb-4 text-center text-base-content"><%= t('profile.account_settings') %></h1>

  <div class="grid md:grid-cols-2 gap-4 w-full">
    <%# Challenge Enrollment Card %>
    <%= link_to profile_enrollments_path, class: "card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow cursor-pointer w-full" do %>
      <div class="card-body p-4">
        <h2 class="text-sm font-medium"><%= t('profile.challenge_enrollment') %></h2>
        <p class="text-xs text-base-content/70"><%= t('profile.challenge_enrollment_desc') %></p>
      </div>
    <% end %>

    <%# Account Details Card %>
    <%= link_to edit_profile_details_path, class: "card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow cursor-pointer w-full" do %>
      <div class="card-body p-4">
        <h2 class="text-sm font-medium"><%= t('profile.account_details') %></h2>
        <p class="text-xs text-base-content/70"><%= t('profile.account_details_desc') %></p>
      </div>
    <% end %>

    <%# Update Avatar Card %>
    <%= link_to edit_profile_avatar_path, class: "card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow cursor-pointer w-full" do %>
      <div class="card-body p-4">
        <h2 class="text-sm font-medium"><%= t('profile.avatar') %></h2>
        <p class="text-xs text-base-content/70"><%= t('profile.avatar_desc') %></p>
      </div>
    <% end %>

    <%# Bible Version Card %>
    <%= link_to edit_profile_version_path, class: "card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow cursor-pointer w-full" do %>
      <div class="card-body p-4">
        <h2 class="text-sm font-medium"><%= t('profile.bible_version') %></h2>
        <p class="text-xs text-base-content/70"><%= t('profile.bible_version_desc') %></p>
      </div>
    <% end %>

    <%# Email Preferences Card %>
    <%= link_to edit_profile_email_preferences_path, class: "card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow cursor-pointer w-full" do %>
      <div class="card-body p-4">
        <h2 class="text-sm font-medium"><%= t('profile.email_preferences') %></h2>
        <p class="text-xs text-base-content/70"><%= t('profile.email_preferences_desc') %></p>
      </div>
    <% end %>

    <%# Push Notifications Card %>
    <div class="card bg-base-100 shadow-xl w-full" data-controller="push-notification">
      <div class="card-body p-4 space-y-3">
        <div class="flex flex-row items-center justify-between">
          <div>
            <h2 class="text-sm font-medium"><%= t('profile.push_notifications') %></h2>
            <p class="text-xs text-base-content/70"><%= t('profile.push_notifications_desc') %></p>
          </div>
          <input type="checkbox"
                 class="checkbox checkbox-primary"
                 data-push-notification-target="toggle"
                 data-action="change->push-notification#toggle">
        </div>

        <div data-push-notification-target="statusMessage" class="text-xs font-medium text-primary"></div>

        <div data-push-notification-target="iosNotice" class="hidden text-xs bg-secondary/10 border border-secondary/20 p-2.5 rounded-xl text-neutral/80">
          📌 <strong>iPhone / iPad Notice</strong>: Apple requires adding the app to your Home Screen before Web Push notifications can be activated.
        </div>

        <div>
          <button type="button"
                  data-push-notification-target="testButton"
                  data-action="click->push-notification#sendTestPush"
                  class="hidden btn btn-outline btn-xs rounded-full hover:btn-primary">
            Send Test Notification
          </button>
        </div>
      </div>
    </div>

    <%# Change Password Card %>
    <%= link_to edit_profile_password_path, class: "card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow cursor-pointer w-full" do %>
      <div class="card-body p-4">
        <h2 class="text-sm font-medium"><%= t('profile.password') %></h2>
        <p class="text-xs text-base-content/70"><%= t('profile.password_desc') %></p>
      </div>
    <% end %>

    <%# Account Actions Card %>
    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow cursor-pointer w-full" do %>
      <div class="card-body p-4">
        <h2 class="text-sm font-medium"><%= t('profile.log_out') %></h2>
        <p class="text-xs text-base-content/70"><%= t('profile.log_out_desc') %></p>
      </div>
    <% end %>
  </div>
</div>