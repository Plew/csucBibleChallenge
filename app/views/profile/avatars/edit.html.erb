<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to t('common.back'), account_path, class: "btn btn-ghost btn-sm" %>
  </div>

  <div class="max-w-2xl mx-auto">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title"><%= t('profile.change_avatar_title') %></h2>
        <%= form_with(model: @user, url: profile_avatar_path, method: :patch, local: true) do |f| %>
          <div class="form-control mt-2">
            <%= f.label :avatar, class: "label" do %>
              <span class="label-text"><%= t('profile.avatar') %></span>
            <% end %>

            <% if @user.avatar.attached? %>
              <div class="avatar mb-2">
                <div class="w-24 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2">
                  <%= image_tag @user.avatar.variant(:thumb) %>
                </div>
              </div>
              <p class="text-sm text-base-content/70 mb-2"><%= t('profile.current_avatar') %></p>
            <% else %>
              <%= avatar_image_tag(current_user, :tiny) %>
              <p class="text-sm text-base-content/70 mb-2"><%= t('profile.default_avatar') %></p>
            <% end %>

            <%= f.file_field :avatar, class: "file-input file-input-bordered w-full" %>
            <div class="label">
              <span class="label-text-alt"><%= t('profile.choose_new_image') %></span>
            </div>
          </div>

          <div class="form-control mt-6">
            <%= f.submit t('profile.update_avatar'), class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>