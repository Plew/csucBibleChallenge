<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to t('common.back'), account_path, class: "btn btn-ghost btn-sm" %>
  </div>

  <div class="max-w-2xl mx-auto">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title"><%= t('profile.email_prefs_title') %></h2>
        <%= form_with(model: @user, url: profile_email_preferences_path, method: :patch, local: true) do |f| %>
          <div class="form-control">
            <label class="label cursor-pointer justify-start gap-4">
              <%= f.check_box :daily_email, class: "checkbox checkbox-primary" %>
              <div class="flex flex-col">
                <span class="label-text"><%= t('profile.daily_notifications') %></span>
                <span class="label-text-alt text-base-content/70"><%= t('profile.daily_notifications_help') %></span>
              </div>
            </label>
          </div>

          <div class="form-control mt-6">
            <%= f.submit t('profile.save_preferences'), class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>