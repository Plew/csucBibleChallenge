<div class="max-w-md mx-auto mt-8 p-6 bg-base-100 rounded-lg shadow">
  <h2 class="text-xl font-bold mb-4">Edit Group</h2>

  <%= form_with model: @group, url: group_path(@group), method: :patch, data: { turbo: true }, class: 'space-y-4' do |f| %>
    <% if @group.errors.any? %>
      <div class="alert alert-error mb-4">
        <ul class="list-disc list-inside text-sm">
          <% @group.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, 'Group Name', class: 'block font-semibold mb-1' %>
      <%= f.text_field :name, class: 'input input-bordered w-full', required: true %>
    </div>

    <div>
      <%= f.label :motto, 'Group Motto', class: 'block font-semibold mb-1' %>
      <%= f.text_field :motto, class: 'input input-bordered w-full', placeholder: 'Optional: Add a group motto or tagline' %>
    </div>

    <div class="form-control">
      <label class="label cursor-pointer justify-start gap-3">
        <%= f.check_box :closed_to_new_members, class: "checkbox" %>
        <span class="label-text">No one else can join this group</span>
      </label>
    </div>

    <div class="flex gap-2 justify-center">
      <%= f.submit 'Update Group', class: 'btn btn-primary' %>
      <%= link_to 'Cancel', group_path(@group), class: 'btn btn-ghost' %>
    </div>
  <% end %>
</div> 