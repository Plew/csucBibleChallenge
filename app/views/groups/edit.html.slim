.group-container.p-4
  .flex.justify-between.items-center.mb-6
    h2.text-xl.font-bold = "Edit #{@group.name}"
    = link_to "Back to Group", group_path(@group), class: "text-blue-500 hover:text-blue-700"
  
  .edit-form.mb-8
    = form_with(model: @group, local: true) do |f|
      .field.mb-4
        = f.label :name, class: "block text-sm font-medium text-gray-700 mb-1"
        = f.text_field :name, class: "w-full rounded-md border-gray-300"
      
      .actions
        = f.submit "Update Group", class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600"

  .key-section.mb-8
    h3.text-xl.font-semibold.mb-4 Group Key
    .key-info.mb-4
      .flex.items-center.justify-center.gap-2
        p.text-3xl.text-center.font-bold
          = @group.key
        = render CopyButtonComponent.new(text: @group.key)

    .instructions.mb-4
      h4.text-lg.font-semibold.mb-2 How to invite others to join:
      ol.list-decimal.list-inside
        li Copy the group key above
        li Send the key to the person you want to invite
        li They can use the key to join this group

  .members-list
    h3.text-xl.font-semibold.mb-4 Group Members
    .grid.gap-2
      - @group.users.each do |user|
        .member-item.flex.items-center.justify-between.p-2.bg-gray-50.rounded
          .flex.items-center.gap-2
            .member-name
              = user.name
            - if user == @group.creator
              span.text-sm.text-gray-600.bg-gray-200.px-2.py-1.rounded-full Creator
          - if @group.creator != user
            = button_to "Remove", 
              group_member_path(@group, user_id: user.id), 
              method: :delete,
              class: "px-3 py-1.5 text-sm text-red-600 hover:text-white border border-red-600 hover:bg-red-600 rounded transition-colors duration-200",
              data: { turbo_confirm: "Are you sure you want to remove #{user.name} from the group?" }