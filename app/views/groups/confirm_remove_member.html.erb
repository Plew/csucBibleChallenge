<div class="max-w-md mx-auto mt-8 p-6 bg-base-100 rounded-lg shadow">
  <h2 class="text-xl font-bold mb-4"><%= t('groups.are_you_sure') %></h2>

  <div class="alert alert-warning mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <span><%= t('groups.confirm_remove_member', name: @member.name) %></span>
  </div>

  <div class="flex gap-2 justify-center">
    <%= button_to t('groups.yes_remove'),
        remove_member_group_path(@group, member_id: @member.id),
        method: :delete,
        class: 'btn btn-error',
        data: { turbo: true } %>
    <%= link_to t('groups.no_cancel'), edit_group_path(@group), class: 'btn btn-ghost' %>
  </div>
</div>
