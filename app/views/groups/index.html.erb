<button class="btn btn-outline">Default</button>
<button class="btn btn-outline btn-primary">Primary</button>
<button class="btn btn-outline btn-secondary">Secondary</button>
<button class="btn btn-outline btn-accent">Accent</button>
<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">My Groups</h1>
  
  <div class="flex justify-center gap-4">
    <%= link_to 'Create a group', new_group_path, class: "btn btn-primary btn-outline" %>
    <%= link_to 'Join a group', new_group_membership_path, class: "btn btn-primary btn-outline" %>
  </div>

  <div class="divide-y divide-base-300 mt-8">
    <% @groups.each do |group| %>
      <%= link_to group_path(group), class: "block py-4 px-6 hover:bg-base-200 transition-colors" do %>
        <div class="text-lg"><%= group.name %></div>
      <% end %>
    <% end %>
  </div>

  <% if @groups.empty? %>
    <div class="text-center py-8 text-base-content/70">
      <p>No groups yet</p>
    </div>
  <% end %>
</div>