<div class="container mx-auto px-4 py-6">
  <div class="mb-6">
    <p class="text-base-content/80">Join or create a group so you can chat with other challenge participants and encourage each other.</p>
  </div>
  
  <% if @groups.empty? %>
    <div class="text-center text-base-content/70 mb-6">
      No groups have been created yet for this Bible reading challenge
    </div>
  <% else %>
    <%= render 'groups_list', groups: @groups %>
  <% end %>
  
  <% unless @user_group %>
    <div class="mt-6 flex justify-center">
      <%= link_to 'Create Group', new_group_path, class: 'btn btn-primary w-full sm:w-auto' %>
    </div>
  <% end %>
</div>