<div class="container mx-auto px-4 py-8">
  <% if @groups.empty? %>
    <div class="text-center text-base-content/70 mb-6">
      No groups have been created yet for this Bible reading challenge
    </div>
  <% end %>
  <% unless @user_group %>
    <div class="mb-6 flex justify-center">
      <%= link_to 'Create Group', new_group_path, class: 'btn btn-primary w-full sm:w-auto' %>
    </div>
  <% end %>
  <div class="divide-y divide-base-300 mt-8">
    <% @groups.each do |group| %>
      <%= link_to group_path(group), class: 'block hover:bg-base-200 transition-colors cursor-pointer no-underline' do %>
        <div class="flex items-center justify-between py-2 px-2">
          <div class="flex items-center min-w-0 flex-1 gap-2">
            <div class="text-base truncate max-w-[8rem] sm:max-w-[14rem] flex-shrink-0" style="width:8rem;" title="<%= group.name %>"><%= group.name %></div>
            <div class="flex-grow"></div>
            <%= render OverlaidAvatarsComponent.new(users: group.users, max_avatars: 5, size: :tiny) %>
            <% if !@user_group %>
              <div class="flex-shrink-0 ml-2">
                <%= button_to 'Join', join_group_path(group), method: :post, class: 'btn btn-primary btn-sm', data: { turbo: true } %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>