<div class="container mx-auto px-4 py-8">
  <% unless @user_group %>
    <div class="mb-6 flex justify-center">
      <%= link_to 'Create Group', new_group_path, class: 'btn btn-primary w-full sm:w-auto' %>
    </div>
  <% end %>
  <div class="divide-y divide-base-300 mt-8">
    <% @groups.each do |group| %>
      <details class="group block">
        <summary class="flex items-center justify-between py-2 px-2 hover:bg-base-200 transition-colors cursor-pointer">
          <div class="flex items-center min-w-0 flex-1 gap-2">
            <div class="text-base truncate max-w-[8rem] sm:max-w-[14rem] flex-shrink-0" style="width:8rem;" title="<%= group.name %>"><%= group.name %></div>
            <div class="flex-grow"></div>
            <% enrollments = group.user_group_enrollments.includes(:user).to_a.shuffle %>
            <% shown_enrollments = enrollments.first(5) %>
            <% extra_count = enrollments.size - shown_enrollments.size %>
            <div class="avatar-group -space-x-6 flex-shrink-0">
              <% shown_enrollments.each do |enrollment| %>
                <div class="avatar">
                  <div class="w-8">
                    <%= avatar_image_tag(enrollment.user, :tiny, class: 'rounded-full') %>
                  </div>
                </div>
              <% end %>
              <% if extra_count > 0 %>
                <div class="avatar avatar-placeholder">
                  <div class="bg-neutral text-neutral-content w-8">
                    <span>+<%= extra_count %></span>
                  </div>
                </div>
              <% end %>
            </div>
            <% if !@user_group %>
              <div class="flex-shrink-0 ml-2">
                <%= button_to 'Join', join_group_path(group), method: :post, class: 'btn btn-primary btn-sm', data: { turbo: true } %>
              </div>
            <% end %>
          </div>
        </summary>
        <div class="py-2 bg-base-100 rounded-b-lg">
          <ul class="list bg-base-100 rounded-box shadow-md">
            <li class="p-4 pb-2 text-xs opacity-60 tracking-wide">Group Members</li>
            <% group.user_group_enrollments.includes(:user).each do |enrollment| %>
              <li class="list-row flex items-center gap-3 py-2 px-2">
                <div><%= avatar_image_tag(enrollment.user, :tiny, class: 'size-10 rounded-box') %></div>
                <div class="flex-1 min-w-0">
                  <div class="truncate"><%= enrollment.user.username %></div>
                  <div class="text-xs uppercase font-semibold opacity-60 truncate"><%= enrollment.user.email %></div>
                </div>
                <button class="btn btn-square btn-ghost">
                  <svg class="size-[1.2em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor"><path d="M6 3L20 12 6 21 6 3z"></path></g></svg>
                </button>
                <button class="btn btn-square btn-ghost">
                  <svg class="size-[1.2em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></g></svg>
                </button>
              </li>
            <% end %>
          </ul>
          <% if @user_group && group == @user_group %>
            <div class="mt-4 flex justify-end">
              <%= button_to 'Leave Group', leave_groups_path, method: :post, data: { turbo: true, confirm: 'Are you sure you want to leave your group?' }, class: 'btn btn-error btn-sm' %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
</div>