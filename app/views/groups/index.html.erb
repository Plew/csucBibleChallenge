<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Groups in <%= @challenge.name %></h1>

  <% if @user_group %>
    <div class="mb-6 p-4 rounded-lg bg-primary text-primary-content shadow-md">
      <div class="flex items-center justify-between">
        <div>
          <span class="font-semibold">Your Group:</span>
          <span class="ml-2 text-lg"><%= @user_group.name %></span>
        </div>
        <div class="flex items-center gap-2">
          <span class="badge badge-neutral"><%= @user_group.user_challenge_enrollments.count %> members</span>
          <%= button_to 'Leave Group', leave_groups_path, method: :post, data: { turbo: true, confirm: 'Are you sure you want to leave your group?' }, class: 'btn btn-sm btn-error ml-2' %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="divide-y divide-base-300 mt-8">
    <% @groups.each_with_index do |group, idx| %>
      <% next if @user_group && idx == 0 %> <%# Skip the user's group if already shown above %>
      <div class="flex items-center justify-between py-2 px-2 hover:bg-base-200 transition-colors">
        <div class="flex items-center gap-3">
          <div class="badge badge-neutral"><%= group.user_challenge_enrollments.count %> members</div>
          <div class="text-lg"><%= group.name %></div>
        </div>
        <% unless @user_group %>
          <%= button_to 'Join', join_group_path(group), method: :post, class: 'btn btn-primary btn-sm', data: { turbo: true } %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>