<div id="group-component" class="flex flex-col w-full">
  <div class="flex justify-between items-center mx-2 mt-4">
    <div class="w-6 h-6">
      <%= link_to "Edit Group", edit_group_path(@group), class: "text-blue-500 hover:text-blue-700" %>
    </div>
    <div class="w-6 h-6">
      <%= link_to create_or_join_path do %>
        <%= image_tag 'pluswhite100.png' %>
      <% end %>
    </div>
  </div>
  <div class="flex justify-center items-center mx-2 mt-2">
    <div class="text-2xl font-bold">
      <%= @group.name %>
    </div>
  </div>
  <div class="flex justify-between items-center h-64 max-w-full px-2">
    <div class="flex-shrink-0">
      <% if @previous_group_id %>
        <%= link_to group_path(@previous_group_id) do %>
          <%= image_tag 'previous.png', class: 'w-16 h-16' %>
        <% end %>
      <% end %>
    </div>

    <div class="flex-grow flex justify-center items-center h-64 w-full overflow-hidden">
      <div class="w-full h-full flex justify-center items-center">
        <%= render(PiechartComponent.new(group_id: @group.id, title: @group.name, user_checkin_data: @pie_chart_data)) %>
      </div>
    </div>

    <div class="flex-shrink-0">
      <% if @next_group_id %>
        <%= link_to group_path(@next_group_id) do %>
          <%= image_tag 'next.png', class: 'w-16 h-16' %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="flex flex-col items-center gap-4 mx-8 mt-8">
  <div class="text-xl">
    Group members
  </div>
  <div class="flex flex-col w-full">
    <% @group_members.each do |member| %>
      <div class="text-sm">
        <%= member.name %>
      </div>
    <% end %>
  </div>
</div> 