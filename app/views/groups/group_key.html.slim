.group-key-container.p-4
  h2.text-2xl.font-bold.mb-4 = "Group Key for #{@group.name}"
  
  .key-info.mb-4
    p.text-lg
      strong Key: 
      = @group.key

  .instructions.mb-4
    h3.text-xl.font-semibold.mb-2 How to Join:
    ol.list-decimal.list-inside
      li Copy the group key above
      li Open the app and tap "Join Group"
      li Paste the group key and tap "Join"

  .back-link.mt-6
    = link_to "Back to Group", group_path(@group), class: "text-blue-500 hover:text-blue-700"