= form_with(model: group, local: true) do |form|
  .flex.flex-col.gap-6.items-center
    div
      = form.text_field :name, placeholder: "Group name", label: false, class: "border border-gray-300 rounded-md p-2 w-full text-center"
    div
      = form.submit class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"