= form_with(model: @group, local: true) do |f|
  .flex.flex-col.gap-4.items-center
    div
      = f.text_field :name, placeholder: "Group name", class: "input input-bordered w-full max-w-xs", autofocus: true
    div
      = f.submit @group.new_record? ? "Create Group" : "Update Group", class: "btn btn-primary btn-wide btn-lg mb-4"

