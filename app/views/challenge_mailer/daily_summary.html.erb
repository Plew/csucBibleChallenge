<h1>Challenge Daily Summary: <%= @challenge.name %></h1>

<p>Hi <%= @challenge.creator.username %>,</p>

<p>Here's your daily summary for the challenge "<%= @challenge.name %>".</p>

<h2>Challenge Details</h2>
<ul>
  <li><strong>Name:</strong> <%= @challenge.name %></li>
  <li><strong>Start Date:</strong> <%= @challenge.start_date.strftime('%B %d, %Y') %></li>
  <li><strong>End Date:</strong> <%= @challenge.end_date.strftime('%B %d, %Y') %></li>
  <li><strong>Timezone:</strong> <%= @challenge.timezone %></li>
</ul>

<h2>Participants (<%= @participants.count %>)</h2>
<% if @participants.any? %>
  <ul>
    <% @participants.each do |participant| %>
      <li><%= participant.username %> (<%= participant.email %>)</li>
    <% end %>
  </ul>
<% else %>
  <p>No participants have joined yet.</p>
<% end %>

<p>Thanks,</p>
<p>The CSM Bible Challenge Team</p>

<hr style="margin: 20px 0; border: none; border-top: 1px solid #ccc;">

<p style="font-size: 12px; color: #666;">
  To manage your email preferences,
  <%= link_to "click here", unsubscribe_url_for(@challenge.creator) %>.
</p>
