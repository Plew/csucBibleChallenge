<%= form_with model: message,
              url: reading_verse_messages_path(reading, verse_number: verse_number),
              method: :post,
              local: false,
              class: "flex gap-2 items-center px-2" do |form| %>
  <%= form.text_area :content,
                    placeholder: "Type your message...",
                    rows: 2,
                    class: "textarea textarea-bordered textarea-sm flex-1 resize-none text-sm",
                    required: true %>
  <%= form.submit "Send",
                 class: "btn btn-primary btn-sm" %>
<% end %>
