<div class="px-2 py-4">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to @challenge.title, challenge_manage_dashboard_path(@challenge), class: "link link-hover" %></li>
      <li><%= link_to t("manage.users.title"), challenge_manage_users_path(@challenge), class: "link link-hover" %></li>
      <li><%= link_to @user.username, challenge_manage_user_path(@challenge, @user), class: "link link-hover" %></li>
      <li><%= t("manage.users.change_password") %></li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= t("manage.users.change_password") %></h1>
    <%= link_to t("common.back"), challenge_manage_user_path(@challenge, @user), class: "btn btn-sm btn-outline" %>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body p-4">
      <h2 class="card-title text-lg"><%= t("manage.users.change_password_for", username: @user.username) %></h2>
      <%= form_with url: update_password_challenge_manage_user_path(@challenge, @user), method: :patch, local: true do |form| %>
        <div class="form-control">
          <%= form.label :new_password, t("manage.users.new_password"), class: "label" %>
          <%= form.password_field :new_password, class: "input input-bordered", required: true %>
        </div>
        <div class="form-control mt-4">
          <%= form.submit t("manage.users.update_password"), class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
