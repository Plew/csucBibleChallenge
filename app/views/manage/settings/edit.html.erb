<div class="px-2 py-4 max-w-2xl mx-auto">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to @challenge.title, challenge_manage_dashboard_path(@challenge), class: "link link-hover" %></li>
      <li><%= t("manage.settings.title") %></li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= t("manage.settings.title") %></h1>
    <%= link_to t("common.back"), challenge_manage_dashboard_path(@challenge), class: "btn btn-sm btn-outline" %>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body p-4">
      <%= form_with(model: @challenge, url: challenge_manage_settings_path(@challenge), method: :patch, local: true, data: { turbo: false }, class: "space-y-4") do |form| %>
        <% if @challenge.errors.any? %>
          <div class="alert alert-error">
            <div>
              <h3 class="font-bold"><%= t("admin.fix_errors") %></h3>
              <ul class="list-disc list-inside">
                <% @challenge.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="form-control">
          <%= form.label :title, t("challenges.title"), class: "label" %>
          <%= form.text_field :title, class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= form.label :description, t("challenge_form.description_label"), class: "label" %>
          <%= form.text_area :description, class: "textarea textarea-bordered h-24", rows: 4 %>
          <div class="label">
            <span class="label-text-alt text-xs"><%= t("challenge_form.markdown_help") %></span>
          </div>
        </div>

        <div class="form-control">
          <%= form.label :message_of_the_day, t("manage.settings.message_of_the_day"), class: "label" %>
          <%= form.text_area :message_of_the_day, class: "textarea textarea-bordered h-24", rows: 3, placeholder: t("manage.settings.message_of_the_day_placeholder") %>
        </div>

        <%= render DatePickerComponent.new(
              form: form,
              attribute: :start_date,
              label: t("challenges.start_date"),
              presets: true
            ) %>

        <div class="divider text-xs text-base-content/50 uppercase tracking-wider"><%= t("manage.settings.stats_window_heading", default: "Statistics Window (Optional)") %></div>
        <p class="text-xs text-base-content/70 -mt-2 mb-2">
          <%= t("manage.settings.stats_window_explanation", default: "Customize which date range counts towards completion percentages, streaks, badges, and leaderboards. Any chapters completed outside this window still remain checked off in users' reading history.") %>
        </p>

        <%= render DatePickerComponent.new(
              form: form,
              attribute: :stats_start_date,
              label: t("manage.settings.stats_start_date", default: "Stats Start Date"),
              presets: true
            ) %>
        <div class="label -mt-3 mb-2">
          <span class="label-text-alt text-xs text-base-content/60">
            <%= t("manage.settings.stats_start_date_help", default: "Leave blank to start tracking stats from the challenge start date. Readings scheduled before this date are excluded from stats (e.g. for a trial period).") %>
          </span>
        </div>

        <%= render DatePickerComponent.new(
              form: form,
              attribute: :stats_end_date,
              label: t("manage.settings.stats_end_date", default: "Stats End Date"),
              presets: true
            ) %>
        <div class="label -mt-3 mb-2">
          <span class="label-text-alt text-xs text-base-content/60">
            <%= t("manage.settings.stats_end_date_help", default: "Leave blank to track stats through the challenge end date. Readings scheduled after this date are excluded from completion requirements and leaderboards.") %>
          </span>
        </div>

        <div class="form-control">
          <%= form.label :timezone, t("challenges.timezone"), class: "label" %>
          <%= form.select :timezone,
                options_for_select(timezone_options_for_select, @challenge.timezone.presence || "Eastern Time (US & Canada)"),
                { prompt: t("challenges.select_timezone") },
                { class: "select select-bordered w-full" } %>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <%= form.check_box :locked, class: "toggle toggle-primary" %>
            <span class="label-text"><%= t("manage.settings.lock_challenge") %></span>
          </label>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <%= form.check_box :verse_comments_enabled, class: "toggle toggle-primary" %>
            <span class="label-text"><%= t("manage.settings.verse_comments_enabled") %></span>
          </label>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <%= form.check_box :hidden, class: "toggle toggle-primary" %>
            <span class="label-text"><%= t("challenges.hide_challenge") %></span>
          </label>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <%= form.check_box :auto_remove_inactive_from_groups, class: "toggle toggle-primary" %>
            <span class="label-text"><%= t("manage.settings.auto_remove_inactive") %></span>
          </label>
          <div class="label">
            <span class="label-text-alt text-xs"><%= t("manage.settings.auto_remove_inactive_help") %></span>
          </div>
        </div>

        <div class="form-control mt-4">
          <%= form.submit t("common.save_changes"), class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
