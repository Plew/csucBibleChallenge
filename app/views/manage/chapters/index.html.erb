<div class="px-2 py-4">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to @challenge.title, challenge_manage_dashboard_path(@challenge), class: "link link-hover" %></li>
      <li><%= t("manage.chapters.title") %></li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= t("manage.chapters.title") %></h1>
    <span class="text-sm text-base-content/60"><%= t("manage.chapters.count", count: @readings.size) %></span>
  </div>

  <% if @readings.any? %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body p-3">
        <div class="overflow-x-auto">
          <table class="table table-zebra table-sm w-full">
            <thead>
              <tr>
                <th><%= t("manage.chapters.date") %></th>
                <th><%= t("manage.chapters.reading") %></th>
              </tr>
            </thead>
            <tbody>
              <% @readings.each do |reading| %>
                <tr>
                  <td class="text-base-content/70 whitespace-nowrap"><%= l(reading.scheduled_date, format: "%b %-d, %Y") %></td>
                  <td class="font-medium"><%= book_number_to_name(reading.book_number) %> <%= reading.chapter_number %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body p-4">
        <p class="text-base-content/60"><%= t("manage.chapters.no_chapters") %></p>
      </div>
    </div>
  <% end %>
</div>
