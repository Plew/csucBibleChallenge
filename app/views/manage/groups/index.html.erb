<div class="px-2 py-4">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to @challenge.title, challenge_manage_dashboard_path(@challenge), class: "link link-hover" %></li>
      <li><%= t("manage.groups.title") %></li>
    </ul>
  </div>

  <div class="flex flex-wrap justify-between items-center mb-6 gap-3">
    <div>
      <h1 class="text-2xl font-bold"><%= t("manage.groups.title") %></h1>
      <p class="text-xs text-base-content/60 mt-0.5"><%= t("manage.groups.subtitle", default: "Track group health, on-target pacing, completion, and manage member rosters.") %></p>
    </div>
    <% if @groups.any? %>
      <%= link_to challenge_manage_groups_path(@challenge, format: :csv), class: "btn btn-sm btn-outline gap-1.5 shadow-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span><%= t("common.export_csv", default: "Export CSV") %></span>
      <% end %>
    <% end %>
  </div>

  <%# Group Performance Overview Table %>
  <% if @groups_with_stats.present? %>
    <div class="card bg-base-100 shadow-md border border-base-200 mb-6 overflow-hidden">
      <div class="card-body p-4">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
              </svg>
            </div>
            <div>
              <h2 class="font-bold text-base"><%= t("manage.groups.overview_title", default: "Group Performance Overview") %></h2>
              <p class="text-xs text-base-content/60"><%= t("manage.groups.overview_subtitle", default: "Ordered by On Target %, Completion %, then member count") %></p>
            </div>
          </div>
          <span class="badge badge-sm badge-ghost"><%= pluralize(@groups_with_stats.size, t("common.group_one", default: "Group"), t("common.group_other", default: "Groups")) %></span>
        </div>

        <div class="text-sm text-base-content/70 mb-4 space-y-2">
          <p>As of <%= @group_statistics.today %> (<%= @challenge.timezone %>). Statistics through <%= @group_statistics.through_date %><% if @challenge.stats_start_date %>, starting <%= @challenge.stats_start_date %><% end %>. <%= @group_statistics.scheduled_count %> readings due per member.</p>
          <p>On Target % averages each member’s percentage completed on the scheduled date. Completion % counts completed readings scheduled through today, including catch-up reading. Both use the challenge’s statistics dates and current group membership.</p>
          <p>Completed and missing readings are totals across members; missing includes today. Caught up means all readings due are complete. Active means a completion dated in the last 7 calendar days for a reading in this reporting period. No completions means no readings completed in this period. Last activity is the latest completion date in this period.</p>
          <% if @group_statistics.scheduled_count.zero? %>
            <p>No readings are due in this reporting period yet; percentages and caught-up counts are shown as zero.</p>
          <% end %>
        </div>

        <div class="overflow-x-auto -mx-4 -mb-4">
          <table class="table table-sm table-zebra w-full text-left">
            <thead>
              <tr class="bg-base-200/60 text-xs">
                <th class="w-12 text-center">#</th>
                <th><%= t("manage.groups.group_name", default: "Group") %></th>
                <th class="text-center"><%= t("manage.groups.members", default: "Members") %></th>
                <th class="text-center"><%= t("manage.groups.on_target_percentage", default: "On Target %") %></th>
                <th class="text-center"><%= t("manage.groups.completion_percentage", default: "Completion %") %></th>
                <th class="text-center">Completed readings</th>
                <th class="text-center">Missing readings</th>
                <th class="text-center">Caught up</th>
                <th class="text-center">Active (7 days)</th>
                <th class="text-center">No completions</th>
                <th class="text-center">Last activity</th>
              </tr>
            </thead>
            <tbody>
              <% @groups_with_stats.each_with_index do |data, index| %>
                <% group = data[:group] %>
                <% on_target = data[:on_schedule_percentage] %>
                <% completion = data[:completion_percentage] %>
                <tr class="hover">
                  <td class="text-center font-bold text-xs text-base-content/60"><%= index + 1 %></td>
                  <td class="font-semibold text-sm">
                    <div class="flex items-center gap-1.5">
                      <span><%= group_name_with_flag(group) %></span>
                    </div>
                  </td>
                  <td class="text-center text-xs">
                    <span class="badge badge-sm badge-outline font-mono"><%= data[:member_count] %></span>
                  </td>
                  <td class="text-center">
                    <div class="inline-flex items-center gap-2">
                      <div class="w-14 h-2 bg-base-300 rounded-full overflow-hidden hidden sm:block">
                        <div class="h-full bg-primary rounded-full" style="width: <%= [on_target, 100].min %>%"></div>
                      </div>
                      <span class="badge badge-sm font-semibold font-mono <%= on_target >= 75 ? 'badge-success text-success-content' : (on_target >= 40 ? 'badge-warning text-warning-content' : 'badge-ghost') %>">
                        <%= on_target %>%
                      </span>
                    </div>
                  </td>
                  <td class="text-center">
                    <div class="inline-flex items-center gap-2">
                      <div class="w-14 h-2 bg-base-300 rounded-full overflow-hidden hidden sm:block">
                        <div class="h-full bg-secondary rounded-full" style="width: <%= [completion, 100].min %>%"></div>
                      </div>
                      <span class="badge badge-sm font-semibold font-mono <%= completion >= 75 ? 'badge-success text-success-content' : (completion >= 40 ? 'badge-info text-info-content' : 'badge-ghost') %>">
                        <%= completion %>%
                      </span>
                    </div>
                  </td>
                  <% [:completed_readings, :missing_readings, :caught_up_members, :active_members, :not_started_members].each do |metric| %>
                    <td class="text-center font-mono"><%= data[metric] %></td>
                  <% end %>
                  <td class="text-center whitespace-nowrap"><%= data[:last_activity] || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <% if @groups.any? %>
    <div class="mb-3">
      <h2 class="text-lg font-bold"><%= t("manage.groups.rosters_title", default: "Group Rosters & Management") %></h2>
    </div>
    <% @groups.each do |group| %>
      <% stats = @stats_by_group_id[group.id] %>
      <div class="card bg-base-100 shadow mb-4">
        <div class="card-body p-3">
          <%# Group stats chips %>
          <% if stats %>
            <div class="flex items-center gap-1.5 mb-2 pb-1.5 border-b border-base-200">
              <span class="text-xs font-semibold text-base-content/70 mr-1"><%= t("manage.groups.stats_label", default: "Performance:") %></span>
              <span class="badge badge-sm font-mono <%= stats[:on_schedule_percentage] >= 75 ? 'badge-success text-success-content' : 'badge-ghost' %>" title="<%= t('stats.on_target', default: 'On Target %') %>">
                <%= t("stats.on_target_short", default: "On Target:") %> <%= stats[:on_schedule_percentage] %>%
              </span>
              <span class="badge badge-sm font-mono <%= stats[:completion_percentage] >= 75 ? 'badge-info text-info-content' : 'badge-ghost' %>" title="<%= t('stats.completion', default: 'Completion %') %>">
                <%= t("stats.completion_short", default: "Completion:") %> <%= stats[:completion_percentage] %>%
              </span>
              <span class="badge badge-sm badge-outline font-mono">
                <%= pluralize(stats[:member_count], t("common.member_one", default: "member"), t("common.member_other", default: "members")) %>
              </span>
            </div>
          <% end %>

          <%# Group header with inline rename form %>
          <%= form_with url: challenge_manage_group_path(@challenge, group), method: :patch, local: true, class: "flex items-center gap-2 mb-3" do |f| %>
            <%= f.text_field "group[name]", value: group.name, class: "input input-bordered input-sm flex-1", required: true %>
            <%= f.submit t("manage.groups.rename"), class: "btn btn-sm btn-primary" %>
          <% end %>
          <%= button_to t("manage.groups.delete"), challenge_manage_group_path(@challenge, group),
              method: :delete,
              data: { turbo_confirm: t("manage.groups.delete_confirm", name: group.name) },
              class: "btn btn-sm btn-error btn-outline mb-3" %>

          <%# Members list %>
          <% if group.users.any? %>
            <div class="overflow-x-auto">
              <table class="table table-sm w-full">
                <thead>
                  <tr>
                    <th>Member</th>
                    <%= render "manage/shared/participant_stat_headers" %>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% group.users.each do |user| %>
                    <tr>
                      <td class="font-semibold text-sm">
                        <div class="flex items-center gap-2">
                          <%= avatar_image_tag(user, :tiny, class: "rounded-full") %>
                          <%= user.username %>
                        </div>
                      </td>
                      <%= render "manage/shared/participant_stat_cells", stats: @participant_stats.fetch(user.id) %>
                      <td class="text-right">
                        <div class="flex gap-1 justify-end">
                          <%# Move to another group %>
                          <% other_groups = @groups.reject { |g| g.id == group.id } %>
                          <% if other_groups.any? %>
                            <%= form_with url: move_member_challenge_manage_group_path(@challenge, group), method: :patch, local: true, class: "flex items-center gap-1" do |f| %>
                              <%= f.hidden_field :user_id, value: user.id %>
                              <%= f.select :target_group_id,
                                    other_groups.map { |g| [ g.name, g.id ] },
                                    {},
                                    class: "select select-bordered select-xs" %>
                              <%= f.submit t("manage.groups.move"), class: "btn btn-xs btn-outline" %>
                            <% end %>
                          <% end %>
                          <%= button_to t("manage.groups.remove_member"),
                                remove_member_challenge_manage_group_path(@challenge, group),
                                method: :delete,
                                params: { user_id: user.id },
                                data: { turbo_confirm: t("manage.groups.remove_member_confirm", username: user.username, group: group.name) },
                                class: "btn btn-xs btn-error btn-outline" %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-sm text-base-content/60 py-1"><%= t("manage.groups.no_members") %></p>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="card bg-base-100 shadow">
      <div class="card-body p-4">
        <p class="text-base-content/60"><%= t("manage.groups.no_groups") %></p>
      </div>
    </div>
  <% end %>
</div>
