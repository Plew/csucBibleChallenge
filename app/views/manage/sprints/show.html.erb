<div class="px-2 py-4">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><%= link_to @challenge.title, challenge_manage_dashboard_path(@challenge), class: "link link-hover" %></li>
      <li><%= link_to t("manage.sprints.title"), challenge_manage_sprints_path(@challenge), class: "link link-hover" %></li>
      <li><%= @sprint.title %></li>
    </ul>
  </div>

  <div class="flex justify-between items-center mb-4">
    <div>
      <h1 class="text-2xl font-bold"><%= @sprint.title %></h1>
      <p class="text-sm text-base-content/60 mt-1">
        <%= @sprint.begin_date.strftime("%B %d, %Y") %> - <%= @sprint.end_date.strftime("%B %d, %Y") %>
        <span class="badge badge-outline badge-sm ml-1"><%= t("admin.sprints.days_count", count: @sprint.days_count) %></span>
      </p>
    </div>
    <%= link_to t("common.back"), challenge_manage_sprints_path(@challenge), class: "btn btn-sm btn-outline" %>
  </div>

  <% if @sprint.winner_groups.any? %>
    <div class="card bg-base-100 shadow mb-4">
      <div class="card-body p-3">
        <div class="flex items-center gap-3 flex-wrap">
          <label class="font-semibold text-sm whitespace-nowrap"><%= t("admin.sprints.winners") %></label>
          <% @sprint.winner_groups.each do |group| %>
            <span class="badge badge-success gap-1">🏆 <%= group_name_with_flag(group) %></span>
          <% end %>
        </div>
      </div>
    </div>
  <% elsif @sprint.end_date < Date.current %>
    <div class="card bg-base-100 shadow mb-4">
      <div class="card-body p-3">
        <p class="text-sm text-base-content/60"><%= t("admin.sprints.no_winners_yet") %></p>
      </div>
    </div>
  <% end %>

  <% if @groups_with_stats.any? %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body p-3">
        <h2 class="card-title text-lg mb-3"><%= t("admin.sprints.group_leaderboard") %></h2>
        <div class="overflow-x-auto">
          <table class="table table-zebra table-sm w-full">
            <thead>
              <tr>
                <th><%= t("admin.sprints.rank") %></th>
                <th><%= t("admin.sprints.group_name") %></th>
                <th><%= t("admin.sprints.completion_percentage") %></th>
                <th><%= t("admin.sprints.on_time_percentage") %></th>
                <th><%= t("admin.sprints.members") %></th>
              </tr>
            </thead>
            <tbody>
              <% @groups_with_stats.each_with_index do |group_stats, index| %>
                <tr>
                  <td class="font-bold">
                    <% if index == 0 %>
                      <span class="text-yellow-500">🥇</span>
                    <% elsif index == 1 %>
                      <span class="text-gray-400">🥈</span>
                    <% elsif index == 2 %>
                      <span class="text-orange-600">🥉</span>
                    <% else %>
                      <%= index + 1 %>
                    <% end %>
                  </td>
                  <td>
                    <div class="font-semibold"><%= group_name_with_flag(group_stats[:group]) %></div>
                    <div class="text-xs text-base-content/60 mt-1">
                      <%= group_stats[:group].users.map(&:name).join(", ") %>
                    </div>
                  </td>
                  <td>
                    <div class="flex items-center gap-2">
                      <div class="w-16 bg-base-300 rounded-full h-2">
                        <div class="bg-blue-600 h-2 rounded-full" style="width: <%= group_stats[:completion_percentage] %>%"></div>
                      </div>
                      <span class="text-xs font-medium"><%= group_stats[:completion_percentage] %>%</span>
                    </div>
                  </td>
                  <td>
                    <div class="flex items-center gap-2">
                      <div class="w-16 bg-base-300 rounded-full h-2">
                        <div class="bg-green-600 h-2 rounded-full" style="width: <%= group_stats[:on_schedule_percentage] %>%"></div>
                      </div>
                      <span class="text-xs font-medium"><%= group_stats[:on_schedule_percentage] %>%</span>
                    </div>
                  </td>
                  <td>
                    <span class="badge badge-outline badge-sm"><%= group_stats[:member_count] %></span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body p-4">
        <p class="text-base-content/60"><%= t("admin.sprints.no_groups") %></p>
      </div>
    </div>
  <% end %>
</div>
