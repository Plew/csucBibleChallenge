<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body p-4">
      <%= form_with(model: @sprint, url: @sprint.new_record? ? challenge_manage_sprints_path(@challenge) : challenge_manage_sprint_path(@challenge, @sprint), method: @sprint.new_record? ? :post : :patch, local: true, class: "space-y-4") do |form| %>
      <% if @sprint.errors.any? %>
        <div class="alert alert-error">
          <h2 class="font-bold"><%= pluralize(@sprint.errors.count, "error") %> prohibited this sprint from being saved:</h2>
          <ul class="list-disc list-inside">
            <% @sprint.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-control">
        <%= form.label :title, t("admin.sprints.name"), class: "label" %>
        <%= form.text_field :title, class: "input input-bordered w-full", placeholder: t("admin.sprints.name_placeholder") %>
      </div>

      <div class="form-control">
        <%= render DatePickerComponent.new(
              form: form,
              attribute: :begin_date,
              label: t("admin.sprints.begin_date"),
              presets: false
            ) %>
        <label class="label pt-1">
          <span class="label-text-alt text-xs text-base-content/60"><%= t("admin.sprints.begin_date_hint", start_date: @challenge.start_date.strftime("%B %d, %Y")) %></span>
        </label>
      </div>

      <div class="form-control">
        <%= render DatePickerComponent.new(
              form: form,
              attribute: :end_date,
              label: t("admin.sprints.end_date"),
              presets: false
            ) %>
        <label class="label pt-1">
          <span class="label-text-alt text-xs text-base-content/60"><%= t("admin.sprints.end_date_hint", end_date: @challenge.end_date.strftime("%B %d, %Y")) %></span>
        </label>
      </div>

        <% if @groups&.any? %>
          <div class="divider"></div>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold"><%= t("admin.sprints.override_winners") %></span>
            </label>
            <p class="text-sm text-base-content/60 mb-2"><%= t("admin.sprints.override_winners_hint") %></p>
            <div class="space-y-2">
              <% @groups.each do |group| %>
                <label class="flex items-center gap-2 cursor-pointer">
                  <%= check_box_tag "sprint[winner_group_ids][]", group.id,
                      @sprint.winner_groups.include?(group),
                      id: "winner_group_#{group.id}",
                      class: "checkbox checkbox-sm checkbox-primary" %>
                  <span class="label-text"><%= group_name_with_flag(group) %></span>
                </label>
              <% end %>
            </div>
            <%= hidden_field_tag "sprint[winner_group_ids][]", "" %>
          </div>
        <% end %>

        <div class="card-actions justify-end mt-4">
          <%= link_to t("common.cancel"), challenge_manage_sprints_path(@challenge), class: "btn btn-outline" %>
          <%= form.submit t("common.save"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body p-4">
      <h3 class="card-title text-lg"><%= t("admin.sprints.readings_schedule") %></h3>
      <p class="text-sm text-base-content/60 mb-4"><%= t("admin.sprints.readings_schedule_hint") %></p>

      <div class="overflow-y-auto max-h-96">
        <table class="table table-sm table-zebra">
          <thead class="sticky top-0 bg-base-100">
            <tr>
              <th><%= t("admin.sprints.date") %></th>
              <th><%= t("admin.sprints.reading") %></th>
            </tr>
          </thead>
          <tbody>
            <% @readings.each do |reading| %>
              <tr>
                <td class="text-nowrap"><%= reading.scheduled_date.strftime("%b %d, %Y") %></td>
                <td><%= book_number_to_name(reading.book_number) %> <%= reading.chapter_number %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
