<div class="px-1">
  <h1 class="text-xl font-bold mb-3"><%= t("manage.overview.title") %></h1>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mb-4">
    <% [
         [ @user_count, t("manage.dashboard.participants") ],
         [ @reading_count, t("manage.dashboard.readings") ],
         [ @group_count, t("manage.dashboard.groups") ],
         [ @sprint_count, t("manage.dashboard.sprints") ],
         [ @blog_post_count, t("manage.overview.blog_posts") ]
       ].each do |value, label| %>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-3">
          <div class="text-2xl font-bold"><%= value %></div>
          <div class="text-xs text-base-content/60"><%= label %></div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="card bg-base-100 shadow-sm mb-4">
    <div class="card-body p-3">
      <h3 class="font-semibold mb-2"><%= t("manage.dashboard.status") %></h3>
      <div class="flex items-center gap-2 text-sm">
        <% if @challenge.hidden? %>
          <span class="badge badge-warning badge-sm"><%= t("challenges.hidden") %></span>
        <% else %>
          <span class="badge badge-success badge-sm"><%= t("challenges.visible") %></span>
        <% end %>
        <span class="text-base-content/60">
          <%= @challenge.start_date.strftime("%b %-d, %Y") %> - <%= @challenge.end_date.strftime("%b %-d, %Y") %>
        </span>
      </div>
    </div>
  </div>

  <% if @show_getting_started %>
    <div class="card bg-base-100 shadow-sm mb-4">
      <div class="card-body p-3">
        <h3 class="font-semibold mb-3"><%= t("manage.getting_started.title") %></h3>
        <ul class="steps steps-vertical text-sm">
          <li class="step step-primary"><%= t("manage.getting_started.step_created") %></li>
          <li class="step"><%= t("manage.getting_started.step_share") %></li>
          <li class="step"><%= t("manage.getting_started.step_groups") %></li>
          <li class="step"><%= t("manage.getting_started.step_ready") %></li>
        </ul>
        <div class="mt-3 p-2 bg-base-200 rounded">
          <p class="text-xs text-base-content/60 mb-1"><%= t("manage.getting_started.share_hint") %></p>
          <div class="flex items-center gap-2">
            <code class="text-xs break-all flex-1"><%= @challenge.join_url %></code>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
