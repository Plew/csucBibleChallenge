<div class="px-2 py-4">
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= t("manage.dashboard.title") %></h1>
    <%= link_to t("common.back"), challenge_path(@challenge), class: "btn btn-sm btn-outline" %>
  </div>

  <h2 class="text-lg font-semibold mb-3"><%= @challenge.title %></h2>

  <div class="grid grid-cols-2 gap-3 mb-6">
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-3">
        <div class="text-2xl font-bold"><%= @user_count %></div>
        <div class="text-xs text-base-content/60"><%= t("manage.dashboard.participants") %></div>
      </div>
    </div>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-3">
        <div class="text-2xl font-bold"><%= @reading_count %></div>
        <div class="text-xs text-base-content/60"><%= t("manage.dashboard.readings") %></div>
      </div>
    </div>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-3">
        <div class="text-2xl font-bold"><%= @group_count %></div>
        <div class="text-xs text-base-content/60"><%= t("manage.dashboard.groups") %></div>
      </div>
    </div>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-3">
        <div class="text-2xl font-bold"><%= @sprint_count %></div>
        <div class="text-xs text-base-content/60"><%= t("manage.dashboard.sprints") %></div>
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm mb-4">
    <div class="card-body p-3">
      <h3 class="font-semibold mb-2"><%= t("manage.dashboard.status") %></h3>
      <div class="flex items-center gap-2 text-sm">
        <% if @challenge.hidden? %>
          <span class="badge badge-warning badge-sm"><%= t("challenges.hidden") %></span>
        <% else %>
          <span class="badge badge-success badge-sm"><%= t("challenges.visible") %></span>
        <% end %>
        <span class="text-base-content/60">
          <%= @challenge.start_date.strftime("%b %-d, %Y") %> - <%= @challenge.end_date.strftime("%b %-d, %Y") %>
        </span>
      </div>
    </div>
  </div>

  <% if @show_getting_started %>
    <div class="card bg-base-100 shadow-sm mb-4">
      <div class="card-body p-3">
        <h3 class="font-semibold mb-3"><%= t("manage.getting_started.title") %></h3>
        <ul class="steps steps-vertical text-sm">
          <li class="step step-primary"><%= t("manage.getting_started.step_created") %></li>
          <li class="step"><%= t("manage.getting_started.step_share") %></li>
          <li class="step"><%= t("manage.getting_started.step_groups") %></li>
          <li class="step"><%= t("manage.getting_started.step_ready") %></li>
        </ul>
        <div class="mt-3 p-2 bg-base-200 rounded">
          <p class="text-xs text-base-content/60 mb-1"><%= t("manage.getting_started.share_hint") %></p>
          <div class="flex items-center gap-2">
            <code class="text-xs break-all flex-1"><%= @challenge.join_url %></code>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="space-y-2">
    <%= link_to edit_challenge_manage_settings_path(@challenge), class: "btn btn-primary btn-sm w-full" do %>
      <%= t("manage.dashboard.edit_settings") %>
    <% end %>
    <%= link_to challenge_manage_sprints_path(@challenge), class: "btn btn-secondary btn-sm w-full" do %>
      <%= t("manage.dashboard.manage_sprints") %>
    <% end %>
    <%= link_to challenge_manage_blog_posts_path(@challenge), class: "btn btn-secondary btn-sm w-full" do %>
      <%= t("manage.dashboard.manage_blog") %>
    <% end %>
    <%= link_to challenge_manage_users_path(@challenge), class: "btn btn-secondary btn-sm w-full" do %>
      <%= t("manage.dashboard.manage_users") %>
    <% end %>
    <%= link_to challenge_seven_day_lobby_path(@challenge), class: "btn btn-secondary btn-sm w-full" do %>
      <%= t("manage.dashboard.weekly_winner") %>
    <% end %>
  </div>
</div>
