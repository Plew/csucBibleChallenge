<div class="px-2 py-4">
  <% if @blog_posts.any? %>
    <div class="space-y-3">
      <% @blog_posts.each do |post| %>
        <%= link_to challenge_blog_post_path(@challenge, post), class: "block" do %>
          <div class="card bg-base-100 shadow-md hover:shadow-lg transition-shadow">
            <% if post.image.attached? %>
              <figure class="px-0 pt-0">
                <%= image_tag post.image.variant(resize_to_limit: [800, 400]),
                    class: "w-full object-cover max-h-48",
                    alt: post.title %>
              </figure>
            <% end %>
            <div class="card-body p-4">
              <h2 class="card-title text-xl"><%= post.title %></h2>

              <p class="text-xs text-base-content/60 mb-2">
                <%= l(post.created_at, format: :long) %>
              </p>

              <div class="prose prose-sm max-w-none mb-3">
                <%= markdown(truncate(post.content, length: 200)) %>
              </div>

              <div class="flex justify-between items-center text-sm text-base-content/60">
                <span><%= t("blog.comment_count", count: post.blog_comments.count) %></span>
                <span class="link link-primary"><%= t("common.view") %> →</span>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <div class="card bg-base-200 shadow-md max-w-md mx-auto">
        <div class="card-body p-6">
          <h2 class="card-title justify-center text-lg"><%= t("blog.no_posts") %></h2>
          <p class="text-sm text-base-content/60"><%= t("blog.no_posts_message") %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>
