.mt-4.flex-col.flex.items-center.gap-4 class="*:text-center"
  = form_tag group_memberships_path do
    .form-group.flex.flex-col.gap-2.items-center
      div
        = text_field_tag :key, nil, placeholder: "ABCD-1234", required: true, pattern: '^[A-Za-z]{4}-[0-9]{4}$', class: "input input-bordered w-full"
      div
        = submit_tag "Join", class: "btn btn-primary btn-wide btn-lg"


javascript:
  document.addEventListener('DOMContentLoaded', function() {
    var keyInput = document.querySelector('input[name="key"]');
    keyInput.addEventListener('input', function(e) {
      var value = e.target.value.toUpperCase();
      var letters = value.slice(0, 4).replace(/[^A-Z]/g, '');
      var numbers = value.slice(5).replace(/[^0-9]/g, '');
      if (letters.length === 4 && value.length > 4 && value[4] !== '-') {
        e.target.value = letters + '-' + numbers;
      } else {
        e.target.value = letters + (letters.length === 4 ? '-' : '') + numbers;
      }
    });

    keyInput.addEventListener('keydown', function(e) {
      if (e.key === 'Backspace' && this.value.length === 5 && this.value[4] === '-') {
        e.preventDefault();
        this.value = this.value.slice(0, 4);
      }
    });

    document.querySelector('form').addEventListener('submit', function(e) {
      e.preventDefault();
      this.submit();
    });
  });

