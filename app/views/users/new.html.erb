<div class="min-h-screen flex items-center justify-center bg-base-200 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-base-content">
        Create your ReVerse Account
      </h2>
    </div>
    <%= form_for(@user, url: users_path, html: { class: "mt-8 space-y-6" }) do |f| %>
      <%# TODO: Display form errors once error handling is fully implemented %>
      <%# if @user.errors.any? %>
      <%#   <div class="alert alert-error shadow-lg">
      <%#     <div>
      <%#       <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"stroke-current flex-shrink-0 h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10 14l2-2m0 0l2-2m-2 2l-2 2m2-2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z\" /></svg>
      <%#       <span><%= pluralize(@user.errors.count, \"error\") %> prohibited this user from being saved:</span>
      <%#       <ul>
      <%#         <% @user.errors.full_messages.each do |message| %>
      <%#           <li><%= message %></li>
      <%#         <% end %>
      <%#       </ul>
      <%#     </div>
      <%#   </div>
      <%# end %>

      <div class="rounded-md shadow-sm -space-y-px">
        <div>
          <%= f.label :username, class: "label" %>
          <%= f.text_field :username, class: "input input-bordered w-full", placeholder: "Username", required: true %>
        </div>
        <div class="pt-2">
          <%= f.label :email, class: "label" %>
          <%= f.email_field :email, class: "input input-bordered w-full", placeholder: "Email address", required: true %>
        </div>
        <div class="pt-2">
          <%= f.label :password, class: "label" %>
          <%= f.password_field :password, class: "input input-bordered w-full", placeholder: "Password", required: true %>
        </div>
        <div class="pt-2">
          <%= f.label :password_confirmation, class: "label" %>
          <%= f.password_field :password_confirmation, class: "input input-bordered w-full", placeholder: "Confirm Password", required: true %>
        </div>
      </div>

      <div>
        <%= f.submit "Sign Up", class: "btn btn-primary w-full" %>
      </div>
    <% end %>

    <div class="text-sm text-center">
      <%= link_to "Already have an account? Log In", '#' %><%# Placeholder link %>
    </div>
  </div>
