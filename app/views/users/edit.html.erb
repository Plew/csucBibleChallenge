<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6 text-center text-base-content">Account Settings</h1>

  <%# Flash messages for updates %>

  <div class="grid md:grid-cols-2 gap-6">
    <%# Update Username Card %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Update Profile</h2>
        <%= form_with(model: @user, url: user_profile_path, method: :patch, local: true) do |f| %>
          <div class="form-control">
            <%= f.label :username, class: "label" do %>
              <span class="label-text">Name</span>
            <% end %>
            <%= f.text_field :username, class: "input input-bordered w-full" %>
          </div>

          <div class="form-control mt-2">
            <label class="label">
              <span class="label-text">Email (cannot be changed here)</span>
            </label>
            <input type="email" value="<%= @user.email %>" class="input input-bordered w-full" disabled />
          </div>
          
          <div class="form-control mt-6">
            <%= f.submit "Save", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>

    <%# Change Password Card %>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Change Password</h2>
        <%= form_with(model: @user, url: user_profile_path, method: :patch, local: true) do |f| %> <%# Adjust URL if separate endpoint for password %>
          <div class="form-control">
            <%= f.label :current_password, class: "label" do %>
              <span class="label-text">Current Password</span>
            <% end %>
            <%= f.password_field :current_password, class: "input input-bordered w-full", autocomplete: "current-password" %>
          </div>

          <div class="form-control mt-2">
            <%= f.label :password, "New Password", class: "label" do %>
              <span class="label-text">New Password</span>
            <% end %>
            <%= f.password_field :password, class: "input input-bordered w-full", autocomplete: "new-password" %>
          </div>

          <div class="form-control mt-2">
            <%= f.label :password_confirmation, "Confirm New Password", class: "label" do %>
              <span class="label-text">Confirm New Password</span>
            <% end %>
            <%= f.password_field :password_confirmation, class: "input input-bordered w-full", autocomplete: "new-password" %>
          </div>

          <div class="form-control mt-6">
            <%= f.submit "Change Password", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Challenge Enrollment Section %>
  <div class="mt-6">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Challenge Enrollment</h2>
        <% if @user_enrollment %>
          <p class="mb-2">You are currently enrolled in: <strong class="font-semibold"><%= @user_enrollment.challenge.name %></strong></p>
          <div class="card-actions justify-start">
            <%= button_to "Leave Challenge", user_challenge_enrollment_path(@user_enrollment), method: :delete, data: { confirm: "Are you sure you want to leave this challenge? Your progress will be saved." }, class: "btn btn-error btn-outline" %>
          </div>
        <% else %>
          <p>You are not currently enrolled in any challenge.</p>
          <%= link_to "Browse Available Challenges", root_path, class: "btn btn-primary mt-2" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="text-center mt-8">
    <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "link link-error" %>
  </div>

</div> 