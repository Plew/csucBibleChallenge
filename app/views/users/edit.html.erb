<%= form_with(model: @user, local: true, class: "max-w-md mx-auto") do |form| %>
  <div class="mb-4">
    <%= form.label :name, class: "block text-gray-700 text-sm font-bold mb-2" %>
    <%= form.text_field :name, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
  </div>

  <div class="flex items-center justify-center" id="change-name-button">
    <%= form.submit "Change Name", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" %>
  </div>

  <div class="flex flex-col items-center mt-8 space-y-4">
    <div class="text-gray-700 text-sm font-bold">Your user key is:</div>
    <code class="bg-gray-100 p-2 rounded text-gray-700"><%= @user.key %></code>
    <div class="text-sm text-gray-600 mx-8 text-center">
      Take a screenshot of this key or write it down if you want to log into your account on another device.
      This key is the ONLY WAY you can log into your account if you switch devices or lose your phone. 
      For privacy reasons we do not store email addresses or phone numbers.
    </div>
  </div>

  <div class="mt-12 border-t pt-8 text-center">
    <%= link_to "Switch to a different account", recover_user_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>
<% end %> 