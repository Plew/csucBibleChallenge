<div class="min-h-screen flex justify-center bg-base-200 pt-6 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-2 text-center text-3xl font-extrabold text-base-content">
        Create New Password
      </h2>
      <p class="mt-2 text-center text-sm text-base-content/70">
        Enter your new password below.
      </p>
    </div>
    
    <%= form_with(url: update_password_reset_path(params[:token]), method: :patch, scope: :user, local: true, html: { class: "mt-8 space-y-6" }) do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :password, "New Password", class: "label" %>
          <%= f.password_field :password, class: "input input-bordered w-full", placeholder: "Enter new password", required: true %>
          <% if @user&.errors&.any? %>
            <% @user.errors.full_messages_for(:password).each do |message| %>
              <div class="text-error text-sm mt-1"><%= message %></div>
            <% end %>
          <% end %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirm New Password", class: "label" %>
          <%= f.password_field :password_confirmation, class: "input input-bordered w-full", placeholder: "Confirm new password", required: true %>
          <% if @user&.errors&.any? %>
            <% @user.errors.full_messages_for(:password_confirmation).each do |message| %>
              <div class="text-error text-sm mt-1"><%= message %></div>
            <% end %>
          <% end %>
        </div>
      </div>

      <div>
        <%= f.submit "Update Password", class: "btn btn-primary w-full" %>
      </div>
    <% end %>
  </div>
</div>