<div class="card bg-base-100 shadow-xl">
  <div class="card-body px-2 sm:px-4">
    <!-- Header with Title and Status -->
    <div class="flex flex-col gap-4 mb-6">
      <div>
        <h1 class="card-title text-xl sm:text-2xl font-bold text-base-content leading-tight break-words">
          <%= challenge.name %>
        </h1>
        <% if challenge_status != "active" %>
          <div class="flex flex-col sm:flex-row sm:items-center gap-2 mt-3">
            <span class="badge <%= status_badge_class %> text-sm w-fit">
              <%= challenge_status.capitalize %>
            </span>
            <span class="text-sm text-base-content/70">
              <%= status_text %>
            </span>
          </div>
        <% end %>

        <!-- Challenge Progress Bar -->
        <div class="mt-4">
          <div class="flex justify-between text-sm text-base-content/70 mb-1">
            <span><%= t('stats.challenge_progress') %> (<%= days_remaining %>/<%= total_duration_days %> days remaining)</span>
            <span><%= challenge_progress_percentage %>% complete</span>
          </div>
          <progress class="progress progress-primary w-full"
                    value="<%= challenge_progress_percentage %>"
                    max="100"></progress>
        </div>

        <!-- Sprint Progress (if active sprint exists) -->
        <% if statistics.active_sprint %>
          <div class="mt-4">
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
              <span class="badge badge-success text-sm w-fit">
                <%= t('stats.active_sprint') %>: <%= statistics.active_sprint.title %>
              </span>
            </div>
            <div class="mt-2">
              <div class="flex justify-between text-sm text-base-content/70 mb-1">
                <span><%= t('stats.sprint_progress') %> (<%= statistics.sprint_days_remaining %>/<%= sprint_total_days %> days remaining)</span>
                <span><%= statistics.sprint_progress_percentage %>% complete</span>
              </div>
              <progress class="progress progress-primary w-full"
                        value="<%= statistics.sprint_progress_percentage %>"
                        max="100"></progress>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Main Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
      <!-- Participants -->
      <div class="stat bg-base-200 rounded-lg p-3 sm:p-4">
        <div class="stat-figure text-primary hidden sm:block">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-6 h-6 sm:w-8 sm:h-8 stroke-current">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
        </div>
        <div class="stat-title text-xs">Participants</div>
        <div class="stat-value text-lg sm:text-xl text-primary"><%= statistics.number_of_participants %></div>
        <div class="stat-desc text-xs">people have joined</div>
      </div>

      <!-- Total Chapters Read -->
      <div class="stat bg-base-200 rounded-lg p-3 sm:p-4">
        <div class="stat-figure text-secondary hidden sm:block">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-6 h-6 sm:w-8 sm:h-8 stroke-current">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
        </div>
        <div class="stat-title text-xs">Total Chapters Read</div>
        <div class="stat-value text-lg sm:text-xl text-secondary"><%= statistics.total_chapters_read %></div>
        <div class="stat-desc text-xs">by all participants</div>
      </div>

      <!-- Duration -->
      <div class="stat bg-base-200 rounded-lg p-3 sm:p-4">
        <div class="stat-figure text-accent hidden sm:block">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-6 h-6 sm:w-8 sm:h-8 stroke-current">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div class="stat-title text-xs">Duration</div>
        <div class="stat-value text-lg sm:text-xl text-accent"><%= total_duration_days %></div>
        <div class="stat-desc text-xs">days in total</div>
      </div>

      <!-- Chapters Read Today -->
      <div class="stat bg-base-200 rounded-lg p-3 sm:p-4">
        <div class="stat-figure text-info hidden sm:block">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-6 h-6 sm:w-8 sm:h-8 stroke-current">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <div class="stat-title text-xs">Chapters Read Today</div>
        <div class="stat-value text-lg sm:text-xl text-info"><%= statistics.chapters_read_today %></div>
        <div class="stat-desc text-xs">completed today</div>
      </div>
    </div>

    <!-- First Reader Today -->
    <div class="card bg-base-200 shadow-sm mb-6">
      <div class="card-body p-3 sm:p-4">
        <div class="flex justify-between items-center">
          <span class="text-sm font-medium">First reader today <%= first_reader_time_formatted %>:</span>
          <span class="text-sm font-semibold flex items-center gap-2">
            <% if statistics.first_reader_today %>
              <%= render AvatarComponent.new(user: statistics.first_reader_today, size: :xs, html_options: { class: 'rounded-full' }) %>
              <%= first_reader_username %>
            <% else %>
              <span class="text-base-content/50">None yet</span>
            <% end %>
          </span>
        </div>
      </div>
    </div>

    <!-- Most Liked Verse Today -->
    <div class="card bg-base-200 shadow-sm mb-6">
      <div class="card-body p-3 sm:p-4">
        <div class="text-sm font-medium mb-3"><%= t('stats.most_liked_verse_today') %>:</div>
        <% if most_liked_verse_today.present? %>
          <div class="space-y-3">
            <% most_liked_verse_today.each do |verse| %>
              <div class="flex items-start gap-2">
                <div class="relative shrink-0 text-red-500 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                  </svg>
                  <span class="absolute inset-0 flex items-center justify-center text-[9px] font-bold text-white" style="padding-bottom: 2px;"><%= verse[:like_count] %></span>
                </div>
                <div class="min-w-0">
                  <span class="text-xs font-semibold text-primary block"><%= verse[:reference] %></span>
                  <p class="text-sm text-accent leading-relaxed italic"><%= verse[:text] %></p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-sm text-base-content/50"><%= t('stats.no_liked_verses_today') %></div>
        <% end %>
      </div>
    </div>

    <!-- Last 10 Readers -->
    <div class="card bg-base-200 shadow-sm">
      <div class="card-body p-3 sm:p-4">
        <h3 class="card-title text-base sm:text-lg mb-3 sm:mb-4">Last 10 readers</h3>
        <% if statistics.last_10_readers.any? %>
          <div class="space-y-2">
            <% statistics.last_10_readers.each do |reader_data| %>
              <div class="flex justify-between items-center">
                <span class="text-sm flex items-center gap-2">
                  <%= render AvatarComponent.new(user: reader_data[:user], size: :xs, html_options: { class: 'rounded-full' }) %>
                  <span class="font-medium"><%= reader_data[:user].username %></span>
                </span>
                <span class="text-xs text-base-content/70"><%= reader_data[:time_ago] %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-sm text-base-content/50">No readings yet</div>
        <% end %>
      </div>
    </div>
  </div>
</div>
