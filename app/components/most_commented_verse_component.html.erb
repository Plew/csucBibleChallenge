<div class="card bg-base-100 shadow-xl">
  <div class="card-body p-3 sm:p-4">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
      <h2 class="card-title text-lg sm:text-xl font-bold">
        <%= t('statistics.most_commented_verse_today') %>
      </h2>
      <div class="badge badge-primary">
        <%= t('statistics.total_comments_count', count: total_comments) %>
      </div>
    </div>

    <% if has_comments? %>
      <!-- Verse Reference -->
      <div class="mb-3">
        <div class="flex items-center gap-2 mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 stroke-current text-primary">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
          </svg>
          <span class="font-bold text-lg text-primary"><%= verse_reference %></span>
        </div>

        <!-- Comment Count Badge -->
        <div class="flex items-center gap-2 mb-3">
          <span class="badge badge-secondary badge-lg">
            <%= t('statistics.comment_count', count: comment_count) %>
          </span>
        </div>
      </div>

      <!-- Verse Text -->
      <div class="bg-base-200 rounded-lg p-4">
        <p class="text-sm sm:text-base italic text-base-content leading-relaxed">
          "<%= verse_text %>"
        </p>
      </div>
    <% else %>
      <!-- No Comments State -->
      <div class="flex flex-col items-center justify-center py-8 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-12 h-12 stroke-current text-base-content/30 mb-3">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
        <p class="text-sm text-base-content/50">
          <%= t('statistics.no_comments_today') %>
        </p>
      </div>
    <% end %>
  </div>
</div>
