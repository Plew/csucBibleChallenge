<% if can_chat? %>
  <div class="bg-base-100 rounded-lg shadow p-2 mt-4">
    <h3 class="text-base font-semibold mb-2 px-2">Overflow</h3>

    <div id="chat-messages" class="max-h-96 overflow-y-auto mb-2 text-sm">
      <% if messages.any? %>
        <% messages.each do |message| %>
          <div class="chat chat-start">
            <div class="chat-image avatar">
              <div class="w-8 rounded-full">
                <%= avatar_image_tag(message.user, :tiny, class: 'rounded-full') %>
              </div>
            </div>
            <div class="chat-bubble text-sm">
              <%= simple_format(h(message.content)) %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center text-gray-500 py-4 text-sm">
          No messages yet. Start the conversation!
        </div>
      <% end %>
    </div>

    <%= turbo_frame_tag "new-message-form" do %>
      <%= form_with model: [group, new_message],
                    url: group_group_messages_path(group),
                    method: :post,
                    local: false,
                    data: { turbo_frame: "chat-messages" },
                    class: "flex gap-2 items-center px-2" do |form| %>
        <%= form.text_area :content,
                          placeholder: "Type your message...",
                          rows: 2,
                          class: "textarea textarea-bordered textarea-sm flex-1 resize-none text-sm",
                          required: true %>
        <%= form.submit "Send",
                       class: "btn btn-primary btn-sm" %>
      <% end %>
    <% end %>
  </div>
<% end %>
