<div class="flex text-sm w-1/3">
  This Week
</div>
<div id="user-this-week" class="flex w-full h-8 divide-x divide-black">
  <% this_weeks_days.each do |date| %>
    <div class="flex-grow h-full <%= @check_in_dates.include?(date) ? 'text-white bg-green-800' : 'bg-gray-800 text-white' %>">
      <div class="flex items-center justify-center h-full">
        <span class="text-lg font-bold"><%= date.strftime('%A').first.upcase %></span>
      </div>
    </div>
  <% end %>
</div> 