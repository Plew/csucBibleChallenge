<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-2xl sm:text-3xl font-bold mb-4 sm:mb-8">Create New Reading Challenge</h1>

    <%= form_with model: challenge, url: form_url, local: true, class: "space-y-4 sm:space-y-6", data: { controller: "challenge-creator" } do |form| %>
      <% if challenge.errors.any? %>
        <div class="alert alert-error">
          <ul class="list-disc list-inside">
            <% challenge.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Challenge Details Card -->
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title mb-4">Challenge Details</h2>
          
          <div class="form-control w-full">
            <%= form.label :name, "Challenge Title", class: "label" %>
            <%= form.text_field :name, class: "input input-bordered w-full", placeholder: "Enter challenge title" %>
          </div>

          <div class="form-control w-full">
            <%= form.label :description, "Description (optional - Markdown supported)", class: "label" %>
            <%= form.text_area :description, class: "textarea textarea-bordered w-full", placeholder: "Enter a brief description of the challenge", rows: 3 %>
            <div class="label">
              <span class="label-text-alt text-xs">
                Markdown syntax: **bold**, *italic*, [link](url), ![image](url), - lists
              </span>
            </div>
          </div>

          <div class="form-control w-full">
            <%= form.label :start_date, "Start Date", class: "label" %>
            <%= form.date_field :start_date, class: "input input-bordered w-full", data: { "challenge-creator-target": "startDate", action: "change->challenge-creator#updateSchedule" } %>
          </div>

          <div class="form-control w-full">
            <%= form.label :timezone, "Timezone", class: "label" %>
            <%= form.select :timezone, options_for_select(timezone_options, default_timezone), {}, { class: "select select-bordered w-full" } %>
          </div>
        </div>
      </div>

      <!-- Book Selection Card -->
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title mb-4">Select Bible Books</h2>
          
          <!-- Testament Selection Buttons -->
          <div class="flex flex-col sm:flex-row gap-2 sm:gap-4 mb-4 sm:mb-6">
            <button type="button" class="btn btn-outline btn-sm sm:btn-md" data-action="click->challenge-creator#selectOldTestament">
              Select All Old Testament
            </button>
            <button type="button" class="btn btn-outline btn-sm sm:btn-md" data-action="click->challenge-creator#selectNewTestament">
              Select All New Testament
            </button>
            <button type="button" class="btn btn-outline btn-sm sm:btn-md" data-action="click->challenge-creator#clearAllBooks">
              Clear All
            </button>
          </div>

          <!-- Old Testament Books -->
          <div class="mb-6 sm:mb-8">
            <h3 class="text-lg font-semibold mb-3 sm:mb-4">Old Testament</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3">
              <% old_testament_books.each do |book| %>
                <label class="flex items-center cursor-pointer">
                  <input type="checkbox" 
                         name="selected_books[]" 
                         value="<%= book[:number] %>" 
                         class="checkbox checkbox-primary mr-2" 
                         data-challenge-creator-target="bookCheckbox"
                         data-action="change->challenge-creator#updateSchedule"
                         data-testament="old"
                         data-chapters="<%= book[:chapters] %>">
                  <span class="text-sm"><%= book[:name] %> (<%= book[:chapters] %>)</span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- New Testament Books -->
          <div class="mb-4 sm:mb-6">
            <h3 class="text-lg font-semibold mb-3 sm:mb-4">New Testament</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3">
              <% new_testament_books.each do |book| %>
                <label class="flex items-center cursor-pointer">
                  <input type="checkbox" 
                         name="selected_books[]" 
                         value="<%= book[:number] %>" 
                         class="checkbox checkbox-primary mr-2" 
                         data-challenge-creator-target="bookCheckbox"
                         data-action="change->challenge-creator#updateSchedule"
                         data-testament="new"
                         data-chapters="<%= book[:chapters] %>">
                  <span class="text-sm"><%= book[:name] %> (<%= book[:chapters] %>)</span>
                </label>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Reading Schedule Preview -->
      <div class="card bg-base-100 shadow-xl" data-challenge-creator-target="schedulePreview" style="display: none;">
        <div class="card-body">
          <h2 class="card-title mb-4">Reading Schedule Preview</h2>
          <div data-challenge-creator-target="scheduleContent">
            <!-- Schedule will be populated by JavaScript -->
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mt-6">
        <%= form.submit "Create Challenge", class: "btn btn-primary w-full sm:w-auto" %>
        <%= link_to "Cancel", cancel_url, class: "btn btn-ghost w-full sm:w-auto" %>
      </div>
    <% end %>
  </div>
</div>