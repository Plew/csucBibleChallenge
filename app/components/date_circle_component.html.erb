<div class="flex flex-col items-center flex-shrink-0 min-w-0" <%= "data-date=\"#{date}\"" if selected %>>
  <div class="relative mb-1">
    <a href="<%= link_url %>" class="<%= link_classes %>">
      <!-- Background Circle -->
      <div class="absolute inset-0 rounded-full border-2 <%= border_classes %>"></div>
      
      <!-- Button Content -->
      <div class="relative z-10 w-4 h-4 rounded-full flex items-center justify-center <%= inner_circle_classes %>">
        <!-- Date number always shown -->
        <span class="text-[10px] font-medium"><%= date.day %></span>
      </div>
    </a>
  </div>
  <span class="<%= text_classes %>"><%= day_letter %></span>
</div>