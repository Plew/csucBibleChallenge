<div class="collapse collapse-arrow border-base-300 bg-base-200 border">
  <input type="checkbox" id="most-liked-verse-collapse">
  <label for="most-liked-verse-collapse" class="collapse-title text-xl font-medium flex items-center gap-2 pr-12">
    <span class="truncate"><%= t('stats.most_liked_verse') %></span>
  </label>
  <div class="collapse-content">
    <% if has_verse? %>
      <div class="bg-base-100 rounded-lg p-3">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-grow min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="font-semibold text-primary"><%= reference %></span>
            </div>
            <p class="text-sm text-base-content/80 leading-relaxed"><%= text %></p>
          </div>
          <div class="flex-shrink-0 flex items-center gap-1 text-red-500">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" />
            </svg>
            <span class="font-bold text-sm"><%= like_count %></span>
          </div>
        </div>
      </div>
    <% else %>
      <div class="text-center py-8 text-base-content/70">
        <div class="text-lg mb-2"><%= t('stats.no_liked_verses') %></div>
        <div class="text-sm"><%= t('stats.like_verses_message') %></div>
      </div>
    <% end %>
  </div>
</div>
