<div class="px-2 py-3">
  <div class="mb-6">
    <%= link_to "← Back to Stats", stats_path, class: "btn btn-ghost btn-sm" %>
  </div>
  
  <div class="stats shadow mb-6">
    <div class="stat place-items-center">
      <div class="stat-title">Challenge Participants</div>
      <div class="stat-value text-primary"><%= participant_count %></div>
    </div>
  </div>
  
  <%= render Statistics::TopReadersComponent.new(top_readers_data: @top_readers_data) %>
</div>