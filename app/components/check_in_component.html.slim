#checkbox-component.flex.flex-col.w-full.border.border-black.border-2
  .flex.justify-center.text-3xl.font-bold 
    = @shown_date
  .flex.justify-between.items-center
    = button_to date_view_changes_path, method: :post, params: { shown_date: previous_date } do
      = image_tag 'previous.png'
    .w-32.h-32
      - if disabled?
        - if @checked
          = image_tag 'checkbox_checked.png'
        - else 
          =image_tag 'checkbox_empty.png'
      - else
        = button_to check_ins_path do 
          - if @checked
            = image_tag 'checkbox_checked.png'
          - else 
            =image_tag 'checkbox_empty.png'
    = button_to date_view_changes_path, method: :post, params: { shown_date: next_date } do
      = image_tag 'next.png'

  .mt-4.flex.justify-between.w-full.border.border-black.border-1.w-full