<div class="container mx-auto px-2 py-6">
  <% unless is_user_in_this_group? %>
    <div class="mb-4">
      <%= link_to t('common.back'), groups_path, class: 'link link-hover text-sm' %>
    </div>
  <% end %>

  <div class="bg-base-100 rounded-lg shadow p-4">
    <div class="mb-4">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold"><%= group.name %></h2>
        <div class="flex gap-2">
          <% if can_join_group? %>
            <%= button_to 'Join', join_group_path(group), method: :post, class: 'btn btn-primary btn-sm', data: { turbo: true } %>
          <% end %>
          <% if is_user_in_this_group? %>
            <button
              data-controller="share"
              data-share-url-value="<%= group.join_url %>"
              data-share-title-value="<%= group.name %>"
              data-share-text-value="Join my group in this Bible reading challenge!"
              data-action="click->share#share"
              class="btn btn-circle btn-sm btn-outline btn-primary"
              title="Share group">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185z" />
              </svg>
            </button>
          <% end %>
        </div>
      </div>
      <% if group.motto.present? %>
        <div class="text-sm text-base-content/70 italic mt-1">"<%= group.motto %>"</div>
      <% end %>
      <% if group.closed_to_new_members %>
        <div class="text-xs text-warning mt-1">🔒 Closed to new members</div>
      <% end %>
    </div>

    <!-- Group Statistics -->
    <% if group_stats %>
      <% if has_active_sprint? %>
        <!-- Toggle between Sprint and Challenge stats -->
        <div class="text-center mb-3" data-controller="stats-toggle">
          <!-- Sprint mode (shown by default) -->
          <div id="sprint-mode-label" class="text-sm">
            <%= t('common.showing') %> <a href="#" class="font-bold link link-primary" data-action="click->stats-toggle#toggle"><%= current_sprint.title %></a> <%= t('stats.sprint_stats_label') %>
          </div>
          <!-- Challenge mode (hidden by default) -->
          <div id="challenge-mode-label" class="text-sm hidden">
            <%= t('common.showing') %> <a href="#" class="font-bold link link-primary" data-action="click->stats-toggle#toggle"><%= t('common.challenge') %></a> <%= t('stats.challenge_stats_label') %>
          </div>
        </div>

        <!-- Sprint Stats (shown by default when toggle is checked) -->
        <div id="sprint-stats" class="mb-4">
          <div class="flex justify-around gap-8 py-3 px-4">
            <!-- Completion Percentage -->
            <div class="flex flex-col items-center">
              <div class="radial-progress text-accent" style="--value:<%= sprint_stats[:completion_percentage] %>; --size:7rem; --thickness:0.5rem;" aria-valuenow="<%= sprint_stats[:completion_percentage] %>" role="progressbar">
                <span class="text-xl font-bold"><%= sprint_stats[:completion_percentage] %>%</span>
              </div>
              <div class="text-xs text-center mt-1 opacity-70">
                <%= t('stats.chapters_read_short') %>
              </div>
              <div class="text-xs text-center mt-0.5 font-semibold opacity-80">
                <%= sprint_stats[:total_completed] %>/<%= sprint_stats[:total_possible] %>
              </div>
            </div>

            <!-- On Schedule Percentage -->
            <div class="flex flex-col items-center">
              <div class="radial-progress text-info" style="--value:<%= sprint_stats[:on_schedule_percentage] %>; --size:7rem; --thickness:0.5rem;" aria-valuenow="<%= sprint_stats[:on_schedule_percentage] %>" role="progressbar">
                <span class="text-xl font-bold"><%= sprint_stats[:on_schedule_percentage] %>%</span>
              </div>
              <div class="text-xs text-center mt-1 opacity-70">
                <%= t('stats.on_time_short') %>
              </div>
              <div class="text-xs text-center mt-0.5 font-semibold opacity-80">
                <%= sprint_stats[:total_on_time] %>/<%= sprint_stats[:total_possible] %>
              </div>
            </div>
          </div>
        </div>

        <!-- Challenge Stats (hidden by default) -->
        <div id="challenge-stats" class="mb-4 hidden">
          <div class="flex justify-around gap-8 py-3 px-4">
            <!-- Completion Percentage -->
            <div class="flex flex-col items-center">
              <div class="radial-progress text-accent" style="--value:<%= group_stats[:completion_percentage] %>; --size:7rem; --thickness:0.5rem;" aria-valuenow="<%= group_stats[:completion_percentage] %>" role="progressbar">
                <span class="text-xl font-bold"><%= group_stats[:completion_percentage] %>%</span>
              </div>
              <div class="text-xs text-center mt-1 opacity-70">
                <%= t('stats.chapters_read_short') %>
              </div>
              <div class="text-xs text-center mt-0.5 font-semibold opacity-80">
                <%= group_stats[:total_completed] %>/<%= group_stats[:total_possible] %>
              </div>
            </div>

            <!-- On Schedule Percentage -->
            <div class="flex flex-col items-center">
              <div class="radial-progress text-info" style="--value:<%= group_stats[:on_schedule_percentage] %>; --size:7rem; --thickness:0.5rem;" aria-valuenow="<%= group_stats[:on_schedule_percentage] %>" role="progressbar">
                <span class="text-xl font-bold"><%= group_stats[:on_schedule_percentage] %>%</span>
              </div>
              <div class="text-xs text-center mt-1 opacity-70">
                <%= t('stats.on_time_short') %>
              </div>
              <div class="text-xs text-center mt-0.5 font-semibold opacity-80">
                <%= group_stats[:total_on_time] %>/<%= group_stats[:total_possible] %>
              </div>
            </div>
          </div>
        </div>
      <% else %>
        <!-- No active sprint, just show challenge stats -->
        <div class="flex justify-around gap-8 mb-4 py-3 px-4">
          <!-- Completion Percentage -->
          <div class="flex flex-col items-center">
            <div class="radial-progress text-accent" style="--value:<%= group_stats[:completion_percentage] %>; --size:7rem; --thickness:0.5rem;" aria-valuenow="<%= group_stats[:completion_percentage] %>" role="progressbar">
              <span class="text-xl font-bold"><%= group_stats[:completion_percentage] %>%</span>
            </div>
            <div class="text-xs text-center mt-1 opacity-70">
              <%= t('stats.chapters_read_short') %>
            </div>
            <div class="text-xs text-center mt-0.5 font-semibold opacity-80">
              <%= group_stats[:total_completed] %>/<%= group_stats[:total_possible] %>
            </div>
          </div>

          <!-- On Schedule Percentage -->
          <div class="flex flex-col items-center">
            <div class="radial-progress text-info" style="--value:<%= group_stats[:on_schedule_percentage] %>; --size:7rem; --thickness:0.5rem;" aria-valuenow="<%= group_stats[:on_schedule_percentage] %>" role="progressbar">
              <span class="text-xl font-bold"><%= group_stats[:on_schedule_percentage] %>%</span>
            </div>
            <div class="text-xs text-center mt-1 opacity-70">
              <%= t('stats.on_time_short') %>
            </div>
            <div class="text-xs text-center mt-0.5 font-semibold opacity-80">
              <%= group_stats[:total_on_time] %>/<%= group_stats[:total_possible] %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <ul class="list bg-base-100 rounded-box">
      <li class="p-4 pb-2 text-xs opacity-60 tracking-wide flex items-center justify-between">
        <span><%= is_user_in_this_group? ? "Your Group Members" : "Group Members" %></span>
        <span class="mr-2">Read Today?</span>
      </li>
      <%
        enrollments = group.user_group_enrollments.includes(:user)
        if is_user_in_this_group?
          current_user_enrollment = enrollments.find { |e| e.user == current_user }
          other_enrollments = enrollments.reject { |e| e.user == current_user }
          sorted_enrollments = [current_user_enrollment, *other_enrollments].compact
        else
          sorted_enrollments = enrollments
        end
      %>
      <% sorted_enrollments.each do |enrollment| %>
        <li class="list-row flex items-center gap-3 py-2 px-2">
          <div><%= avatar_image_tag(enrollment.user, :tiny, class: 'size-10 rounded-full') %></div>
          <div class="flex-1 min-w-0">
            <div class="truncate text-sm font-medium mb-1"><%= enrollment.user.username %></div>
            <% if has_active_sprint? %>
              <!-- Sprint graph (shown by default) -->
              <div class="sprint-graph">
                <%= render ReadingHistoryGraphComponent.new(
                  total_days: total_sprint_days,
                  completed_days: completed_days_for_user_sprint(enrollment.user),
                  start_date: sprint_start_date,
                  current_day: current_sprint_day_number
                ) %>
              </div>
              <!-- Challenge graph (hidden by default) -->
              <div class="challenge-graph hidden">
                <%= render ReadingHistoryGraphComponent.new(
                  total_days: total_challenge_days,
                  completed_days: completed_days_for_user(enrollment.user),
                  start_date: challenge_start_date,
                  current_day: current_day_number
                ) %>
              </div>
            <% else %>
              <%= render ReadingHistoryGraphComponent.new(
                total_days: total_challenge_days,
                completed_days: completed_days_for_user(enrollment.user),
                start_date: challenge_start_date,
                current_day: current_day_number
              ) %>
            <% end %>
          </div>
          <div class="flex-shrink-0">
            <input type="checkbox" <%= 'checked' if has_read_today?(enrollment.user) %> class="checkbox checkbox-success checkbox-sm pointer-events-none" />
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <% if is_user_in_this_group? %>
    <div class="mt-4 flex justify-between items-center">
      <%= link_to 'Leave Group', leave_groups_path, method: :post, data: { turbo_method: :post, turbo_confirm: 'Are you sure you want to leave this group?' }, class: 'link link-error text-sm' %>
      <% if is_group_creator? %>
        <%= link_to 'Edit', edit_group_path(group), class: 'link link-hover text-sm' %>
      <% end %>
    </div>
  <% end %>
</div>