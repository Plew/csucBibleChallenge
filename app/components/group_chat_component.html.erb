<% if can_chat? %>
  <div class="bg-base-100 rounded-lg shadow p-4 mt-6">
    <h3 class="text-lg font-semibold mb-4"><%= t('group_chat.title') %></h3>

    <div id="chat-messages" class="max-h-96 overflow-y-auto mb-4 space-y-1">
      <% if messages.any? %>
        <% messages.each do |message| %>
          <div class="chat <%= message.user == current_user ? 'chat-end' : 'chat-start' %>">
            <div class="chat-image avatar">
              <div class="w-8 rounded-full">
                <%= avatar_image_tag(message.user, :tiny, class: 'rounded-full') %>
              </div>
            </div>
            <div class="chat-header text-xs mb-0.5">
              <%= message.user.username %>
              <time class="text-xs opacity-50"><%= time_ago_in_words(message.created_at) %> <%= t('common.ago') %></time>
            </div>
            <div class="chat-bubble chat-bubble-sm <%= message.user == current_user ? 'chat-bubble-primary' : '' %> py-1.5 px-3 leading-snug">
              <%= simple_format(h(message.content), class: 'mb-0') %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center text-gray-500 py-8">
          <%= t('group_chat.no_messages') %>
        </div>
      <% end %>
    </div>

    <%= turbo_frame_tag "new-message-form" do %>
      <%= form_with model: [group, new_message],
                    url: group_group_messages_path(group),
                    method: :post,
                    local: false,
                    data: { turbo_frame: "chat-messages" },
                    class: "flex gap-2" do |form| %>
        <%= form.text_area :content,
                          placeholder: t('group_chat.type_placeholder'),
                          rows: 2,
                          class: "textarea textarea-bordered flex-1 resize-none",
                          required: true %>
        <%= form.submit t('group_chat.send'),
                       class: "btn btn-primary btn-sm self-end" %>
      <% end %>
    <% end %>
  </div>
<% end %>