<div class="collapse collapse-arrow border-base-300 bg-base-200 border">
  <input type="checkbox" id="sprints-collapse">
  <label for="sprints-collapse" class="collapse-title text-xl font-medium flex items-center gap-2 pr-12">
    <span class="truncate"><%= t('stats.sprints') %></span>
    <span class="text-sm font-normal opacity-60"><%= t('stats.sprints_completed', count: completed_count) %></span>
  </label>
  <div class="collapse-content">
    <% if sprints.any? %>
      <div class="space-y-1.5">
        <% sprints.each do |sprint| %>
          <div class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= active?(sprint) ? 'bg-purple-500/20 border border-purple-400' : 'bg-base-100' %>">
            <span class="text-base flex-shrink-0"><%= active?(sprint) ? '📍' : '🏆' %></span>
            <div class="flex-grow min-w-0">
              <div class="font-medium text-sm <%= active?(sprint) ? 'font-bold' : '' %> truncate"><%= sprint.title %></div>
              <div class="text-[10px] opacity-50"><%= format_date(sprint.begin_date) %> – <%= format_date(sprint.end_date) %></div>
              <% if sprint.sprint_winners.any? %>
                <div class="text-[10px] text-amber-400 mt-0.5">
                  🏆 <%= sprint.sprint_winners.map(&:display_group_name).join(", ") %>
                </div>
              <% end %>
            </div>
            <% if active?(sprint) %>
              <span class="text-[10px] font-semibold text-purple-400 bg-purple-500/20 px-2 py-0.5 rounded-full flex-shrink-0"><%= t('stats.active_label') %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-4">
        <div class="text-base opacity-70"><%= t('stats.no_sprints') %></div>
      </div>
    <% end %>
  </div>
</div>
