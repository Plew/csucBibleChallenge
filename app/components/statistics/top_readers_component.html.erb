<div class="collapse collapse-arrow border-base-300 bg-base-200 border">
  <input type="checkbox" id="leaderboard-collapse">
  <label for="leaderboard-collapse" class="collapse-title text-xl font-medium flex items-center gap-2 pr-12">
    <span class="truncate"><%= t('stats.leaderboard') %> (<%= t('stats.over_50_percent') %>)</span>
  </label>
  <div class="collapse-content">
    <% if has_readers? %>
      <div class="space-y-1">
        <% top_readers_data.each_with_index do |reader_data, index| %>
          <% user = reader_data[:user] %>
          <% chapters = reader_data[:total_chapters_read] %>
          <% percentage = reader_data[:completion_percentage] %>
          <% on_schedule = reader_data[:on_schedule_percentage] %>

          <div class="relative flex items-center space-x-3 p-1.5 bg-base-100 rounded">
            <div class="absolute top-0.5 left-1 text-[9px] opacity-40 leading-none"><%= index + 1 %></div>

            <div class="flex-grow min-w-0">
              <div class="font-medium text-base truncate"><%= user.username %></div>
              <% if reader_data[:group_name].present? %>
                <div class="text-xs opacity-70 truncate">
                  <%= reader_data[:group_name] %>
                </div>
              <% end %>
            </div>

            <div class="flex-shrink-0 flex gap-3 items-center">
              <div class="radial-progress text-accent" style="--value:<%= percentage %>; --size:2.5rem; --thickness:2px;" aria-valuenow="<%= percentage %>" role="progressbar">
                <span class="text-xs font-bold"><%= percentage %></span>
              </div>
              <div class="radial-progress text-info" style="--value:<%= on_schedule %>; --size:2.5rem; --thickness:2px;" aria-valuenow="<%= on_schedule %>" role="progressbar">
                <span class="text-xs font-bold"><%= on_schedule %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-4">
        <div class="text-base opacity-70"><%= t('stats.no_reading_data') %></div>
        <div class="text-sm opacity-50"><%= t('stats.leaderboard_message') %></div>
      </div>
    <% end %>
  </div>
</div>