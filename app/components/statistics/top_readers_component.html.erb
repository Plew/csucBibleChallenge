<div class="card bg-base-100 shadow-xl">
  <div class="card-body p-2">
    <h2 class="text-lg font-bold mb-2 text-center">Leaderboard</h2>
    
    <% if has_readers? %>
      <div class="space-y-1">
        <% top_readers_data.each_with_index do |reader_data, index| %>
          <% user = reader_data[:user] %>
          <% chapters = reader_data[:total_chapters_read] %>
          <% percentage = reader_data[:completion_percentage] %>
          
          <div class="flex items-center space-x-3 p-1.5 bg-base-200 rounded">
            <div class="avatar">
              <div class="w-8 rounded-full">
                <% if reader_data[:avatar_url] %>
                  <%= image_tag reader_data[:avatar_url], alt: user.username, class: "w-8 h-8 rounded-full object-cover" %>
                <% else %>
                  <div class="w-8 h-8 rounded-full bg-primary text-primary-content flex items-center justify-center font-bold text-xs">
                    <%= avatar_fallback_initials(user) %>
                  </div>
                <% end %>
              </div>
            </div>
            
            <div class="flex-grow min-w-0">
              <div class="font-medium text-base truncate"><%= user.username %></div>
              <div class="text-xs opacity-70">
                <%= reader_data[:chapters_completed] %>/<%= reader_data[:chapters_scheduled] %> chapters read
              </div>
            </div>
            
            <div class="text-right flex-shrink-0">
              <div class="text-base font-bold text-accent">
                <%= percentage %>%
              </div>
              <div class="text-xs opacity-70">
                completion rate
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-4">
        <div class="text-base opacity-70">No reading data available yet</div>
        <div class="text-sm opacity-50">Start reading to appear on the leaderboard!</div>
      </div>
    <% end %>
  </div>
</div>