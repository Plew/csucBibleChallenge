<div class="collapse collapse-arrow border-base-300 bg-base-200 border">
  <input type="checkbox" id="most-liked-verses-today-collapse">
  <label for="most-liked-verses-today-collapse" class="collapse-title text-xl font-medium flex items-center gap-2 pr-12">
    <span class="truncate"><%= t('stats.most_liked_verse_today') %></span>
    <span class="text-sm font-normal opacity-60"><%= preview_text %></span>
  </label>
  <div class="collapse-content">
    <% if most_liked_verse_today.present? %>
      <div class="space-y-3">
        <% most_liked_verse_today.each do |verse| %>
          <div class="flex items-start gap-2">
            <div class="relative shrink-0 text-red-500 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
              </svg>
              <span class="absolute inset-0 flex items-center justify-center text-[9px] font-bold text-white" style="padding-bottom: 2px;"><%= verse[:like_count] %></span>
            </div>
            <div class="min-w-0">
              <span class="text-xs font-semibold text-primary block"><%= verse[:reference] %></span>
              <p class="text-sm text-accent leading-relaxed italic"><%= verse[:text] %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-sm text-base-content/50"><%= t('stats.no_liked_verses_today') %></div>
    <% end %>
  </div>
</div>
