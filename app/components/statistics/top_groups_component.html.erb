<div class="card bg-base-100 shadow-xl">
  <div class="card-body p-2">
    <h2 class="text-lg font-bold mb-2 text-center"><%= t('stats.top_groups') %></h2>

    <% if has_groups? %>
      <div class="space-y-1">
        <% top_groups_data.each_with_index do |group_data, index| %>
          <% group = group_data[:group] %>
          <% percentage = group_data[:completion_percentage] %>
          <% on_schedule = group_data[:on_schedule_percentage] %>
          <% size = group_data[:group_size] %>
          <% chapters = group_data[:total_chapters_read] %>

          <div class="relative flex items-center space-x-3 p-1.5 bg-base-200 rounded">
            <div class="absolute top-0.5 left-1 text-[9px] opacity-40 leading-none"><%= index + 1 %></div>

            <div class="flex-grow min-w-0">
              <div class="font-medium text-base truncate"><%= group.name %></div>
              <div class="text-xs opacity-70">
                <%= pluralize(size, t('common.member_one'), t('common.member_other')) %>
              </div>
            </div>

            <div class="flex-shrink-0 flex gap-3 items-center">
              <div class="radial-progress text-accent" style="--value:<%= percentage %>; --size:2.5rem; --thickness:2px;" aria-valuenow="<%= percentage %>" role="progressbar">
                <span class="text-xs font-bold"><%= percentage %></span>
              </div>
              <div class="radial-progress text-info" style="--value:<%= on_schedule %>; --size:2.5rem; --thickness:2px;" aria-valuenow="<%= on_schedule %>" role="progressbar">
                <span class="text-xs font-bold"><%= on_schedule %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-4">
        <div class="text-base opacity-70"><%= t('stats.no_groups') %></div>
        <div class="text-sm opacity-50"><%= t('stats.top_groups_message') %></div>
      </div>
    <% end %>
  </div>
</div>