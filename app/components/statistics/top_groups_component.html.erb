<div class="collapse collapse-arrow border-base-300 bg-base-200 border">
  <input type="checkbox" id="top-groups-collapse">
  <label for="top-groups-collapse" class="collapse-title text-xl font-medium flex items-center gap-2 pr-12">
    <span class="truncate"><%= t('stats.top_groups') %>: <%= t('stats.group_count', count: group_count) %></span>
  </label>
  <div class="collapse-content">
    <% if has_groups? %>
      <div class="space-y-2">
        <% top_groups_data.each_with_index do |group_data, index| %>
          <% group = group_data[:group] %>
          <% percentage = group_data[:completion_percentage] %>
          <% on_schedule = group_data[:on_schedule_percentage] %>
          <% size = group_data[:group_size] %>
          <% chapters = group_data[:total_chapters_read] %>

          <div class="bg-base-100 rounded-lg">
            <div class="collapse">
              <input type="checkbox" id="group-<%= group.id %>-stats-collapse">
              <label for="group-<%= group.id %>-stats-collapse" class="collapse-title min-h-0 py-2 px-3">
                <div class="relative flex items-center space-x-3">
                  <div class="absolute top-0 left-0 text-[9px] opacity-40 leading-none"><%= index + 1 %></div>

                  <div class="flex-grow min-w-0 pl-4">
                    <div class="font-medium text-base truncate"><%= group.name %></div>
                    <% if group.motto.present? %>
                      <div class="text-xs text-base-content/70 italic break-words"><%= group.motto %></div>
                    <% end %>
                    <div class="text-xs opacity-70">
                      <%= pluralize(size, t('common.member_one'), t('common.member_other')) %>
                    </div>
                  </div>

                  <div class="flex-shrink-0 flex gap-3 items-center">
                    <div class="radial-progress text-accent" style="--value:<%= percentage %>; --size:2.5rem; --thickness:2px;" aria-valuenow="<%= percentage %>" role="progressbar">
                      <span class="text-xs font-bold"><%= percentage %></span>
                    </div>
                    <div class="radial-progress text-info" style="--value:<%= on_schedule %>; --size:2.5rem; --thickness:2px;" aria-valuenow="<%= on_schedule %>" role="progressbar">
                      <span class="text-xs font-bold"><%= on_schedule %></span>
                    </div>
                  </div>
                </div>
              </label>
              <div class="collapse-content px-3 pb-2">
                <div class="space-y-1">
                  <% group.users.each do |user| %>
                    <div class="flex items-center gap-3 px-3 py-2 bg-base-200 rounded-lg">
                      <div>
                        <%= avatar_image_tag(user, :tiny, class: 'rounded-full') %>
                      </div>
                      <div class="font-medium text-sm"><%= user.name %></div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-4">
        <div class="text-base opacity-70"><%= t('stats.no_groups') %></div>
        <div class="text-sm opacity-50"><%= t('stats.top_groups_message') %></div>
      </div>
    <% end %>
  </div>
</div>