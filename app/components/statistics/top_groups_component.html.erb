<div class="card bg-base-100 shadow-xl">
  <div class="card-body p-2">
    <h2 class="text-lg font-bold mb-2 text-center">Top Groups</h2>
    
    <% if has_groups? %>
      <div class="space-y-1">
        <% top_groups_data.each_with_index do |group_data, index| %>
          <% group = group_data[:group] %>
          <% percentage = group_data[:completion_percentage] %>
          <% size = group_data[:group_size] %>
          <% chapters = group_data[:total_chapters_read] %>

          <div class="relative flex items-center space-x-3 p-1.5 bg-base-200 rounded">
            <div class="absolute top-0.5 left-1 text-[9px] opacity-40 leading-none"><%= index + 1 %></div>

            <div class="flex-grow min-w-0 pl-3">
              <div class="font-medium text-base truncate"><%= group.name %></div>
              <div class="text-xs opacity-70">
                <%= pluralize(size, 'member') %>
              </div>
            </div>

            <div class="text-right flex-shrink-0 w-20">
              <div class="text-lg font-bold text-accent">
                <%= percentage %>%
              </div>
              <div class="text-xs opacity-70">
                completion rate
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-4">
        <div class="text-base opacity-70">No groups available yet</div>
        <div class="text-sm opacity-50">Create or join a group to see group rankings!</div>
      </div>
    <% end %>
  </div>
</div>