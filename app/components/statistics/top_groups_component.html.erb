<div class="card bg-base-100 shadow-xl">
  <div class="card-body p-2">
    <h2 class="card-title text-xl mb-2">Top Groups</h2>
    
    <% if has_groups? %>
      <div class="space-y-1">
        <% top_groups_data.each_with_index do |group_data, index| %>
          <% group = group_data[:group] %>
          <% percentage = group_data[:completion_percentage] %>
          <% size = group_data[:group_size] %>
          <% chapters = group_data[:total_chapters_read] %>
          
          <div class="flex items-center space-x-3 p-1.5 bg-base-200 rounded">
            <div class="text-lg font-bold text-primary w-6 text-center">
              #<%= index + 1 %>
            </div>
            
            <%= render OverlaidAvatarsComponent.new(users: group.users, max_avatars: 3, size: :tiny) %>
            
            <div class="flex-grow min-w-0">
              <div class="font-medium text-base truncate"><%= group.name %></div>
              <div class="text-xs opacity-70">
                <%= chapters %> chapters
              </div>
            </div>
            
            <div class="text-right flex-shrink-0">
              <div class="text-lg font-bold text-accent">
                <%= percentage %>%
              </div>
              <div class="text-xs opacity-70">
                completion rate
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-4">
        <div class="text-base opacity-70">No groups available yet</div>
        <div class="text-sm opacity-50">Create or join a group to see group rankings!</div>
      </div>
    <% end %>
  </div>
</div>