<div class="px-4 mx-2">
  <div class="text-xs font-semibold opacity-50 mb-1"><%= t("stats.last_10_readers") %></div>
  <div class="space-y-1">
    <% readers.first(5).each do |reader_data| %>
      <div class="flex items-center justify-between">
        <%= helpers.link_to helpers.public_profile_path(reader_data[:user]), class: "flex items-center gap-2 hover:underline" do %>
          <%= render AvatarComponent.new(user: reader_data[:user], size: :xs, html_options: { class: "rounded-full" }) %>
          <span class="text-sm font-medium"><%= reader_data[:user].username %></span>
        <% end %>
        <span class="text-xs opacity-40">(<%= abbreviated_time(reader_data[:time_ago]) %>)</span>
      </div>
    <% end %>
  </div>
</div>
