<div class="bg-base-100 rounded-lg shadow p-2">
  <%= helpers.turbo_frame_tag "verse-likers-#{reading_id}-#{verse_number}" do %>
    <% if likers.any? %>
      <div class="flex items-center flex-wrap gap-x-1 mb-2 px-2 text-xs text-base-content/70">
        <span class="text-red-500 text-sm mr-1">&#10084;</span>
        <% likers.each do |user| %>
          <%= link_to public_profile_path(user), data: { turbo_frame: "_top" } do %>
            <%= render AvatarComponent.new(user: user, size: :tiny) %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="mb-2 text-sm">
    <div id="verse-chat-messages-<%= chat_id %>">
      <% if messages.any? %>
        <% messages.each do |message| %>
          <%= render VerseMessageComponent.new(
            message: message,
            current_user: current_user,
            reading: reading,
            verse_number: verse_number
          ) %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if current_user && reading.challenge.verse_comments_enabled? %>
    <%= tag.turbo_frame id: "verse-new-message-form-#{chat_id}" do %>
      <%= form_with url: reading_verse_messages_path(reading_id, verse_number: verse_number),
                    method: :post,
                    scope: :verse_message,
                    data: { turbo: true },
                    class: "flex gap-2 items-center px-2" do |form| %>
        <%= form.text_area :content,
                          placeholder: "Type your message... (Enter to send, Shift+Enter for newline)",
                          rows: 1,
                          class: "textarea textarea-bordered textarea-sm flex-1 resize-none text-sm bg-base-100 focus:border-secondary focus:ring-1 focus:ring-secondary/30",
                          onkeydown: "if(event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); if(this.value.trim().length > 0) { this.form.requestSubmit(); } }",
                          required: true %>
        <%= form.submit "Send",
                       class: "btn btn-primary btn-sm rounded-lg" %>
      <% end %>
    <% end %>
  <% elsif !current_user %>
    <!-- Show disabled form if no current_user (for Lookbook preview) -->
    <div class="flex gap-2 items-center px-2">
      <textarea placeholder="Type your message..." rows="1" class="textarea textarea-bordered textarea-sm flex-1 resize-none text-sm" disabled></textarea>
      <button class="btn btn-primary btn-sm rounded-lg" disabled>Send</button>
    </div>
  <% end %>
</div>
