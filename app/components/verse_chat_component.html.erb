<div class="bg-base-100 rounded-lg shadow p-2">
  <div class="mb-2 text-sm">
    <div id="verse-chat-messages-<%= chat_id %>">
      <% if messages.any? %>
        <% messages.each do |message| %>
          <div class="chat chat-start mb-3">
            <div class="chat-header text-xs">
              <span class="text-primary opacity-80"><%= message[:user].username %></span>
              <time class="text-xs opacity-50"><%= time_ago_in_words(message[:created_at]) %> ago</time>
            </div>
            <div class="chat-bubble text-sm py-1 px-2 min-h-0">
              <%= simple_format(h(message[:content]), class: 'm-0') %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if current_user %>
    <%= tag.turbo_frame id: "verse-new-message-form-#{chat_id}" do %>
      <%= form_with url: reading_verse_messages_path(reading_id, verse_number: verse_number),
                    method: :post,
                    scope: :verse_message,
                    data: { turbo: true },
                    class: "flex gap-2 items-center px-2" do |form| %>
        <%= form.text_area :content,
                          placeholder: "Type your message...",
                          rows: 2,
                          class: "textarea textarea-bordered textarea-sm flex-1 resize-none text-sm",
                          required: true %>
        <%= form.submit "Send",
                       class: "btn btn-primary btn-sm" %>
      <% end %>
    <% end %>
  <% else %>
    <!-- Show disabled form if no current_user (for Lookbook preview) -->
    <div class="flex gap-2 items-center px-2">
      <textarea placeholder="Type your message..." rows="2" class="textarea textarea-bordered textarea-sm flex-1 resize-none text-sm" disabled></textarea>
      <button class="btn btn-primary btn-sm" disabled>Send</button>
    </div>
  <% end %>
</div>
