<div class="w-full px-2 py-2 bg-base-100 shadow-sm" data-controller="date-scroll" data-date-scroll-selected-date-value="<%= @selected_date&.to_s %>">
  <div class="flex items-center justify-between min-w-0">
    <!-- Previous Week Arrow -->
    <a href="/?date=<%= previous_week_date %>" class="flex-shrink-0 p-1 hover:bg-base-200 rounded-full transition-colors">
      <svg class="w-5 h-5 text-base-content/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
    </a>
    
    <!-- Week Days -->
    <div class="flex flex-1 justify-between items-center mx-2 min-w-0">
      <% @days.each do |day| %>
        <div class="flex flex-col items-center flex-shrink-0 min-w-0" <%= "data-date=\"#{day[:date]}\"" if day[:date] == @selected_date %>>
          <div class="relative mb-0.5">
            <% is_selected = @selected_date && day[:date] == @selected_date %>
            <a href="<%= day[:has_reading] ? "/?date=#{day[:date]}" : '#' %>" 
               class="relative w-8 h-8 flex items-center justify-center <%= day[:has_reading] ? 'cursor-pointer hover:opacity-80' : 'cursor-default' %>">
              <!-- Background Circle -->
              <div class="absolute inset-0 rounded-full border-2 <%= is_selected ? 'border-primary border-4' : (day[:has_reading] ? 'border-primary' : 'border-base-200') %>"></div>
              <!-- Button Content -->
              <div class="relative z-10 w-6 h-6 rounded-full flex items-center justify-center <%= day[:completed] ? 'bg-success text-success-content' : 'bg-base-200 text-base-content' %>">
                <% if day[:completed] %>
                  <!-- DaisyUI check icon -->
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                <% end %>
              </div>
            </a>
          </div>
          <span class="text-[10px] leading-tight <%= is_selected ? 'font-bold text-primary' : 'text-base-content/70' %> whitespace-nowrap"><%= day[:month_day] %></span>
        </div>
      <% end %>
    </div>
    
    <!-- Next Week Arrow -->
    <a href="/?date=<%= next_week_date %>" class="flex-shrink-0 p-1 hover:bg-base-200 rounded-full transition-colors">
      <svg class="w-5 h-5 text-base-content/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</div>