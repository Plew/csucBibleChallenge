<div class="chat chat-start mb-3">
  <div class="chat-header text-xs flex items-center justify-between w-full">
    <div>
      <span class="text-primary opacity-80"><%= message.user.username %></span>
      <time class="text-xs opacity-50"><%= time_ago_in_words(message.created_at) %> ago</time>
    </div>
    <% if is_own_message? %>
      <%= button_to reading_verse_message_path(reading, message, verse_number: verse_number),
                    method: :delete,
                    data: { turbo_confirm: t('verse_messages.delete_confirmation') },
                    class: "btn btn-ghost btn-xs text-error hover:bg-error/10 ml-2" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      <% end %>
    <% end %>
  </div>
  <div class="chat-bubble text-sm py-1 px-2 min-h-0">
    <%= simple_format(h(message.content), class: 'm-0') %>
  </div>
</div>
