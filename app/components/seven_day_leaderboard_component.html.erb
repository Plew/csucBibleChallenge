<div class="bg-base-100 rounded-lg shadow p-2">
  <h2 class="text-lg font-bold mb-2 text-center">7 Day Snapshot</h2>
  
  <% if leaderboard_data.any? %>
    <div class="space-y-1">
      <% leaderboard_data.each_with_index do |reader, index| %>
        <div class="relative flex items-center justify-between px-3 py-2 bg-base-200 rounded-lg">
          <div class="absolute top-0.5 left-1 text-[9px] opacity-40 leading-none"><%= index + 1 %></div>

          <div class="flex items-center gap-3 flex-grow min-w-0 pl-3">
            <div class="min-w-0">
              <div class="font-medium truncate"><%= reader[:name] %></div>
            </div>
          </div>

          <div class="text-right flex-shrink-0">
            <div class="flex gap-4 items-center">
              <div class="text-center flex-shrink-0">
                <div class="radial-progress text-success text-sm" style="--value:<%= reader[:completion_percentage] %>; --size:3rem; --thickness:3px;" aria-valuenow="<%= reader[:completion_percentage] %>" role="progressbar">
                  <span class="text-xs font-bold"><%= reader[:completion_percentage] %>%</span>
                </div>
              </div>
              <div class="text-center flex-shrink-0 w-16">
                <div class="text-sm font-bold text-info"><%= reader[:on_schedule_percentage] %>%</div>
                <div class="text-xs text-base-content/70">On Schedule</div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-8 text-base-content/70">
      <div class="text-lg mb-2">No data available</div>
      <div class="text-sm">Start reading to see your progress!</div>
    </div>
  <% end %>
</div>