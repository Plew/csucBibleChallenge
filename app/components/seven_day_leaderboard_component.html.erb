<div class="collapse collapse-arrow border-base-300 bg-base-200 border">
  <input type="checkbox" id="seven-day-collapse">
  <label for="seven-day-collapse" class="collapse-title text-xl font-medium flex items-center gap-2 pr-12">
    <span class="truncate"><%= t('stats.seven_day_snapshot') %></span>
    <span class="text-sm font-normal opacity-60"><%= t('stats.reader_count', count: reader_count) %></span>
  </label>
  <div class="collapse-content">
    <% if leaderboard_data.any? %>
      <!-- Column headers -->
      <div class="flex items-center gap-3 px-3 py-1 mb-1">
        <span class="w-5"></span>
        <span class="flex-grow"></span>
        <span class="w-[2.5rem] text-center text-[10px] uppercase tracking-wide text-accent font-semibold"><%= t('stats.column_comp') %></span>
        <span class="w-[2.5rem] text-center text-[10px] uppercase tracking-wide text-info font-semibold"><%= t('stats.column_time') %></span>
      </div>

      <div class="space-y-1">
        <% leaderboard_data.each_with_index do |reader, index| %>
          <div class="flex items-center gap-3 px-3 py-2 bg-base-100 rounded-lg">
            <span class="text-[11px] opacity-40 w-5 text-right flex-shrink-0"><%= index + 1 %></span>

            <div class="flex-grow min-w-0">
              <div class="font-medium text-sm truncate"><%= reader[:name] %></div>
            </div>

            <div class="flex-shrink-0 flex gap-3 items-center">
              <div class="radial-progress text-accent text-sm" style="--value:<%= reader[:completion_percentage] %>; --size:2.5rem; --thickness:2px;" aria-valuenow="<%= reader[:completion_percentage] %>" role="progressbar">
                <span class="text-xs font-bold"><%= reader[:completion_percentage] %></span>
              </div>
              <div class="radial-progress text-info text-sm" style="--value:<%= reader[:on_schedule_percentage] %>; --size:2.5rem; --thickness:2px;" aria-valuenow="<%= reader[:on_schedule_percentage] %>" role="progressbar">
                <span class="text-xs font-bold"><%= reader[:on_schedule_percentage] %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8 text-base-content/70">
        <div class="text-lg mb-2"><%= t('stats.no_data') %></div>
        <div class="text-sm"><%= t('stats.start_reading_message') %></div>
      </div>
    <% end %>
  </div>
</div>
