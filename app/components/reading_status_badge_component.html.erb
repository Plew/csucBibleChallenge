<% st = status %>
<% case variant %>
<% when :detailed %>
  <% if st[:read_today] %>
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-success bg-success/15 px-2.5 py-1 rounded-lg">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
      <span>Read today (<%= st[:reading_title] %>)</span>
    </span>
  <% elsif st[:read_count] > 0 %>
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-warning bg-warning/15 px-2.5 py-1 rounded-lg">
      <span class="w-2 h-2 rounded-full bg-warning"></span>
      <span><%= st[:read_count] %>/<%= st[:total_count] %> Read Today</span>
    </span>
  <% elsif st[:has_reading] %>
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-warning bg-warning/15 px-2.5 py-1 rounded-lg">
      <span class="w-2 h-2 rounded-full bg-warning animate-pulse"></span>
      <span>Unread today &mdash; <%= st[:reading_title] %></span>
    </span>
  <% else %>
    <span class="inline-flex items-center text-xs text-neutral/50 bg-base-200 px-2.5 py-1 rounded-lg">
      Rest / Catch-up day
    </span>
  <% end %>

<% when :badge %>
  <% if st[:read_today] %>
    <span class="badge badge-success badge-sm gap-1 font-medium text-xs">
      ✓ Read today
    </span>
  <% elsif st[:read_count] > 0 %>
    <span class="badge badge-warning badge-sm gap-1 font-medium text-xs">
      <%= st[:read_count] %>/<%= st[:total_count] %> Read
    </span>
  <% elsif st[:has_reading] %>
    <span class="badge badge-warning badge-sm gap-1 font-medium text-xs">
      Unread today
    </span>
  <% else %>
    <span class="badge badge-ghost badge-sm text-xs text-neutral/60">
      Rest day
    </span>
  <% end %>

<% else %>
  <%# :compact (default) %>
  <% if st[:read_today] %>
    <span class="inline-flex items-center gap-1 text-[11px] font-medium text-success bg-success/15 px-2 py-0.5 rounded-md">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
      <span>Read today</span>
    </span>
  <% elsif st[:read_count] > 0 %>
    <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-warning bg-warning/15 px-2 py-0.5 rounded-md">
      <span class="w-1.5 h-1.5 rounded-full bg-warning"></span>
      <span><%= st[:read_count] %>/<%= st[:total_count] %> Read</span>
    </span>
  <% elsif st[:has_reading] %>
    <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-warning bg-warning/15 px-2 py-0.5 rounded-md">
      <span class="w-1.5 h-1.5 rounded-full bg-warning"></span>
      <span><%= st[:reading_title] || 'Unread today' %></span>
    </span>
  <% else %>
    <span class="text-[11px] text-neutral/50">Rest day</span>
  <% end %>
<% end %>
