<div class="w-full px-2 py-2 bg-base-100 shadow-sm">
  <div class="flex justify-between w-full">
    <% @days.each do |day| %>
      <div class="flex flex-col items-center mx-0.5">
        <div class="relative mb-0.5">
          <div class="relative w-8 h-8 flex items-center justify-center">
            <!-- Background Circle -->
            <div class="absolute inset-0 rounded-full border-2 border-base-200"></div>
            <!-- Button Content (read-only) -->
            <div class="relative z-10 w-6 h-6 rounded-full flex items-center justify-center <%= day[:completed] ? 'bg-success text-success-content' : 'bg-base-200 text-base-content' %>">
              <% if day[:completed] %>
                <!-- DaisyUI check icon -->
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              <% else %>
                <span class="text-xs font-medium"><%= day[:day_of_month] %></span>
              <% end %>
            </div>
          </div>
        </div>
        <span class="text-[10px] leading-tight"><%= day[:day_of_week] %></span>
      </div>
    <% end %>
  </div>
</div> 