<div class="w-full px-4 py-3 bg-white rounded-lg shadow-sm">
  <h2 class="text-lg font-medium mb-3">Weekly Check-in</h2>
  <div class="flex justify-between w-full">
    <% @days.each do |day| %>
      <div class="flex flex-col items-center">
        <div class="relative mb-1">
          <div class="relative w-14 h-14 flex items-center justify-center">
            <!-- Background Circle -->
            <div class="absolute inset-0 rounded-full border-4 border-gray-200"></div>
            <!-- Progress Ring -->
            <% if day[:group_completion].to_i > 0 %>
              <svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 100">
                <circle
                  cx="50"
                  cy="50"
                  r="46"
                  fill="none"
                  stroke="#3b82f6"
                  stroke-width="8"
                  stroke-dasharray="<%= (day[:group_completion].to_f * 2.89).round(1) %> 289"
                  stroke-linecap="round"
                  transform="rotate(-90 50 50)"
                />
              </svg>
            <% end %>
            <!-- Button Content (read-only) -->
            <div class="relative z-10 w-10 h-10 rounded-full flex items-center justify-center <%= day[:completed] ? 'bg-green-500 text-white' : 'bg-gray-100 text-gray-500' %>">
              <% if day[:completed] %>
                <!-- DaisyUI check icon -->
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              <% else %>
                <span class="text-sm font-medium"><%= day[:day_of_month] %></span>
              <% end %>
            </div>
          </div>
        </div>
        <span class="text-xs"><%= day[:day_of_week] %></span>
        <span class="text-xs text-gray-500"><%= day[:group_completion] %>%</span>
      </div>
    <% end %>
  </div>
</div> 