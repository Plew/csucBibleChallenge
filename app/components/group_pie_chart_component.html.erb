<canvas id="pie-chart"></canvas>

<div id="pie-data" data-pie-data="<%= pie_chart_data_object.to_json %>"></div>

<script>
  document.addEventListener("turbo:load", function() {
    var ctx = document.getElementById('pie-chart');
    var pieData = JSON.parse(document.getElementById('pie-data').dataset.pieData);

    console.log('pie data', pieData);

    new Chart(ctx, {
      type: 'doughnut',
      data: pieData,
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'top',
          },
          title: {
            display: true,
            text: 'Today\'s Check-ins'
          }
        }
      }
    });
  })
</script> 