<div class="px-2 py-3">
  <div class="space-y-6">
    <!-- Message of the Day -->
    <% if challenge&.message_of_the_day.present? %>
      <div class="mx-4">
        <div class="card bg-base-100">
          <div class="card-body px-2 sm:px-4 py-2 sm:py-3">
            <div class="text-base whitespace-pre-wrap"><%= simple_format(linkify_urls(challenge.message_of_the_day, class: 'link link-primary'), {}, sanitize: false) %></div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Challenge Summary -->
    <% if challenge && challenge_summary_stats %>
      <div>
        <%= render StatsChallengeSummaryComponent.new(challenge: challenge, statistics: challenge_summary_stats) %>
      </div>
    <% end %>

    <!-- Sprint Selector -->
    <% if available_sprints.any? %>
      <div class="mx-4" data-controller="sprint">
        <div class="card bg-base-100">
          <div class="card-body px-4 py-3">
            <label for="sprint_selector" class="label">
              <span class="label-text font-semibold"><%= t("stats.sprint_label") %></span>
            </label>
            <select id="sprint_selector" class="select select-bordered w-full" data-action="change->sprint#change">
              <option value="full" <%= "selected" unless sprint %>><%= t("stats.full_challenge") %></option>
              <% available_sprints.each do |s| %>
                <option value="<%= s.id %>" <%= "selected" if sprint&.id == s.id %>>
                  <%= s.title %> (<%= s.begin_date.strftime("%b %d") %> - <%= s.end_date.strftime("%b %d, %Y") %>)
                </option>
              <% end %>
            </select>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Personal Stats -->
    <div>
      <%= render Statistics::PersonalStatsComponent.new(user_stats: personal_stats) %>
    </div>

    <!-- Challenge Stats (Leaderboard) -->
    <div>
      <%= render Statistics::TopReadersComponent.new(top_readers_data: top_readers_data) %>
    </div>

    <!-- Group Stats (Top Groups) -->
    <% if top_groups_data.length > 1 %>
      <div>
        <%= render Statistics::TopGroupsComponent.new(top_groups_data: top_groups_data) %>
      </div>
    <% end %>

    <!-- 7 Day Stats -->
    <div>
      <%= render SevenDayLeaderboardComponent.new(leaderboard_data: seven_day_leaderboard_data) %>
    </div>
  </div>
</div>