<div class="bg-base-100 shadow-xl w-full rounded-none">
  <div>
    <h2 class="text-lg font-bold mb-2 text-center">
      <%= title.presence || 'Untitled Reading' %>
      <% unless is_completed %>
        <span class="text-primary font-semibold">(<%= t('reading.unread') %>)</span>
      <% end %>
    </h2>
    <div class="prose max-w-none bg-base-200 p-4 px-3 rounded-md">
      <% if verses.any? %>
        <% verses.each do |verse| %>
          <details class="mb-2">
            <summary class="text-lg text-base-content cursor-pointer hover:bg-base-300 p-2 rounded list-none group transition-colors">
              <div class="flex items-stretch justify-between">
                <span class="flex-1">
                  <span class="text-xs align-top mr-1 text-base-content/60"><%= verse[:verse_number] %></span>
                  <%= verse[:verse_text] %>
                </span>
                <div class="flex flex-col items-center justify-between ml-2 flex-shrink-0">
                  <div class="mt-1">
                    <%= render partial: "verse_likes/button", locals: {
                      reading_id: verse[:reading_id],
                      verse_number: verse[:verse_number],
                      liked: verse[:liked] || false,
                      like_count: verse[:like_count] || 0
                    } %>
                  </div>
                  <% message_count = (verse[:messages] || []).length %>
                  <% if message_count > 0 %>
                    <span class="badge badge-primary badge-sm mb-1 group-hover:scale-105 transition-transform"><%= message_count %></span>
                  <% else %>
                    <span class="text-base-content/40 group-hover:text-primary hover:text-primary hover:bg-primary/15 transition-all text-xs font-bold tracking-widest px-1.5 py-0.5 rounded-full mb-1" title="<%= t('reading.open_discussion', default: 'Open discussion') %>">...</span>
                  <% end %>
                </div>
              </div>
            </summary>
            <div class="mt-2">
              <%= render VerseChatComponent.new(
                reading_id: verse[:reading_id],
                verse_number: verse[:verse_number],
                current_user: current_user,
                messages: verse[:messages] || [],
                likers: verse[:likers] || []
              ) %>
            </div>
          </details>
        <% end %>
      <% else %>
        <p><em>No verses found for this reading.</em></p>
      <% end %>
    </div>
  </div>
</div>
