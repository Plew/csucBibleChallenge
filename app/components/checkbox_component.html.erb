<div class="w-32 h-32">
  <% if disabled? %>
    <svg class="w-full h-full stroke-primary" viewBox="0 0 24 24" fill="none" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="2" stroke="inherit" />
      <% if checked? %>
        <path
          d="M6.75 12.75L10.25 16.25L17.25 9.75"
          class="stroke-primary"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      <% end %>
    </svg>
  <% else %>
    <%= button_to check_ins_path, class: "w-full h-full" do %>
      <svg class="w-full h-full stroke-primary" viewBox="0 0 24 24" fill="none" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" stroke="inherit" />
        <% if checked? %>
          <path
            d="M6.75 12.75L10.25 16.25L17.25 9.75"
            class="stroke-accent"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        <% end %>
      </svg>
    <% end %>
  <% end %>
</div> 