<div class="flex text-sm w-1/3">
  <%= "Last #{last_x_days.size} Days" %>
</div>
<div id="user-last-x" class="flex w-full h-6">
  <% last_x_days.reverse.each do |date| %>
    <div class="flex-grow h-full <%= check_in_dates.include?(date) ? 'bg-green-800' : 'bg-gray-800' %>"></div>
  <% end %>
</div> 