<main class="flex-1 overflow-hidden">
  <section class="h-1/2 flex items-center justify-center relative">
    <%= inline_svg_tag 'icons/chevron-left.svg', class: 'absolute left-4 text-muted-foreground' %>
    <%= render 'shared/large_checkbox' %>
    <%= inline_svg_tag 'icons/chevron-right.svg', class: 'absolute right-4 text-muted-foreground' %>
  </section>
  <section class="h-1/2 flex items-center justify-center relative bg-muted">
    <%= inline_svg_tag 'icons/chevron-left.svg', class: 'absolute left-4 text-muted-foreground' %>
    <%= render 'shared/pie_chart_placeholder' %>
    <%= inline_svg_tag 'icons/chevron-right.svg', class: 'absolute right-4 text-muted-foreground' %>
  </section>
</main>