.w-32.h-32
  - if disabled?
    svg.w-full.h-full[viewBox="0 0 24 24" fill="none" stroke-width="2" class="stroke-primary"]
      rect[x="3" y="3" width="18" height="18" rx="2" stroke="inherit"]
      - if checked?
        path[
          d="M6.75 12.75L10.25 16.25L17.25 9.75"
          class="stroke-primary"
          stroke-linecap="round"
          stroke-linejoin="round"
        ]
  - else
    = button_to check_ins_path, class: "w-full h-full" do
      svg.w-full.h-full[viewBox="0 0 24 24" fill="none" stroke-width="2" class="stroke-primary"]
        rect[x="3" y="3" width="18" height="18" rx="2" stroke="inherit"]
        - if checked?
          path[
            d="M6.75 12.75L10.25 16.25L17.25 9.75"
            class="stroke-accent"
            stroke-linecap="round"
            stroke-linejoin="round"
          ]