#!/usr/bin/env bash

set -e

# Configuration
LOCAL_STORAGE_PATH="storage"

echo "=== Pulling Production Database ==="
echo

# Run backup_prod_db and capture the last two lines (the file paths)
BACKUP_OUTPUT=$(bin/backup_prod_db)
echo "$BACKUP_OUTPUT"

# Extract the backup file paths from the output (last two lines)
PROD_DB_BACKUP=$(echo "$BACKUP_OUTPUT" | tail -2 | head -1)
QUEUE_DB_BACKUP=$(echo "$BACKUP_OUTPUT" | tail -1)

echo
echo "🔄 Replacing development databases with production backups..."
cp "$PROD_DB_BACKUP" "$LOCAL_STORAGE_PATH/development.sqlite3"
cp "$QUEUE_DB_BACKUP" "$LOCAL_STORAGE_PATH/queue_development.sqlite3"

echo
echo "✨ Production database successfully synced to development!"
echo
echo "Database sizes:"
ls -lh "$LOCAL_STORAGE_PATH/development.sqlite3" | awk '{print "  Main DB: " $5}'
ls -lh "$LOCAL_STORAGE_PATH/queue_development.sqlite3" | awk '{print "  Queue DB: " $5}'
echo
echo "⚠️  Remember: This contains real production data."
echo
