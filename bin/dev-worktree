#!/usr/bin/env bash

# Parse arguments
PULL_DB=false
for arg in "$@"; do
  case $arg in
    --pull-db)
      PULL_DB=true
      shift
      ;;
  esac
done

# Find an available port starting from 3000
find_available_port() {
  local port=3000
  while lsof -ti:$port >/dev/null 2>&1; do
    port=$((port + 1))
    if [ $port -gt 3100 ]; then
      echo "No available port found between 3000-3100" >&2
      exit 1
    fi
  done
  echo $port
}

# Pull production database if requested
if [ "$PULL_DB" = true ]; then
  echo "Pulling production database..."
  bin/pull_prod_db
  echo
fi

# Find available port
export PORT=$(find_available_port)
echo "Starting dev server on port $PORT..."
echo "Access at: http://localhost:$PORT"

# Build CSS once (no watch mode needed for worktrees)
echo "Building CSS..."
yarn build:css

# Clean up stale PID file
PID_FILE="tmp/pids/server.pid"
if [ -f "$PID_FILE" ]; then
  rm -f "$PID_FILE"
fi

# Run just the web server (no CSS watcher)
exec bundle exec bin/rails server -b 0.0.0.0 -p $PORT
